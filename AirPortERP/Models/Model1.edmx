          <EntitySet Name="vwAllAirlinesSumationFees" EntityType="Self.vwAllAirlinesSumationFees" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [vwAllAirlinesSumationFees].[Name] AS [Name], 
    [vwAllAirlinesSumationFees].[AirLineId] AS [AirLineId], 
    [vwAllAirlinesSumationFees].[Month] AS [Month], 
    [vwAllAirlinesSumationFees].[Year] AS [Year], 
    [vwAllAirlinesSumationFees].[LandingFees] AS [LandingFees], 
    [vwAllAirlinesSumationFees].[ParkingFees] AS [ParkingFees], 
    [vwAllAirlinesSumationFees].[NightOperationFees] AS [NightOperationFees], 
    [vwAllAirlinesSumationFees].[NavigationFees] AS [NavigationFees], 
    [vwAllAirlinesSumationFees].[SecurityFees] AS [SecurityFees], 
    [vwAllAirlinesSumationFees].[NoiseFees] AS [NoiseFees], 
    [vwAllAirlinesSumationFees].[InterCUPPSFees] AS [InterCUPPSFees], 
    [vwAllAirlinesSumationFees].[InterNYFees] AS [InterNYFees], 
    [vwAllAirlinesSumationFees].[DomeCUPPSFees] AS [DomeCUPPSFees], 
    [vwAllAirlinesSumationFees].[DomeNYFees] AS [DomeNYFees], 
