                                    // backgroundColor : ['#f56954', '#00a65a', '#f39c12', '#00c0ef', '#3c8dbc'],

                                    data: [@Model.TotalExecuteInplanCount, @Model.TotalExecuteOutplanCount]
                                }]
                            }, options: {
                                title: {
                                    display: true,
                                    text: "@Model.ExecuteInOutTitle"
