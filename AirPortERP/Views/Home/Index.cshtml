                });












                var ctx = document.getElementById("NightDayTitle").getContext('2d');
                var myPieChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {

                        labels: ["Day", "Night"],
                        datasets: [{
                            
                           // backgroundColor: ['#00c0ef', '#00a65a'],
                            backgroundColor: ['orange', 'black'],

                            // backgroundColor : ['#f56954', '#00a65a', '#f39c12', '#00c0ef', '#3c8dbc'],

                            data: [@Model.InDuityCount, @Model.InOverTimeCount]
                        }]
                    }, options: {
                        title: {
                            display: true,
                            text: "@Model.NightStopTitle"
                        }
                    }

                });





                var xValues = ["Local Movement", "Foreign Movement", "Local Domstic", "Local International"];
                var yValues = [@Model.Totallocal, @Model.TotalForeign, @Model.TotallocalDomstic, @Model.TotallocalInter];
                var barColors = ["green", "red", "blue", "orange"];

               // var barColors = ["green", "red", "blue", "orange", "brown"];
                new Chart("TripTypeTitle", {
                    type: "bar",
                    data: {
                        labels: xValues,
                        datasets: [{
                            backgroundColor: barColors,
                            data: yValues
                        }]
                    },
                    options: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: "@Model.TripTypeTitle"
                        }, scales: {
                            yAxes: [{
                                ticks: {
                                    beginAtZero: true
                                }
                            }],
                        }
                    }
                });













                @*var ctx_bar = document.getElementById("TripTypeTitle");
