@model IEnumerable<AirPortERP.ViewModels.PrintPushPackViewModel>

@{
    ViewBag.Title = ViewBag.Header;
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}


<style>


     /*////////////////////////////////////////////////////PushPack/////////////////////////////////////////////*/
              .invoicePushPack {
            padding:10px;
            font-family:Arial;
        }
       .invoicePushPack .invoice-PushPack-header {
            border:2px solid #808080;
            border-radius:5px;
            padding:16px;
            margin-bottom:10px;
        }
        
        .invoicePushPack .invoice-PushPack-header .text-word {
                  
               float:none;

        }
        .invoicePushPack .invoice-PushPack-header .text-word h6 {
            font-size:21px;
              font-weight:bolder;
        }
               .invoicePushPack .invoice-PushPack-header .image-R {
                    float:right;
                    margin-right:30px;
                     margin-top:-90px;
                   
            }
                .invoicePushPack .invoice-PushPack-header .image-L {
               float:left;
               margin-top:-10px;
                   
            }

            .invoicePushPack .invoice-PushPack-Body {
                clear:both;
            }

             .invoicePushPack .invoice-PushPack-Body .h-mr {
              margin-right:20px;
               
              /*ADD*/
              font-size:18px;
              font-weight:600;

        }


                .invoicePushPack .invoice-PushPack-details th {
                    background-color:#ebefef;
                      /*ADD*/
                    
                     font-weight:600;
                }

                .invoicePushPack .invoice-PushPack-details table {
                    min-width:1000px;
                    text-align:left;
                }

                    .invoicePushPack .invoice-PushPack-details table,th,td {
                 border:1px solid #282a2c; 
                 padding:.5rem;
               
                    /*ADD*/
                   font-size:18px;
               
            }

              

                .invoicePushPack .invoice-PushPack-details .footer {
                     background-color:#ebefef;
                     font-weight:600;

                }


















</style>








<section class="invoicePushPack">


    <div class="invoice-PushPack-header">



        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>


        <div class="text-center text-word">
            <h6>Sudan Airports Company .Ltd</h6>
            <h6>General Administration Of Finance Affairs</h6>
            <h6>Revenue Directorate</h6>
        </div>



        <div>
            <img src="~/Temp/Image/WhiteLogo.png" class="image-R" height="100" />
        </div>

    </div>


    <div class="invoice-PushPack-Body">
        <h4 class="text-center"><u> Invoice PushPack</u></h4>
        <div class="arline-header">
            <div class="row">
                <div class="col-md-12">

                    <label class="h-mr">Company: @ViewBag.Name</label>
                    <label class="h-mr">From: @ViewBag.DateFrom</label>
                    <label class="h-mr">To: @ViewBag.DateTo</label>
                    <label class="h-mr">ExchangeRate: @ViewBag.ExchangeRate</label>

                </div>

            </div>
        </div>
    </div>



    <div class="text-center invoice-PushPack-details" style="width:100%;margin-bottom:40px;">




        <table class="PushPack-table-header">

            <tr>
                <th>
                    N
                </th>
                <th>
                    Date
                </th>
              
                <th>
                    Flight No
                </th>
                               
                  <th>
                    Reg No
                </th>

                <th>
                    Type
                </th>
                <th>
                    Wt
                </th>

                <th>
                    Plane Size
                </th>

                <th>

                   Amount
                </th>
                <th>
                    Amount $

                </th>

                

               




              
            </tr>


            <tbody>
                @foreach (var item in Model)
            {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.N)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.LandingDate)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.FlightNo)
                        </td>


                        <td>
                            @Html.DisplayFor(modelItem => item.RegNo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Type)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Wt)
                        </td>





                        <td>
                            @Html.DisplayFor(modelItem => item.PlaneSize)
                        </td>


                        <td>
                            @Html.DisplayFor(modelItem => item.PushPackFees)
                        </td>
                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.AmountSDG)
                       </td>
                    </tr>
                }

                <tr class="footer">
                    <td colspan="7">  Total :</td>

                  

                    

                    <td class="numberFormat">@ViewBag.SumPushPackFees</td>

                    <td class="numberFormat">@ViewBag.SumAmountSDG</td>
                </tr>

                <tr class="footer">
                    <td colspan="7">  Tax :</td>

                   
                    <td class="numberFormat"> @ViewBag.TaxDollar </td>
                    <td class="numberFormat"> @ViewBag.TaxSDG </td>

                </tr>

                <tr class="footer">
                    <td colspan="7">  Grand Total :</td>
                    <td class="numberFormat"> @ViewBag.GrandTotalDollar </td>
                    <td class="numberFormat"> @ViewBag.GrandTotalSDG </td>
                </tr>

            </tbody>








        </table>




    </div>















</section>

<script src="~/Temp/plugins/jquery/jquery.min.js"></script>

@section scripts{

    <script>



           window.addEventListener("load", window.print());
        // window.location.href = "/AdvancePrint/PrintInvoice"


           $('.numberFormat').each(function () {
               var item = $(this).text();

               var N = round(item, 2);
               /// var N = item.toFixed(2);


               var num = Number(N).toLocaleString();
               $(this).text(num);
           });



           function round(value, exp) {
               if (typeof exp === 'undefined' || +exp === 0)
                   return Math.round(value);

               value = +value;
               exp = +exp;

               if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                   return NaN;

               // Shift
               value = value.toString().split('e');
               value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

               // Shift back
               value = value.toString().split('e');
               return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
           }


    </script>

}