


<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">AirLine Agents</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    @*<li class="breadcrumb-item"><a href="#">Home</a></li>*@
                    <li class="breadcrumb-item active">AirLine Agents</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>



<div class="loader" id="AjaxLoader" style="display:none;">
    <div class="strip-holder">
        @*<div class="strip-1"></div>
            <div class="strip-2"></div>
            <div class="strip-3"></div>*@

        <div class="sk-chase">
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
        </div>

    </div>

</div>


<section class="content">

    <p>

        <button class="btn btn-primary" onclick="getAirPort(0)">Add New AirPort</button>
        <button class="btn btn-info float-right" onclick="PrintData()">Print All AirLine Agents </button>
    </p>


   




    <div class="card">
        <div class="card-body">
            <div style="width:100%" class="table-responsive">

                <table id="dataTable" class="table table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Name in  Arabic </th>
                            <th>Name in English</th>
                            <th>Phone1</th>
                            <th>Phone2</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>AirLineName</th>
                            <th>IsActive</th>
                            <th>Operation</th>

                        </tr>
                    </thead>

                </table>

            </div>
        </div>
    </div>














    <!-- Model Start -->
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="myModel-content">

                <!-- Model content -->

                <div class="modal-footer justify-content-between">
                    <button class="btn btn-primary btn-xs">Save Change</button>
                    <button class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!--Model End -->

</section>
@section scripts{

    <script>
            var dataTable;
            $(document).ready(function () {

                dataTable = $("#dataTable").DataTable({

                    "processing": true,
                    // "serverSide": true,
                    "ajax": {
                        "url": "/AirLineAgents/GetAllAirLineAgents",
                        "type": "GET",
                        "datatype": "json",

                    },
                  
                    "columns": [
                        { "data": "Id", "autowidth": true },
                          { "data": "NameAr", "autowidth": true },
                             { "data": "NameAn", "autowidth": true },
                             { "data": "Phone1", "autowidth": true },
                                { "data": "Phone2", "autowidth": true },
                                   { "data": "Email", "autowidth": true },
                                     { "data": "Address", "autowidth": true },
                                        { "data": "AirLineName", "autowidth": true },
                                        

                                          {
                                              "data": "IsActive", "width": "50px", "render": function (data) {
                                                  var cssClass;
                                                  if (data === "Not Active") {
                                                      cssClass = "badge-danger";
                                                  }
                                                  if (data === "Active") {
                                                      cssClass = "badge-success";
                                                  }
                                                  return '<span class="badge ' + cssClass + '">' + data + '</span>'

                                              }
                                          },







                                   {
                                       "data": "Id", "width": "50px", "render": function (data) {
                                           return '<div class="btn-group"> <button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#" onclick="getAirPort(' + data + ')">Update</a><button class="dropdown-item"  onclick="Delete(' + data + ')">Delete</button></div></div>'

                                       }
                                   },


                    ], "language":
                                  {
                                      "sProcessing": "جارٍ التحميل...",
                                      "sLengthMenu": "أظهر _MENU_ مدخلات",
                                      "sZeroRecords": "لم يعثر على أية سجلات",
                                      "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                                      "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                                      "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                                      "sInfoPostFix": "",
                                      "sSearch": "ابحث:",
                                      "sUrl": "",
                                      "oPaginate": {
                                          "sFirst": "الأول",
                                          "sPrevious": "السابق",
                                          "sNext": "التالي",
                                          "sLast": "الأخير",
                                      }
                                  }
                });

            });


            function getAirPort(id) {

                $("#AjaxLoader").show()

                $.get("/AirLineAgents/GetAirLineAgentParial", { id: id }, function (nn) {

                    $("#myModel-content").html(nn);
                    $("#myModal").modal('show');
                    $("#AjaxLoader").hide()

                    $('.select2bs4').select2({
                        theme: 'bootstrap4'
                    })




                    $(function () {
                        $.validator.setDefaults({
                            submitHandler: function () {
                                alert("Form successful submitted!");
                            }
                        });
                        $('#quickForm').validate({
                            rules: {
                                NameAr: {
                                    required: true,
                                },
                                NameAn: {
                                    required: true,
                                },

                                Email: {
                                    email: true,
                                },
                                Phone1: {
                                    digits: true,
                                    maxlength: 14,
                                },
                                Phone2: {
                                    digits: true,
                                    maxlength: 14,
                                },
                                Address: {
                                    required: true,
                                },
                                AirLineId: {
                                    required: true,
                                },
                                IsActive: {
                                    required: true,
                                },


                            },
                            messages: {
                                NameAr: {
                                    required: "Please in inter arabic Name",

                                },
                                NameAn: {
                                    required: "Please in inter English Name",

                                },
                                Email: {
                                    email: "Please in inter Valid email",

                                },
                                Phone1: {
                                    digits: "Please inter Number Only ",
                                    maxlength: "phone must be at max 14 ",

                                },
                                Phone2: {
                                    digits: "Please inter Number Only ",
                                    maxlength: "phone must be at max 14 ",

                                },
                                Address: {
                                    required: "Please in inter English Address",

                                },
                                AirLineId: {
                                    required: "Please in inter Valid AirLineId",

                                },
                                IsActive: {
                                    required: "IsActive?",

                                },


                            },

                            errorElement: 'span',
                            errorPlacement: function (error, element) {
                                error.addClass('invalid-feedback');
                                element.closest('.form-group').append(error);
                            },
                            highlight: function (element, errorClass, validClass) {
                                $(element).addClass('is-invalid');
                            },
                            unhighlight: function (element, errorClass, validClass) {
                                $(element).removeClass('is-invalid');
                            }
                        });
                    });



                })













            }



            function CreateOrUpdate() {

                var model = $('#myModal');
                var form = $('form[name="DepartmentFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/AirLineAgents/CreateOrUpdateAirLineAgent", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل العام عميل ", "تعديل");
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه عام عميل ", "اضافه");
                            }
                            else if (res.message != null && res.message === "Used") {
                                toastr.error("العنصر موجود", "لم يتم الحفظ");
                            }
                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }




            function Delete(id) {


                swal({
                    title: "هل انت متاكد ",
                    text: " OK تقوم بحذف العنصر! عند الضعط علي",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                 .then((willDelete) => {
                     if (willDelete) {
                         $.get("/AirLineAgents/Delete", { id: id }, function (res) {
                             if (res) {

                                 if (res.message != null && res.message === "Used") {
                                     toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                                 }

                                 if (res.message != null && res.message === "Delete") {
                                     toastr.success("تم الحذف نوع عميل ", "الحذف");
                                 }
                                 dataTable.ajax.reload();
                             }
                         });
                     }
                 });

            }






         

            function PrintData() {

                window.location.href = "/AirLineAgents/PrintData";
            }



    </script>
}
