@model IEnumerable<AirPortERP.ViewModels.PrintCarServiceViewModel>

@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}


<style>

       /*////////////////////////////////////////////////////Car/////////////////////////////////////////////*/

                 .invoiceCar {
            padding:10px;
            font-family:Arial;
        }
       .invoiceCar .invoice-Car-header {
            border:2px solid #808080;
            border-radius:5px;
            padding:16px;
            margin-bottom:10px;
        }
        
        .invoiceCar .invoice-Car-header .text-word {
                  
               float:none;

        }
        .invoiceCar .invoice-Car-header .text-word h6 {
            font-size:21px;
              font-weight:bolder;
        }
               .invoiceCar .invoice-Car-header .image-R {
                    float:right;
                    margin-right:30px;
                     margin-top:-90px;
                   
            }
                .invoiceCar .invoice-Car-header .image-L {
               float:left;
               margin-top:-10px;
                   
            }

            .invoiceCar .invoice-Car-Body {
                clear:both;
            }

             .invoiceCar .invoice-Car-Body .h-mr {
              margin-right:20px;
              font-size:20px;
        }


                .invoiceCar .invoice-Car-details th {
                    background-color:#ebefef;
                    font-weight:700;

                }

                    .invoiceCar .invoice-Car-details table {
                        min-width:800px;
                    }

                    .invoiceCar .invoice-Car-details table,th,td {
                 border:1px solid #282a2c; 
                 padding:.7rem;
                 font-size:18px;
                 font-weight:500;
                
            }

              

                .invoiceCar .invoice-Landing-details .footer {
                     background-color:#ebefef
                }
          .invoiceCar .invoice-Car-details .Title-Car th {
              background-color:#dee6e6;
            border-top:2px solid #fff; 
             border-right:2px solid #fff; 
               border-left:2px solid #fff; 
              padding:.1rem;
              text-align:center;
                 /*ADD*/
               font-weight:600;

          }
                    .invoiceCar .invoice-Car-details .Title-Car .no-color {
                        background-color:#fff;
                    }

                    .invoiceCar .invoice-Car-details .footer td {
                          background-color:#f5f8f8;
                          font-weight:600;
                         
                    }
                        /*.invoiceCar .invoice-Car-details .table-footer{
                             font-weight:bolder;
                        }*/












</style>








<section class="invoiceCar">


    <div class="invoice-Car-header">



        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>


        <div class="text-center text-word">
            <h6>Sudan Airports Company .Ltd</h6>
            <h6>General Administration Of Finance Affairs</h6>
            <h6>Revenue Directorate</h6>
        </div>



        <div>
            <img src="~/Temp/Image/WhiteLogo.png" class="image-R" height="100" />
        </div>

    </div>


    <div class="invoice-Car-Body">
        <h4 class="text-center"><u> Invoice Service Car</u></h4>@*<br />*@
        <div class="arline-header">
            <div class="row">
                <div class="col-md-12">

                    <label class="h-mr">Company: @ViewBag.Name</label>
                    <label class="h-mr">From: @ViewBag.DateFrom</label>
                    <label class="h-mr">To: @ViewBag.DateTo</label>
                    <label class="h-mr">ExchangeRate: @ViewBag.ExchangeRate</label>

                </div>

            </div>
        </div>
    </div>



    <div class="invoice-Car-details" style="width:100%;margin-bottom:40px;">




        <table class="Car-table-header">


            <tr class="Title-Car">
                <th colspan="3" class="no-color">
                    
                </th>
               


               

                <th  colspan="4">
                    Ambulance
                </th>

                <th  colspan="4">
                    Fire Truck
                </th>

              




                



            </tr>









            <tr>
                <th>
                    N
                </th>
                <th>
                    Date
                </th>
                <th>
                    Flight No
                </th>
                <th>
                    A.NO
                  </th>


                <th>

                   A.fees
                </th>
                <th>
                    A.Amount

                </th>

                <th>
                    A.Amount SDG
                </th>

                <th>
                    Fire No
                </th>
              
                  <th>
                    F.Fees
                </th>




                <th>
                    F.Amount
                </th>

                <th>
                    F.Amount SDG
                </th>



            </tr>


            <tbody>
                @foreach (var item in Model)
            {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.N)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.LandingDate)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.FlightNo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AmbulanceNo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FeesAmbulance)
                        </td>





                        <td>
                            @Html.DisplayFor(modelItem => item.FeesAmbulanceAmount)
                        </td>


                        <td>
                            @Html.DisplayFor(modelItem => item.AmbulanceSDG)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FireNo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FeesFire)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.FeesFireAmount)
                        </td>



                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.FireSDG)
                        </td>


                      
                    </tr>
                }

                <tr class="footer">
                    <td colspan="5">  Total :</td>

                    <td class="numberFormat">@ViewBag.SumFeesAmbulanceAmount</td>
                    <td class="numberFormat">@ViewBag.SumAmbulanceSDG </td>

                    <td></td>

                    <td></td>

                    <td class="numberFormat">@ViewBag.SumFeesFireAmount</td>
                    <td class="numberFormat">@ViewBag.SumFireSDG</td>
                  
                   
                </tr>

                <tr class="footer">
                    <td colspan="5">  Tax :</td>

                    <td class="numberFormat">@ViewBag.TaxADollar  </td>
                    <td class="numberFormat">@ViewBag.TaxASDG  </td>
                    <td></td>

                    <td></td>

                    <td class="numberFormat">@ViewBag.TaxFDollar  </td>
                    <td class="numberFormat">@ViewBag.TaxFSDG  </td>

                </tr>

                <tr class="footer">
                    <td colspan="5"> Grand Total :</td>

                    <td class="numberFormat">@ViewBag.GrandATotalDollar  </td>
                    <td class="numberFormat">@ViewBag.GrandATotalSDG  </td>
                    <td></td>

                    <td></td>

                    <td class="numberFormat">@ViewBag.GrandFTotalDollar  </td>
                    <td class="numberFormat">@ViewBag.GrandFTotalSDG  </td>
                </tr>

            </tbody>








        </table>




    </div>















</section>

<script src="~/Temp/plugins/jquery/jquery.min.js"></script>

@section scripts{

    <script>



           window.addEventListener("load", window.print());
        // window.location.href = "/AdvancePrint/PrintInvoice"



           $('.numberFormat').each(function () {
               var item = $(this).text();

               var N = round(item, 2);
               /// var N = item.toFixed(2);


               var num = Number(N).toLocaleString();
               $(this).text(num);
           });



           function round(value, exp) {
               if (typeof exp === 'undefined' || +exp === 0)
                   return Math.round(value);

               value = +value;
               exp = +exp;

               if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                   return NaN;

               // Shift
               value = value.toString().split('e');
               value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

               // Shift back
               value = value.toString().split('e');
               return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
           }







    </script>

}