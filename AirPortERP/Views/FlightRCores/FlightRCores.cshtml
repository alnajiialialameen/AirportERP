@section scripts{

    <script>








        var dataTable;





            $(document).ready(function () {
                dataTable = $("#dataTable").DataTable({
                    "processing": true,
                    // "serverSide": true,
                    "ajax": {
                        "url": "/FlightRCores/GetAllFlightRCores",
                        "type": "GET",
                        "datatype": "json",
                    },
                    "columns": [

                        { "data": "Id", "autowidth": true },
                          { "data": "Acc4Name", "autowidth": true },
                           { "data": "FlightNo", "autowidth": true },
                             { "data": "FlightName", "autowidth": true },

                                 { "data": "Destination", "autowidth": true },
                                     { "data": "IsDomistic", "autowidth": true },


                                   //{
                                   //    "data": "Id", "width": "50px", "render": function (data) {
                                   //        return '<div class="btn-group"> <button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#" onclick="getCountries(' + data + ')">Update</a><button class="dropdown-item"  onclick="Delete(' + data + ')">Delete</button></div></div>'
                                   //    }
                                  // },

                    ], "language":
                                  {
                                      "sProcessing": "جارٍ التحميل...",
                                      "sLengthMenu": "أظهر _MENU_ مدخلات",
                                      "sZeroRecords": "لم يعثر على أية سجلات",
                                      "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                                      "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                                      "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                                      "sInfoPostFix": "",
                                      "sSearch": "ابحث:",
                                      "sUrl": "",
                                      "oPaginate": {
                                          "sFirst": "الأول",
                                          "sPrevious": "السابق",
                                          "sNext": "التالي",
                                          "sLast": "الأخير",
                                      }
                                  },
                    "dom": '<"top"l>rt<"bottom"ip><"clear">',
                    "fnInitComplete": function (oSettings, json) {
                        addSearchControl(json);
                    }
                });

              



                function addSearchControl(json) {
                    $("#dataTable thead").append($("#dataTable thead tr:first").clone());
                    $("#dataTable thead tr:eq(1) th").each(function (index) {
                        /*No Search*/
                        if (index == 0 ) {
                            $(this).replaceWith('<th><input type="hidden" placeholder="None"></input></th>');
                        }
                        /*Search as text field*/
                        if (index == 1 || index == 2 || index == 3 || index == 4) {
                            $(this).replaceWith('<th><input type="text" class="jsonText" placeholder="بحث"></input></th>');
                            var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") input");
                            searchControl.on('keyup', function () {
                                dataTable.column(index).search(searchControl.val()).draw();
                            });
                        }
                        /*Search as combobox*/
                        if (index == 5) {
                            var ClassCaseDropDown = $('<select/>');
                            ClassCaseDropDown.append($('<option/>').attr('value', '').text(' نوع الرحلة'));
                            var ClassCase = [];
                            $(json.data).each(function (index, element) {
                                if ($.inArray(element.IsDomistic, ClassCase) == -1) {
                                    ClassCase.push(element.IsDomistic);
                                    ClassCaseDropDown.append($('<option/>').attr('value', element.IsDomistic).text(element.IsDomistic));
                                }
                            });
                            $(this).replaceWith('<th>' + $(ClassCaseDropDown).prop('outerHTML') + '</th>');
                            var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") select");
                            searchControl.on('change', function () {
                                dataTable.column(index).search(searchControl.val() == "" ? "" : '^' + searchControl.val() + '$', true, false).draw();
                            });
                        }



                    
















                    });
                }






            });


            function getCountries(id) {

                $("#AjaxLoader").show()

                $.get("/Countries/GetCountryParial", { id: id }, function (nn) {

                    $("#myModel-content").html(nn);
                    $("#myModal").modal('show');
                    $("#AjaxLoader").hide()







                    $(function () {
                        $.validator.setDefaults({
                            submitHandler: function () {
                                alert("Form successful submitted!");
                            }
                        });
                        $('#quickForm').validate({
                            rules: {
                                NameAr: {
                                    required: true,

                                },
                                NameEn: {
                                    required: true,

                                },
                                Code: {
                                    required: true,

                                },

                            },
                            messages: {
                                NameAr: {
                                    required: "Plase Enter Arabic Name",

                                },
                                NameEn: {
                                    required: "Plase Enter English Name",

                                },
                                Code: {
                                    required: "Plase Enter Code",

                                },

                            },
                            errorElement: 'span',
                            errorPlacement: function (error, element) {
                                error.addClass('invalid-feedback');
                                element.closest('.form-group').append(error);
                            },
                            highlight: function (element, errorClass, validClass) {
                                $(element).addClass('is-invalid');
                            },
                            unhighlight: function (element, errorClass, validClass) {
                                $(element).removeClass('is-invalid');
                            }
                        });
                    });
                })













            }



            function CreateOrUpdate() {

                var model = $('#myModal');
                var form = $('form[name="DepartmentFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/Countries/CreateOrUpdateCountry", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل الدولة  ", "تعديل");
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه عام دولة ", "اضافه");
                            }
                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                            else if (res.message == null || res.message === "Used") {
                                toastr.error("لم يتم الحفظ", "موجود");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }


            function Delete(id) {


                swal({
                    title: "هل انت متاكد ",
                    text: " OK تقوم بحذف العنصر! عند الضعط علي",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                 .then((willDelete) => {
                     if (willDelete) {
                         $.get("/Countries/Delete", { id: id }, function (res) {
                             if (res) {

                                 if (res.message != null && res.message === "Used") {
                                     toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                                 }

                                 if (res.message != null && res.message === "Delete") {
                                     toastr.success("تم الحذف نوع الدولة ", "الحذف");
                                 }
                                 dataTable.ajax.reload();
                             }
                         });
                     }
                 });

            }



















            function PrintData() {

                window.location.href = "/Countries/PrintData?";
            }















    </script>
}
