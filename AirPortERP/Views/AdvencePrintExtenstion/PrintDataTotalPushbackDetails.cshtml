@model IEnumerable<AirPortERP.ViewModels.PrintTotalCompaniesPushPackModel>

@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}











<section class="invoicePushPackDetails">


    <div class="invoice-PushPackDetails-header">



        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>


        <div class="text-center text-word">
            <h6>Sudan Airports Company .Ltd</h6>
            <h6>General Administration Of Finance Affairs</h6>
            <h6>Revenue Directorate</h6>
        </div>



        <div>
            <img src="~/Temp/Image/WhiteLogo.png" class="image-R" height="100" />
        </div>

    </div>

    <br />
    <h4 class="text-center"><u> Pushback Fees</u></h4><br />
    <div class="invoice-PushPackDetails-Body" style="float:right;">

        <div class="arline-header">
            <div class="row">
                <div class="col-md-12">


                    @*<label class="mr-5">Amount: @ViewBag.Amount</label>*@

                    <label class="mr-5">ExchangeRate: @ViewBag.ExchangeRate</label>

                    <label class="h-mr">  @ViewBag.txtDate  :عن شــهــر (Pushback)مـطالبات رسوم الدفع الخلفي   <span></span></label>

                </div>

            </div>
        </div>
    </div>

    <br />

    <div class="invoice-PushPackDetails-details">




        <table class="PushPackDetails-table-header">



            <tr class="header1">
               
                <th colspan="3">
                    الدفع الخلفي
                </th>

                <th rowspan="2">
                    الشركة
                </th>


                <th  rowspan="2">
                    N
                </th>
            </tr>








            <tr>
                <th>
                    الجملة
                </th>
             
                <th>
                    %الضريبة 5
                </th>
                <th>
                    المبلغ
                </th>

              


             
            </tr>


            <tbody>
                @foreach (var item in Model)
            {
                    <tr>

                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.GrandTotalSDG)
                        </td>


                      




                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.TaxSDG)
                        </td>




                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.TotalAmountSDG)
                        </td>


                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>


                        <td>
                            @Html.DisplayFor(modelItem => item.N)
                        </td>

                    </tr>
                }

                <tr class="footer">



                    <td class="numberFormat">@ViewBag.SumGrandTotalSDG</td>

                    <td class="numberFormat">@ViewBag.SumTaxSDG</td>

                    <td class="numberFormat">@ViewBag.SumTotalAmountSDG</td>

                   

                    <td colspan="2">  الجملة </td>
                </tr>
            </tbody>
        </table>

        <table class="table-explan">
            <tr>
                <th > اجمالي المستحق  </th>
                <th> اجمالي الخصم  </th>
                <th > مطالبة سودانير  </th>
                <th> خصم  </th>

                <th> الرسوم  </th>

                <th > البيان  </th>


            </tr>
           
            
            
             <tr>
                 <td class="numberFormat"> @ViewBag.KhartoumPart </td>
                 <td></td>
                 <td></td>
                 <td></td>
                <td class="numberFormat"> @ViewBag.KhartoumPart </td>

                <td>  %الادارة العامة لمطار الخرطوم 40 </td>
            </tr>

            <tr>
                <td class="numberFormat">@ViewBag.NetTotalRequest</td>
                <td class="numberFormat">@ViewBag.LastTotalRequested</td>
                <td class="numberFormat">@ViewBag.FinalAmountForSudanAirWays</td>
                <td class="numberFormat"> @ViewBag.SudanAirPartDis </td>

                <td class="numberFormat"> @ViewBag.SudanAirPart </td>
                <td>  %الخطوط الجوية السودانية 60 </td>
            </tr>

            <tr>
                <td></td>
                <td></td>
                <td class="numberFormat">@ViewBag.LastRequestedAmountSDG</td>
                <td></td>
                <td></td>
                <td>  متبقي فاتورة الشهر السابق </td>
            </tr>










            <tr>
              
                <td></td>
                <td></td>
                <th class="numberFormat">@ViewBag.TotalRequested</th>
                <th class="numberFormat"> @ViewBag.SudanAirPartDis </th>
                <th class="numberFormat"> @ViewBag.SumTotalAmountSDG </th>
                <th>  جملة المبلغ </th>
            </tr>




        </table>


    </div>



    <div class="prepared">
        @*<h5 class="f-right">@ViewBag.SupervisorName /إعداد </h5>
            <h5 class="f-left">@ViewBag.ManagerName/راجعه</h5>*@

        <h6 class="f-right">  / اعداد</h6>
        <h6 class="f-left">   راجعة/ @ViewBag.ManagerName</h6>
    </div>











</section>

<script src="~/Temp/plugins/jquery/jquery.min.js"></script>

@section scripts{

    <script>



           window.addEventListener("load", window.print());
        // window.location.href = "/AdvancePrint/PrintInvoice"


           $('.numberFormat').each(function () {
               var item = $(this).text();
               var num = Number(item).toLocaleString();
               $(this).text(num);
           });


    </script>

}