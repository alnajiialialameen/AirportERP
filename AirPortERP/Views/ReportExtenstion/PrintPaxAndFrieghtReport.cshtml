@model List<AirPortERP.ViewModels.RepoObj>

@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}


<style>
    /*////////////////////////////////////////////////////Cupps/////////////////////////////////////////////*/
    .invoiceNy {
        padding: 10px;
        font-family: Arial;
    }

        .invoiceNy .invoice-Ny-header {
            border: 2px solid #808080;
            border-radius: 5px;
            padding: 16px;
            margin-bottom: 10px;
        }

            .invoiceNy .invoice-Ny-header .text-word {
                float: none;
            }

                .invoiceNy .invoice-Ny-header .text-word h6 {
                    font-size: 21px;
                    font-weight: bolder;
                }

            .invoiceNy .invoice-Ny-header .image-R {
                float: right;
                margin-right: 30px;
                margin-top: -90px;
            }

            .invoiceNy .invoice-Ny-header .image-L {
                float: left;
                margin-top: -10px;
            }

        .invoiceNy .invoice-Ny-Body {
            clear: both;
        }

            .invoiceNy .invoice-Ny-Body .h-mr {
                margin-right: 20px;
                font-size: 21px;
            }


        .invoiceNy .invoice-Ny-details th {
            background-color: #ebefef;
        }

        .invoiceNy .invoice-Ny-details table {
            min-width: 1000px;
            text-align: left;
        }

        .invoiceNy .invoice-Ny-details table, th, td {
            border: 1px solid #282a2c;
            padding: .5rem;
            font-size: 18px;
        }



        .invoiceNy .invoice-Ny-details .footer {
            background-color: #ebefef;
            font-weight: 600;
        }
    .TitleDiscount {

        font-weight:normal;
        font-size:x-small;

    }
</style>

















<section class="invoiceNy">


    <div class="invoice-Ny-header">



        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>


        <div class="text-center text-word">
            <h6>Sudan Airports Company .Ltd</h6>
            <h6>Portsudan International Airport</h6>
            <h6>Operations And Facilities Management</h6>
        </div>



        <div>
            <img src="~/Temp/Image/WhiteLogo.png" class="image-R" height="100" />
        </div>

    </div>


    <div class="invoice-Ny-Body">
        <h4 class="text-center"><u>Passenegers And Cargo Flights</u></h4>
        <div class="arline-header">
            <div class="row">
                <div class="col-md-12">
                    <label class="h-mr">From: @ViewBag.DateFrom</label>
                    <label class="h-mr">To: @ViewBag.DateTo</label>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center invoice-Ny-details" style="width:100%;margin-bottom:40px;">
        <table class="Ny-table-header">
            <tr>
                <th>
                    Month
                </th>
                <th>
                    Flights Count
                </th>
                <th>
                    Total Freight In(TN)
                </th>
                <th>
                    Total Freight Out(TN)
                </th>
                <th>
                    Total Passenegers
                </th>
            </tr>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">
                            @Html.DisplayFor(modelItem => item.Month)
                        </td>
                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.TripCount)
                        </td>
                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.TotalFreightIn)
                        </td>
                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.TotalFreightOut)
                        </td>
                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.TotalPax)
                        </td>
                    </tr>
                }

                <tr class="footer">
                    <td colspan="1">  Total :</td>
                    <td class="numberFormat text-center">@Model.Sum(x => x.TripCount)</td>
                    <td class="numberFormat text-center">@Model.Sum(x => x.TotalFreightIn)</td>
                    <td class="numberFormat text-center">@Model.Sum(x => x.TotalFreightOut)</td>
                    <td class="numberFormat text-center">@Model.Sum(x=> x.TotalPax)</td>
                </tr>

            </tbody>
        </table>

        <br />
        <br />
        <div class="d-flex row justify-content-between">
            <div class="Dept">
                <span>Chief Of Dept</span><br /><br />
                <span>-------------------------------</span>
            </div>

            <div class="Manager">
                <span>Directorate Manager</span><br /><br />
                <span>-------------------------------</span>

            </div>
        </div>
    
        <div class="d-flex row justify-content-center">
            <span>Date :</span>
            <span>@DateTime.Now</span>
        </div>
    </div>

</section>

<script src="~/Temp/plugins/jquery/jquery.min.js"></script>

@section scripts{

    <script>



           window.addEventListener("load", window.print());
        // window.location.href = "/AdvancePrint/PrintInvoice"


           $('.numberFormat').each(function () {
               var item = $(this).text();

               var N = round(item, 2);
               /// var N = item.toFixed(2);


               var num = Number(N).toLocaleString();
               $(this).text(num);
           });



           function round(value, exp) {
               if (typeof exp === 'undefined' || +exp === 0)
                   return Math.round(value);

               value = +value;
               exp = +exp;

               if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                   return NaN;

               // Shift
               value = value.toString().split('e');
               value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

               // Shift back
               value = value.toString().split('e');
               return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
           }


    </script>

}