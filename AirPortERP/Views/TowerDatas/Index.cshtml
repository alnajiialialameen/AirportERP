        function CreateOrUpdate() {

            $("#AjaxLoader").show()

            var model = $('#myModalUpdate');
            var form = $('form[name="TowerUpdateFormAdd"]');


            form.validate();
            if (!form.valid()) {
                $("#AjaxLoader").hide()
                return;
            } else {
                var Date = $('#DateU').val();
                $('#DateU').val(moment(Date, "DD/MM/YYYY").format("DD/MM/YYYY"));

                var LandingDate = $('#LandingDateU').val();
                $('#LandingDateU').val(moment(LandingDate, "DD/MM/YYYY").format("DD/MM/YYYY"));

                var TakeOffDate = $('#TakeOffDateU').val();
                $('#TakeOffDateU').val(moment(TakeOffDate, "DD/MM/YYYY").format("DD/MM/YYYY"));

                var data = form.serialize();
                $.post("/TowerDatas/CreateOrUpdateTakeOffU", data, function (res) {
                    if (res) {
                        if (res.message != null && res.message === "Update") {
                            toastr.success("تم تعديل العام Movement ", "تعديل");
                        }
                        else if (res.message != null && res.message === "isStop") {
                            toastr.error("تاريخ هذه الرحلة تم تحرير المطالبة المالية لة مسبقا ", "تم تحرير مطالبة هذا التاريخ ");
                        }
                        else if (res.message != null && res.message === "Add") {
                            toastr.success("تم اضافه عام Movement ", "اضافه");
                        }

                        else if (res.message === "Used") {
                            toastr.error("العنصر موجود", "اضافه");
                        }
                        else if (res.message != null || res.message === "error") {
                            toastr.error("حدث خطا ", "لم يتم الحفظ");
                        }

                        model.modal('hide');
                        $("#AjaxLoader").hide()

                        dataTable.ajax.reload();
                    }

                })
            }
        }


        function Delete(id) {


