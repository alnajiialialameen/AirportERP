<section class="content">













    <link href="~/Temp/dist/css/PagedList.css" rel="stylesheet" />
    <script src="~/Temp/dist/js/sorting.js"></script>
    <style>
        .badge-warning {
            color: #1f2d3d;
            background-color: #ffc107;
        }
    </style>


    <div class="card card-default">
        @*<div class="card-header">
                <h3 class="card-title">Select2 (Bootstrap4 Theme)</h3>

                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                    <button type="button" class="btn btn-tool" data-card-widget="remove"><i class="fas fa-times"></i></button>
                </div>
            </div>*@
        <!-- /.card-header -->
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">





                    <div class="form-group">
                        <label>Flight Type</label>
                        <select class="form-control" id="FlightTypeId">
                            <option value="0"></option>
                            <option value="1">InterNational</option>
                            <option value="2">Domestic</option>
                        </select>
                    </div>





                    <div class="form-group">
                        <label>  AirLine</label>
                        <select class="form-control select2bs4" id="DDlAirLineId" name="AirLineId">
                            <option value="0"></option>
                            @foreach (AirLine AirLine in db.AirLines.OrderBy(x=>x.Id).ToList())
                            {
                                <option value="@AirLine.Id">@AirLine.Name</option>
                            }
                        </select>
                    </div>


                    <div class="form-group">
                        <label>  Reg</label>
                        <select class="form-control select2bs4" id="RegId">
                            <option value="0"></option>
                            @foreach (AircraftRegistration Reg in db.AircraftRegistrations.OrderBy(x => x.Id).ToList())
                            {
                                <option value="@Reg.Id">@Reg.Registration</option>
                            }
                        </select>
                    </div>








                    <div class="form-group">
                        <label>  FlightNo</label>
                        <select class="form-control select2bs4" id="DDlFlightNo">
                            <option value="0"></option>
                            @foreach (AirLinesFlightTrip AirLinesFlightTrip in db.AirLinesFlightTrips.OrderBy(x => x.Id).ToList())
                            {
                                <option value="@AirLinesFlightTrip.Id">@AirLinesFlightTrip.FlightNo</option>
                            }
                        </select>
                    </div>
                    <!-- /.form-group -->
                    @*<div class="form-group">
                        <label>نوع الدورة</label>
                        <select class="form-control" id="InOutCaseId">
                            <option value="0"></option>
                            @foreach (InOutCase d in db.InOutCases.ToList())
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>*@


                </div>

                <div class="col-md-6">

                    <div class="form-group">
                        <label>  From</label>
                        <select class="form-control select2bs4" id="AirPortIdFrom">
                            <option value="0"></option>
                            @foreach (AirPort AirPortFrom in db.AirPorts.OrderBy(x => x.Id).ToList())
                            {
                                <option value="@AirPortFrom.Id">@AirPortFrom.Code</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>  To</label>
                        <select class="form-control select2bs4" id="AirPortIdTo">
                            <option value="0"></option>
                            @foreach (AirPort AirPortTo in db.AirPorts.OrderBy(x => x.Id).ToList())
                            {
                                <option value="@AirPortTo.Id">@AirPortTo.Code</option>
                            }
                        </select>
                    </div>








                    @*<div class="form-group">
                        <label>داخل/خارج الخطة</label>
                        <select class="form-control" id="IsInPlan">
                            <option value="0"></option>
                            <option value="1">داخل الخطة</option>
                            <option value="2">خارج الخطة</option>
                        </select>
                    </div>*@


                    <div class="form-group">
                        <label>بين الفترة</label>

                        <div class="row">
                            <div class=" col-md-6">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"> From  </i></span>
                                    </div>
          @*<input type="text" class="form-control datetime" data-inputmask-alias="datetime" id="DateFrom" data-inputmask-inputformat="dd/mm/yyyy" data-mask>*@
                                    <input type="date" id="DateFrom" />
                                </div>

                            </div>

                            <div class=" col-md-6">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"> To  </i></span>
                                    </div>
                                    <input type="date" id="DateTo" />

                                    @*<input type="text" class="form-control datetime" data-inputmask-alias="datetime" id="DateTo" data-inputmask-inputformat="dd/mm/yyyy" data-mask>*@
                                </div>

                            </div>
                        </div>

                    </div>


                    <div class="form-group">
                        <label> بحث</label>

                        <div class="row">
                            <div class=" col-md-6">
                                <button id="btnsearch" onclick="Search()" class="btn btn-primary btn-sm form-control">بحث</button>


                            </div>

                            <div class=" col-md-6">
                                <button id="btnall" onclick="PrintData()" class="btn form-control btn-info btn-sm">Print Search </button>

                            </div>
                        </div>

                    </div>







                </div>

            </div>

        </div>


    </div>

    <!-- //////////////////////////////////////////////////////////////////////////////////////////////////////// -->
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" id="myModel-content">

                <!-- Model content -->

                <div class="modal-footer justify-content-between">
                    <button class="btn btn-primary btn-xs">Save Change</button>
                    <button class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-/////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->

    <div class="card">
        <div class="card-body card-table">
            <div class="table-body">
                @Html.Action("GetData")
            </div>
        </div>
    </div>






 
















</section>
@section scripts{

    <script language="javascript" type="text/javascript">

            $(document).ready(function () {


                  $('.select2bs4').select2({
                            theme: 'bootstrap4'
                        });







                $(document).on("click", "#contentPager a[href]", function () {

                    $.ajax({

                        url: $(this).attr("href"),

                        type: 'GET',

                        cache: false,

                        success: function (result) {

                            $('#content').html(result);

                        }

                    });

                    return false;

                });



                $("#DDlAirLineId").change(function () {
                    debugger;
                    var value = $('#DDlAirLineId').val();
                    //var valuePlanOut =
                    //var valuePlanIn = $('#RbInPlan').val();



                    //     alert("هل تريد اختيار دورة خارجية");
                    $("#DDlFlightNo option").remove()
                    var url = "/TowerDatas/GetFlightNo/" + value;
                    $.getJSON(url, function (data) {
                        $.each(data, function (key, val) {
                            var ele = $('<option value="' + val.Id + '">' + val.FlightNo + '</option>');
                            $("#DDlFlightNo").append(ele);
                        });
                    });


                })


                $('.datetime').datepicker({
                    dateFormat: "dd/mm/yy",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-60:+0"
                });





            });
          





            function Search() {
                $("#AjaxLoader").show()
             

                var RegId = $("#RegId").val();

                var DDlFlightNo = $("#DDlFlightNo").val();
                var AirPortIdFrom = $("#AirPortIdFrom").val();
                var AirPortIdTo = $("#AirPortIdTo").val();

                var DateFrom = $("#DateFrom").val();

                var DateTo = $("#DateTo").val();
                var FlightTypeId = $("#FlightTypeId").val();

             //   var AirLineId = $('select[name=AirLineId]').val();
                var DDlAirLineId = $("#DDlAirLineId").val();
                
                $.ajax({
                    url: '@Url.Action("GetData", "TowerDatas")',
                    data: {

                        Get: 1, Search: 1,
                        AirLineId: DDlAirLineId
                        , FlightNo: DDlFlightNo, AirPortIdFrom: AirPortIdFrom
                        , AirPortIdTo: AirPortIdTo
                        , DateFrom: DateFrom,
                         DateTo: DateTo,
                         RegId: RegId,
                         FlightTypeId: FlightTypeId

                    },
                    type: 'GET',
                    cache: false,
                    success: function (result) {
                        $('#content').html(result);
                        $("#AjaxLoader").hide();
                    }
                });
            }


       
        function SearchUpdate() {
            $("#AjaxLoader").show()
        
            var RegId = $("#RegId").val();

            var DDlFlightNo = $("#DDlFlightNo").val();
            var AirPortIdFrom = $("#AirPortIdFrom").val();
            var AirPortIdTo = $("#AirPortIdTo").val();

            var DateFrom = $("#DateFrom").val();

            var DateTo = $("#DateTo").val();
            var FlightTypeId = $("#FlightTypeId").val();

            var DDlAirLineId = $("#DDlAirLineId").val();


            $.ajax({
                url: '@Url.Action("GetData", "TowerDatas")',
                data: {

                    Get: 1, Search: 1,
                    AirLineId: DDlAirLineId
                    , FlightNo: DDlFlightNo, AirPortIdFrom: AirPortIdFrom
                    , AirPortIdTo: AirPortIdTo
                    , DateFrom: DateFrom,
                    DateTo: DateTo,
                    RegId: RegId,
                    FlightTypeId: FlightTypeId,
                    page:null

                },
                type: 'GET',
                cache: false,
                success: function (result) {
                    $('#content').html(result);
                    $("#AjaxLoader").hide();
                }
            });
        }

      





     /////////////////////////////////////////////////////////////////
        function getTakeOffData(id) {

            $("#AjaxLoader").show()

            $.get("/TowerDatas/GetAircraftTakeOffParial", { id: id }, function (nn) {

                $("#myModel-content").html(nn);
                $("#myModal").modal('show');
                $("#AjaxLoader").hide()

                $('#AirLineId').select2({
                    theme: 'bootstrap4'
                })
                $('#AircraftRegId').select2({
                    theme: 'bootstrap4'
                })
                $('#FlightNo').select2({
                    theme: 'bootstrap4'
                })


                $('#AirportIdFrom').select2({
                    theme: 'bootstrap4'
                })
                $('#AirportIdTo').select2({
                    theme: 'bootstrap4'
                })
                $('#FlightNo').select2({
                    theme: 'bootstrap4'
                })






                $('#timepicker').datetimepicker({
                    use24hours: true,
                    format: 'HH:mm'
                })






                $('#timepicker1').datetimepicker({
                    use24hours: true,
                    format: 'HH:mm'
                })
                $('#Date').datetimepicker({
                    format: 'L'
                });
                $('#LandingDate').datetimepicker({
                    format: 'L'
                });
                $('#TakeOffDate').datetimepicker({
                    format: 'L'
                });


                $("#AirLineId").change(function () {
                    debugger;
                    var value = $('#AirLineId').val();
                    //var valuePlanOut =
                    //var valuePlanIn = $('#RbInPlan').val();



                    //     alert("هل تريد اختيار دورة خارجية");
                    $("#FlightNo option").remove()
                    var url = "/TowerDatas/GetFlightNo/" + value;
                    $.getJSON(url, function (data) {
                        $.each(data, function (key, val) {
                            var ele = $('<option value="' + val.Id + '">' + val.FlightNo + '</option>');
                            $("#FlightNo").append(ele);
                        });
                    });


                })

                $('#quickForm').validate({
                    rules: {
                        ATD: {
                            required: true,
                        },
                        TakeOffDate: {
                            required: true,
                            date: true,
                        },
                        FlightNo: {
                            required: {
                                depends: function (element) {
                                    if ('0' == $('#FlightNo').val()) {
                                        //Set predefined value to blank.
                                        $('#FlightNo').val('');
                                    }
                                    return true;
                                }
                            }
                        },
                        AirportIdFrom: {
                            required: true,

                        },
                        AirportIdTo: {
                            required: true,

                        },
                        QBD: {
                            required: true,

                        },
                        ATA: {
                            required: true,

                        },
                        TripTypeId: {
                            required: true,

                        },
                        POB: {
                            required: true,

                        },
                        AirLineId: {
                            required: true,

                        },
                        AircraftRegId: {
                            required: true,

                        },
                        Date: {
                            required: true,
                            date: true,



                        },
                        LandingDate: {
                            required: true,
                            date: true,

                        },

                    },
                    messages: {
                        ATD: {
                            required: "Please Enter ATD",

                        },
                        TakeOffDate: {
                            required: "Please Take Off Date ",

                        },
                        FlightNo: {
                            required: "Please Select FlightNo",

                        },
                        AirportIdFrom: {
                            required: "Select Airport From",

                        },
                        AirportIdTo: {
                            required: "Select AirportId To",

                        },
                        QBD: {
                            required: "Enter QBD",

                        },
                        ATA: {
                            required: "Enter ATA",

                        },
                        TripTypeId: {
                            required: "Select Trip Type",

                        },
                        POB: {
                            required: "Enter POB",

                        },
                        AirLineId: {
                            required: "select AirLine",

                        },
                        AircraftRegId: {
                            required: "Select Reg",

                        },
                        Date: {
                            required: "Select Date",


                        },
                        LandingDate: {
                            required: "Select LandingDate",
                            date: "Please Enter valid Date",
                        },


                    },
                    errorElement: 'span',
                    errorPlacement: function (error, element) {
                        error.addClass('invalid-feedback');
                        element.closest('.form-group').append(error);
                    },
                    highlight: function (element, errorClass, validClass) {
                        $(element).addClass('is-invalid');
                    },
                    unhighlight: function (element, errorClass, validClass) {
                        $(element).removeClass('is-invalid');
                    }
                });

            })

            $('html,body').animate({
                scrollTop: '+=100px'
            });
        }



        function CreateOrUpdate() {


            var model = $('#myModal');
            var form = $('form[name="DepartmentFormAdd"]');


            form.validate();
            if (!form.valid()) {
                return;
            } else {
                var data = form.serialize();
                $.post("/TowerDatas/CreateOrUpdateTakeOff", data, function (res) {
                    if (res) {
                        if (res.message != null && res.message === "Update") {
                            toastr.success("تم تعديل العام Movement ", "تعديل");
                        }
                        else if (res.message != null && res.message === "Add") {
                            toastr.success("تم اضافه عام Movement ", "اضافه");
                        }
                        else if (res.message == null || res.message === "Repeat") {
                            toastr.error("لم يتم الحفظ", "تاريخ الاقلاع و الزمن الفعلي للاقلاع يجب كتابتهما معا او تركهما معا");
                        }
                        else if (res.message == null || res.message === "InvalidDate") {
                            toastr.error("لم يتم الحفظ", "لا يمكن تاريخ الاقلاع اقل من تاريخ الوصول");
                        }
                        else if (res.message == null || res.message === "error") {
                            toastr.error("حدث خطا ", "لم يتم الحفظ");
                        }

                        model.modal('hide');

                      
                       
                       
                        SearchUpdate();
                      
                     
                            //$("html, body").animate({
                            //    scrollTop: $(
                            //      'html, body').get(0).scrollHeight
                            //});
                     


                      
                    }

                })
            }
        }

        function Delete(id) {


            swal({
                title: "هل انت متاكد ",
                text: " OK تقوم بحذف العنصر! عند الضعط علي",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
             .then((willDelete) => {
                 if (willDelete) {
                     $.get("/TowerDatas/Delete", { id: id }, function (res) {
                         if (res) {

                             if (res.message != null && res.message === "Used") {
                                 toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                             }

                             if (res.message != null && res.message === "Delete") {
                                 toastr.success("تم الحذف نوع Movement ", "الحذف");
                             }
                             SearchUpdate();
                         }
                     });
                 }
             });

        }


     
       






       


        function PrintData() {

            var DDlAirLineId = $("#DDlAirLineId").val();
            var DDlFlightNo = $("#DDlFlightNo").val();
            var AirPortIdFrom = $("#AirPortIdFrom").val();
            var AirPortIdTo = $("#AirPortIdTo").val();
            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();

            var RegId = $("#RegId").val();
            var FlightTypeId = $("#FlightTypeId").val();
            
            



            window.location.href = "/TowerDatas/PrintData?AirLineId=" + DDlAirLineId
                + "&&FlightNo=" + DDlFlightNo + "&&AirPortIdFrom=" + AirPortIdFrom +
            "&&AirPortIdTo=" + AirPortIdTo + "&&DateFrom=" + DateFrom + "&&DateTo=" + DateTo
            + "&&RegId=" + RegId + "&&FlightTypeId=" + FlightTypeId;
            

        }

















    </script>

}
