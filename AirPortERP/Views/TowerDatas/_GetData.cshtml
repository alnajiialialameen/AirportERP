@model PagedList.IPagedList<AirPortERP.Models.TowerData>

@using PagedList.Mvc

@{

    Layout = null;

}

<style>
    .re-sort:hover {
      
        color:#2d2cdd;
        text-decoration:double;
      
    }
</style>


<div id="content">
    <div class="table-responsive">
        <table id="testTable" class="table table-bordered table-sm table-hover" style="width:100%;font-size:14px">


            <tr>

                <th>ID </th>

                <th>

                    <div onclick="sortTable()" class="re-sort"><i class="fa fa-sort"></i> <a>Call Sing</a></div>


                </th>

                <th>
                    FlightNo
                </th>
                <th>
                    Reg
                </th>
              
                <th>
                    Wt
                </th>




                <th>
                    From
                </th>
                <th>
                    To
                </th>
                <th>
                    Date
                </th>
                <th>
                    ATA
                </th>
                <th>
                    ATD
                </th>

                @*<th>
                    POB
                </th>
                <th>
                    QBD
                </th>*@
                <th>
                    Landing Date
                </th>
                <th>
                    Take Off Date
                </th>
                <th>
                    FlightType
                </th>
                <th>Operation</th>

            </tr>
          

            @foreach (var item in Model)

            {

                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.AirLine.Code)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.AirLinesFlightTrip.FlightNo)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.AircraftRegistration.Registration)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.AircraftRegistration.MaxTakoffWieght)
                    </td>
                    <td>

                        @Html.DisplayFor(modelItem => item.AirPort1.Code)

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AirPort.Code)

                    </td>
                    <td>
                        @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.Date))
                    </td>


                    <td>
                        @Html.DisplayFor(modelItem => item.ATA)

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ATD)

                    </td>



                    @*<td>
                        @Html.DisplayFor(modelItem => item.POB)

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.QBD)

                    </td>*@

                    <td>
                        @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.LandingDate))
                    </td>

                    <td>
                        @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.TakeOffDate))
                    </td>


                    <td>
                        @{
                            var CssClass = "";
                            var FlightType = "";
                            if (item.FlightTypeD == 2 && item.FlightTypeL==2)
                            {
                                CssClass = "badge-danger";
                                FlightType = "Domestic";

                            }
                            else 
                            {
                                CssClass = "badge-success";
                                FlightType = "International";
                            }

                        }


                        <span class="badge @CssClass ">@FlightType  </span>
                    </td>








                    <td>
                     

                        <div class="btn-group">

                            <button type="button" class="btn btn-sm btn-primary btn-light" data-toggle="dropdown">
                                <i class="fa fa-ellipsis-v"></i>
                            </button>
                            <div class="dropdown-menu" role="menu">
                                <a class="dropdown-item" onclick="getTakeOffData(@item.Id)" href="#">Update</a>
                                <a class="dropdown-item" href="@Url.Action("Details", "TowerDatas")/@item.Id">More Details</a>

                                @*<a class="dropdown-item" href="#">Something else here</a>*@
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" onclick="Delete(@item.Id)" href="#">Detete </a>
                            </div>
                        </div>

                    </td>

                </tr>

            }

        </table>
      
        <br />

        صفحة  @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) من  @Model.PageCount  (عدد عناصر @ViewBag.ItemCount) 

        <div id="contentPager">

            @Html.PagedListPager(Model, page => Url.Action("GetData", new { page,
           // int? AirPortIdFrom,int? AirPortIdTo
           Get = 1
           ,Search=2,
           Count= ViewBag.ItemCount,
           AirLineId = ViewBag.AirLineId,
           FlightNo = ViewBag.FlightNo,
           AirPortIdFrom = ViewBag.AirPortIdFrom,
           AirPortIdTo = ViewBag.AirPortIdTo,
           DateTo = ViewBag.DateTo,
           DateFrom = ViewBag.DateFrom,
           RegId = ViewBag.RegId,
           FlightTypeId = ViewBag.FlightTypeId,
       }))
        </div>
    </div>

   @if (ViewBag.ItemCount > 0)
   {

        @*<div class="col-6">
        

            <div class="table-responsive">
                <table class="table">
                    <tr>
                        <th style="width:50%">عدد الدورات:</th>
                        <td>@ViewBag.ItemCount</td>
                    </tr>
                    <tr>
                        <th>مجموع النثريات</th>
                        <td>@ViewBag.Allowance</td>
                    </tr>
                    <tr>
                        <th>اجمالي التكلفة:</th>
                        <td>@ViewBag.Amount</td>
                    </tr>
                   
                </table>
            </div>
        </div>*@


   }





</div>


