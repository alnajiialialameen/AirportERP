    @using AirPortERP.Models;
    @using Microsoft.AspNet.Identity;
    @using AirPortERP.Extenstion;

    @{

        Entities db = new Entities();
        RptExtention ex = new RptExtention();
        RoleController Role = new RoleController();
        CommonUsed CommonUsed = new CommonUsed();
        string UserRole = "";
        bool IsSingleAccounting =true;
        string AirportPort = "";

        if (Request.IsAuthenticated)
        {
            var id = User.Identity.GetUserId();

            UserRole = Role.GetRole(id);


            var companyId = CommonUsed.getCompanyId(id);
            IsSingleAccounting = CommonUsed.getIsSingleAccounting(companyId);
            AirportPort = CommonUsed.getCompanyName(companyId);

        }
        else {
            Response.Redirect(new Uri(Request.Url, Url.Action("Login", "Account")).ToString());

        }

        var UserId = User.Identity.GetUserId();
        bool HasMouth = db.WorkOns.Any(x => x.UserId == UserId);


    }






