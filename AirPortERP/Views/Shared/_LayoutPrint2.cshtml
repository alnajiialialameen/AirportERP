                padding: 16px;
                margin-bottom: 10px;
            }

                .invoiceGeneral .invoice-General-header .text-word {
                    float: none;
                }

                    .invoiceGeneral .invoice-General-header .text-word h6 {
                        font-size: 18px;
                        font-weight: bolder;
                    }

                .invoiceGeneral .invoice-General-header .image-R {
                    float: right;
                    margin-right: 30px;
                    margin-top: -90px;
                }

                .invoiceGeneral .invoice-General-header .image-L {
                    float: left;
                    margin-top: -10px;
                }

            .invoiceGeneral .invoice-General-Body {
                clear: both;
            }

        .invoiceCupps .invoice-Cupps-Body .h-mr {
