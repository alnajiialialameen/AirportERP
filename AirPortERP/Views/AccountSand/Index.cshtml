            function ConformSand(id) {



                $.get("/AccountSand/GetSandToConfirm", { id: id }, function (result) {
                 
                        swal({
                            title: result.message,
                            text: result.moneytext,
                            icon: "warning",
                            buttons: true,
                            dangerMode: true,
                        })
                         .then((willDelete) => {
                             if (willDelete) {
                                 AddToConfrim(id);
                             }
                         });
                });
            }





            function AddToConfrim(id) {
                $.post("/AccountSand/AddToConfrim", { id: id }, function (res) {
                    if (res) {
                      

