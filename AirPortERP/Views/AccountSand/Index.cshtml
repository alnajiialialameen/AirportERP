                                if ($.inArray(element.CurrencyName, ClassCase) == -1) {
                                    ClassCase.push(element.CurrencyName);
                                    ClassCaseDropDown.append($('<option/>').attr('value', element.CurrencyName).text(element.CurrencyName));
                                }
                            });
