            function CreateOrUpdate() {

                var model = $('#myModal');
                var form = $('form[name="SandFormAdd"]');

                debugger;
                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/AccountSand/CreateOrUpdateBalance", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل العام سند قبض ", "تعديل");
                                model.modal('hide');
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه سند قبض ", "اضافه");
                                model.modal('hide');
                            }
                            else if (res.message != null && res.message === "Used") {
                                toastr.error("العنصر موجود", "اضافه");

                            }

                            else if (res.message != null && res.message === "NoClaim") {
                                swal({
                                    title: "لاتوجد مطالبة مالية",
                                    text: "انت لم تقم باستخراج مطالبة مالية لهذا الشهر حتي يتم سدادها",
                                    icon: "warning",
                                    buttons: true,
                                    dangerMode: true,
                                })
                                //toastr.error("انت لم تقم باستخراج مطالبة مالية لهذا الشهر حتي يتم سدادها", "لاتوجد مطالبة مالية");
                            }

                            else if (res.message != null && res.message === "CurrencyDifference") {
                                swal({
                                    title: "اختلاف في العملة",
                                    text: "تم تحرير فاتورة بعملة و السداد بعملة اخري ",
                                    icon: "warning",
                                    buttons: true,
                                    dangerMode: true,
                                })
                                //toastr.error("انت لم تقم باستخراج مطالبة مالية لهذا الشهر حتي يتم سدادها", "لاتوجد مطالبة مالية");
                            }
                            else if (res.message != null && res.message === "AmountDifference") {

                               
                                swal({
                                    title: "المبلغ غير مطابق ",
                                    text: "  المبلغ الذي تم تحريرة في الفاتورة غير مطابق لمبلغ السداد اضغط تاكيد المبلغ ",
                                    icon: "warning",
                                    buttons: true,
                                    dangerMode: true,
                                })
                          .then((willDelete) => {
                           if (willDelete) {
                           
                               $('.ConfirmAmount').show();
                          }
                         });
                        }


                            
                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                          


                            dataTable.ajax.reload();
                        }

                    })
                }
            }



            

             
