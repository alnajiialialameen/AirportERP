@section scripts{

    <script>
            var dataTable;
            $(document).ready(function () {

                dataTable = $("#dataTable").DataTable({

                    "processing": true,
                    // "serverSide": true,
                    "ajax": {
                        "url": "/CompanyInfoes/GetAllCompanyInfo",
                        "type": "GET",
                        "datatype": "json",

                    },

                    "columns": [
                        { "data": "Id", "autowidth": true },
                          { "data": "NameAr", "autowidth": true },
                             { "data": "NameEn", "autowidth": true },
                             { "data": "Code", "autowidth": true },
                                //{ "data": "Address", "autowidth": true },
                                //   { "data": "Longitude", "autowidth": true },
                                //     { "data": "Latitude", "autowidth": true },



                                          {
                                              "data": "IsSingleAccounting", "width": "50px", "render": function (data) {
                                                  var cssClass;
                                                  if (data === "الفواتير بالرحلات") {
                                                      cssClass = "badge-danger";
                                                  }
                                                  if (data === "الفواتير بين التواريخ") {
                                                      cssClass = "badge-success";
                                                  }
                                                  return '<span class="badge ' + cssClass + '">' + data + '</span>'

                                              }
                                          },


                                           //{

                                           //    "data": "Image", "width": "50px", "render": function (data) {


                                           //        return '<img src="/Uploads/Images/' + data + '" style="width:90px" class="img-thumbnail"/>'

                                           //    }
                                           //},



                                   {
                                       "data": "Id", "width": "50px", "render": function (data) {
                                           return '<div class="btn-group"> <button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#" onclick="getData(' + data + ')">Update</a><button class="dropdown-item"  onclick="Delete(' + data + ')">Delete</button></div></div>'

                                       }
                                   },


                    ], "language":
                                  {
                                      "sProcessing": "جارٍ التحميل...",
                                      "sLengthMenu": "أظهر _MENU_ مدخلات",
                                      "sZeroRecords": "لم يعثر على أية سجلات",
                                      "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                                      "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                                      "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                                      "sInfoPostFix": "",
                                      "sSearch": "ابحث:",
                                      "sUrl": "",
                                      "oPaginate": {
                                          "sFirst": "الأول",
                                          "sPrevious": "السابق",
                                          "sNext": "التالي",
                                          "sLast": "الأخير",
                                      }
                                  }
                });

            });


            function getCompanyInfo(id) {

                $("#AjaxLoader").show()

                $.get("/CompanyInfoes/GetCompanyInfoParial", { id: id }, function (nn) {

                    $("#myModel-content").html(nn);
                    $("#myModal").modal('show');
                    $("#AjaxLoader").hide()

                    $('.select2bs4').select2({
                        theme: 'bootstrap4'
                    })




                    $(function () {
                        $.validator.setDefaults({
                            submitHandler: function () {
                                alert("Form successful submitted!");
                            }
                        });
                        $('#quickForm').validate({
                            rules: {
                                Name: {
                                    required: true,

                                },

                            },
                            messages: {
                                Name: {
                                    required: "الرجاء إدخال نوع الدوره",

                                },

                            },
                            errorElement: 'span',
                            errorPlacement: function (error, element) {
                                error.addClass('invalid-feedback');
                                element.closest('.form-group').append(error);
                            },
                            highlight: function (element, errorClass, validClass) {
                                $(element).addClass('is-invalid');
                            },
                            unhighlight: function (element, errorClass, validClass) {
                                $(element).removeClass('is-invalid');
                            }
                        });
                    });
                })













            }



            function CreateOrUpdate() {

                var model = $('#myModal');
                var form = $('form[name="DepartmentFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/CompanyInfoes/CreateOrUpdateCompanyInfo", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل العام معلومات مطار ", "تعديل");
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه عام معلومات مطار ", "اضافه");
                            }
                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }




            function Delete(id) {

                if (confirm("هل تريد فعلا حذف معلومات المطار ??") == true) {
                    $.get("/CompanyInfoes/Delete", { id: id }, function (res) {
                        if (res) {

                            if (res.message != null && res.message === "Used") {
                                toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                            }

                            if (res.message != null && res.message === "Delete") {
                                toastr.success("تم الحذف نوع معلومات المطار ", "الحذف");
                            }
                            dataTable.ajax.reload();
                        }
                    });
                }
            }

            function PrintData() {

                window.location.href = "/AirLineAgents/PrintData";
            }

            function Edit(id) {

                window.location.href = "/CompanyInfoes/Edit/"+id;
        }




         $(function () {
            // Set default submit handler to call the saveAr function
            $.validator.setDefaults({
                submitHandler: function () {
                    save();
                }
            });

            // Initialize form validation on the form with ID 'form-arrived'
             $('#form-addcompanyInfo').validate({
                rules: {
                     addNameAr: {
                        required: true
                    },
                     addNameEn: {
                        required: true
                    },
                     addCode: {
                        required: true
                    },





                },
                messages: {
                    addNameAr: {
                        required: "Please Enter Arabic Name."
                    },
                    addNameEn: {
                        required: "Please Enter English Name."
                    },
                    addCode: {
                        required: "Please select Code Registration."
                    },



                },
                errorElement: 'span',
                errorClass: 'invalid-feedback', // This class will style the error messages
                errorPlacement: function (error, element) {
                    if (element.hasClass('datetimepicker-input')) {
                        // Special case for datetimepicker inputs
                        error.insertAfter(element.closest('.input-group'));
                    } else {
                        error.insertAfter(element); // Insert error after the input element
                    }
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass('is-invalid');
                }
            });
        });

        function save()
        {


            var ob = {
                "NameAr": $('#addNameAr').val(),
                "NameEn": $('#addNameEn').val(),
                "Code": $('#addCode').val(),
                "IsSingleAccounting": $('#addIsSingleAccounting').prop('checked'),
            };

            // Perform the AJAX request to send the data
            $.ajax({
                url: "@Url.Action("CreateOrUpdateCompanyInfo", "CompanyInfoes")",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                error: function (response) {
                    // Handle error
                },
                success: function (response) {

                    toastr[response.Status](response.Message, response.Title);
                    // $('#add-form').bootstrapValidator('resetForm', true);
                    $('modal-addcompanyInfo').modal('hide');

                    dataTable.ajax.reload();



                }
            });
        };



        function getData(id) {

            $("#modal-editcompanyInfo").modal('show');

            $.ajax({
                type: "GET",
                url: "/CompanyInfoes/GetDataForUpdate/" + id,
                dataType: "json",
                success: function (response) {

                    $('#edId').val(response.Id);
                    $('#edNameAr').val(response.NameAr);
                    $('#edNameEn').val(response.NameEn);
                    $('#edCode').val(response.Code);
                    // checkbox
                    $('#edIsSingleAccounting').prop('checked', response.IsSingleAccounting === true);
                },
                error: function (xhr, status, error) {

                    console.error(error);
                    alert("Error loading data");
                }
            });
        }




        $(function () {
            $.validator.setDefaults({
                submitHandler: function () {
                   editAr();
                }
            });
            $('#form-editcompanyInfo').validate({
                rules: {
                    edNameAr: {
                        required: true
                    },
                    edNameEn: {
                        required: true
                    },
                    edCode: {
                        required: true
                    },





                },
                messages: {
                    edNameAr: {
                        required: "Please Enter Arabic Name."
                    },
                    edNameEn: {
                        required: "Please Enter English Name."
                    },
                    edCode: {
                        required: "Please select Code Registration."
                    },



                },
                errorElement: 'span',
                errorClass: 'invalid-feedback', // This class will style the error messages
                errorPlacement: function (error, element) {
                    if (element.hasClass('datetimepicker-input')) {
                        // Special case for datetimepicker inputs
                        error.insertAfter(element.closest('.input-group'));
                    } else {
                        error.insertAfter(element); // Insert error after the input element
                    }
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass('is-invalid');
                }
            });
        });
        function editAr() {
            var ob = {

                "Id": $('#edId').val(),
                "NameAr": $('#edNameAr').val(),
                "NameEn": $('#edNameEn').val(),
                "Code": $('#edCode').val(),
                "IsSingleAccounting": $('#edIsSingleAccounting').prop('checked'),
            };

            // Perform the AJAX request to send the data
            $.ajax({
                 url: "@Url.Action("CreateOrUpdateCompanyInfo", "CompanyInfoes")",
                type: "POST",
            data: JSON.stringify(ob),
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            error: function (response) {
                // Handle error
            },
            success: function (response) {

                toastr[response.Status](response.Message, response.Title);
                // $('#add-form').bootstrapValidator('resetForm', true);
                $('#modal-editcompanyInfo').modal('hide');

                dataTable.ajax.reload();



            }
        });
        }








    </script>
}
