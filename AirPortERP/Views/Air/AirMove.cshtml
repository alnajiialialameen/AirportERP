        function getDataAr(id) {

            $("#ed-modal-arrived").modal('show');

            // تحميل كل الـ select أولاً
            Promise.all([
                edgetAirline(),
                edgetReg(),
                edgetAirportFrom(),
                edgetTripType()
            ])
            .then(function () {

                // بعد تحميل القوائم الأساسية
                return $.ajax({
                    type: "GET",
                    url: "/Air/GetDataForUpdateAr/" + id,
                    dataType: "json"
                });

            })
            .then(function (response) {

                if (!response) {
                    alert("Something went wrong");
                    return;
                }

                // ====== تعيين Airline أولاً ======
                $('#edAirlineIdAr').val(String(response.AirLineIdAr)).trigger('change');

                $('#edIdAr').val(response.IdAr);

                // ====== الآن حمّل FlightNo بناءً على Airline ======
                return edgetFlightNo().then(function () {

                    $('#edFlightNoAr').val(String(response.FlightNoAr)).trigger('change');

                    return response;
                });

            })
            .then(function (response) {

                // ====== باقي الـ select ======
                //$('#edRegAr').val(String(response.AircraftRegIdAr));
                $('#edRegAr').val(String(response.AircraftRegIdAr)).trigger('change');
                $('#edAirportFromAr').val(String(response.AirportIdFromAr)).trigger('change');
                $('#edTripTypeAr').val(String(response.TripTypeIdAr)).trigger('change');

                // ====== الوقت ======
                $('#edATAArReal').val(response.ATAArShow);

                $('#edATAAr').datetimepicker({
                    use24hours: true,
                    format: 'HH:mm'
                });

                // ====== بقية الحقول ======
                $('#edPOBAr').val(response.POBAr);
                $('#edQBDAr').val(response.QBDAr);
                $('#edNoteAr').val(response.NoteAr);
                $('#edLandingPermissionAr').val(response.LandingPermissionAr);
                $('#edCreatedByAr').val(response.CreatedByAr);
              
                $('#edCreationDateAr').val(response.CreationDateAr);


                // ====== التاريخ ======
                var DateAr = response.DateAr
                    ? moment(response.DateAr, "YYYY-MM-DD").format("DD/MM/YYYY")
                    : "";

                $('input[name="edDateArReal"]').val(DateAr);

                var LandingDateAr = response.LandingDateAr
                    ? moment(response.LandingDateAr, "YYYY-MM-DD").format("DD/MM/YYYY")
                    : "";

                $('input[name="edLandingDateArReal"]').val(LandingDateAr);

            })
            .catch(function (error) {

                console.error(error);
                alert("Error loading data");

            });
        }




