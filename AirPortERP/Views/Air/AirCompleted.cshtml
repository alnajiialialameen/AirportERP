        function getDataCo(id) {

            $("#modal-complete").modal('show');

            // تحميل كل القوائم أولاً
            Promise.all([
                CogetAirline(),
                CogetReg(),
                CogetAirportTo(),
                CogetAirportFrom(),
                CogetTripType()
            ])
            .then(function () {

                // بعد اكتمال تحميل الـ select
                return $.ajax({
                    type: "GET",
                    url: "/Air/GetDataForUpdateCo/" + id,
                    dataType: "json"
                });

            })
            .then(function (response) {

                if (!response) {
                    alert("Something went wrong");
                    return;
                }

                // ====== تعيين Airline أولاً ======
                $('#AirlineIdCo')
                    .val(String(response.AirLineIdCompleted))
                    .trigger('change');

                $('#IdCo').val(response.IdCompleted);

                // ====== تحميل FlightNo بعد Airline ======
                return CogetFlightNo().then(function () {

                    $('#FlightNoCo')
                        .val(String(response.FlightNoCompleted))
                        .trigger('change');

                    return response;
                });

            })
            .then(function (response) {

                // ====== باقي الـ select ======
                $('#RegCo').val(String(response.AircraftRegIdCompleted));
                $('#AirportFromCo').val(String(response.AirportIdFromCompleted));
                $('#AirportToCo').val(String(response.AirportIdToCompleted));
                $('#TripTypeCo').val(String(response.TripTypeIdCompleted));

                // ====== الوقت ======
                $('#ATACoReal').val(response.ATACompletedShow);
                $('#ATDCoReal').val(response.ATDCompletedShow);

                $('#ATACo').datetimepicker({ use24hours: true, format: 'HH:mm' });
                $('#ATDCo').datetimepicker({ use24hours: true, format: 'HH:mm' });

                // ====== بقية الحقول ======
                $('#POBCo').val(response.POBCompleted);
                $('#QBDCo').val(response.QBDCompleted);
                $('#NoteCo').val(response.NoteCompleted);
                $('#LandingPermissionCo').val(response.LandingPermissionCompleted);

                // ====== التواريخ ======
                var DateCo = response.DateCompleted
                    ? moment(response.DateCompleted, "YYYY-MM-DD").format("DD/MM/YYYY")
                    : "";
                $('input[name="DateCoReal"]').val(DateCo);

                var LandingDateCo = response.LandingDateCompleted
                    ? moment(response.LandingDateCompleted, "YYYY-MM-DD").format("DD/MM/YYYY")
                    : "";
                $('input[name="LandingDateCoReal"]').val(LandingDateCo);

                var TakeOffDateCo = response.TakeOffDateCompleted
                    ? moment(response.TakeOffDateCompleted, "YYYY-MM-DD").format("DD/MM/YYYY")
                    : "";
                $('input[name="TakeOffDateCoReal"]').val(TakeOffDateCo);

            })
            .catch(function (error) {
                console.error(error);
                alert("Error loading data");
            });
        }


     



        function editDataCo() {
            
         

            var coDate = $('#DateCoReal').val();
            var formatedcoDate = moment(coDate, 'DD/MM/YYYY').format('YYYY-MM-DD');

            var coLandingDate = $('#LandingDateCoReal').val();
            var formatedLandingDateco = moment(coLandingDate, 'DD/MM/YYYY').format('YYYY-MM-DD');

            var coTakeOffDate = $('#TakeOffDateCoReal').val();
            var formatedTakeOffDateco = moment(coTakeOffDate, 'DD/MM/YYYY').format('YYYY-MM-DD');

  
            var ob = {
                
                "IdCompleted": $('#IdCo').val(),
                "AirLineIdCompleted": $('#AirlineIdCo').val(),
                "FlightNoCompleted": $('#FlightNoCo').val(),
                "AircraftRegIdCompleted": $('#RegCo').val(),
                "AirportIdFromCompleted": $('#AirportFromCo').val(),
                "AirportIdToCompleted": $('#AirportToCo').val(),
                "ATACompleted": $('#ATACoReal').val(),
                "ATDCompleted": $('#ATDCoReal').val(),

                "TripTypeIdCompleted": $('#TripTypeCo').val(),
                "DateCompleted": formatedcoDate,
                "LandingDateCompleted": formatedLandingDateco,
                "TakeOffDateCompleted": formatedTakeOffDateco,
                "NoteCompleted": $('#NoteCo').val(),
                "POBCompleted": $('#POBCo').val(),
                "QBDCompleted": $('#QBDCo').val(),
                "LandingPermissionCompleted": $('#LandingPermissionCo').val()
            };

            // Perform the AJAX request to send the data
            $.ajax({
                url: "@Url.Action("CreateOrUpdateCompleted", "Air")",
                type: "POST",
            data: JSON.stringify(ob),
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            error: function (response) {
                // Handle error
            },
            success: function (response) {
           
                toastr[response.Status](response.Message, response.Title);
                // $('#add-form').bootstrapValidator('resetForm', true);
                $('#modal-complete').modal('hide');
                
                dataTable.ajax.reload();
            
               
            
            }
        });
        }
















               

        function CreateOrUpdateCompleted() {

            $("#AjaxLoader").show()

            var model = $('#modal-complete');
            var form = $('form[name="form-Complete"]');


            form.validate();
            if (!form.valid()) {
                $("#AjaxLoader").hide()
                return;
            } else {
                var data = form.serialize();
                $.post("/Air/CreateOrUpdateCompleted", data, function (res) {
                    if (res) {
                        if (res.message != null && res.message === "Update") {
                            toastr.success("تم تعديل العام Movement ", "تعديل");
                        }
                        else if (res.message != null && res.message === "Add") {
                            toastr.success("تم اضافه عام Movement ", "اضافه");
                        }

                        else if (res.message === "Used") {
                            toastr.error("العنصر موجود", "اضافه");
                        }
                        else if (res.message != null || res.message === "error") {
                            toastr.error("حدث خطا ", "لم يتم الحفظ");
                        }

                        model.modal('hide');
                        $("#AjaxLoader").hide()

                        dataTable.ajax.reload();
                    }

                })
            }
        }









