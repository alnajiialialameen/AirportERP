    *, ::after, ::before {
        box-sizing: border-box;
    }

    .table-hover tbody tr:hover {
        color: #212529;
    }





    .badgeIcon {
        font-size: 70%;
    }

    .badge-color1 {
        color: #111010;
        background-color: #ffffff;
    }

    .badge-color2 {
        color: #111010;
        background-color: #ffffff;
    }

    .badge-color3 {
        color: #111010;
        background-color: aquamarine;
    }

    .imgIcon {
        vertical-align: baseline;
        width: 24px;
    }

    .invalid-feedback {
        color: red;
        font-size: 0.875em;
        margin-top: 0.25rem;
        display: block;
    }
</style>






