@using AirPortERP.Models;


@{
    Entities db = new Entities();
    ViewBag.Title = "Home Page";

}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h5>Ground Handling Report</h5>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Ground Handling Report</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<div class="loader" id="AjaxLoader" style="display:none;">
    <div class="strip-holder">

        <div class="sk-chase">
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
        </div>

    </div>

</div>

<section class="content">

    <link href="~/Temp/dist/css/PagedList.css" rel="stylesheet" />
    <script src="~/Temp/dist/js/sorting.js"></script>
    <style>
        .badge-warning {
            color: #1f2d3d;
            background-color: #ffc107;
        }
    </style>

    <div class="card card-default">
        <!-- /.card-header -->
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Handling Company</label>
                        
                        <select class="form-control select2bs4" id="HandlingCompanyId">
                            <option value="-1">-Select Ground candling company-</option>
                            @foreach (var item in db.HandlingAgentsCompanies.Where(x => x.IsActive == true).ToList())
                            {
                                <option value="@item.Id">@item.NameEn</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>بين الفترة</label>
                        <div class="row">
                            <div class=" col-md-6">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"> From  </i></span>
                                    </div>
                                    @*<input type="text" class="form-control datetime" data-inputmask-alias="datetime" id="DateFrom" data-inputmask-inputformat="dd/mm/yyyy" data-mask>*@
                                    <input type="date" id="DateFrom" />
                                </div>
                            </div>

                            <div class=" col-md-6">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"> To  </i></span>
                                    </div>
                                    <input type="date" id="DateTo" />
                                    @*<input type="text" class="form-control datetime" data-inputmask-alias="datetime" id="DateTo" data-inputmask-inputformat="dd/mm/yyyy" data-mask>*@
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label> بحث</label>

                        <div class="row">
                            <div class=" col-md-4">
                                <button id="btnsearch" onclick="Search()" class="btn btn-primary btn-sm form-control">Search</button>
                            </div>

                            <div class=" col-md-4">
                                <button id="btnall" onclick="PrintData()" class="btn form-control btn-info btn-sm">Print Search </button>
                            </div>

                            <div class=" col-md-4">
                                <button id="btnGraf" onclick="PrintGraf()" class="btn form-control btn-info btn-sm">Print Graf </button>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <div class="card">
        <div class="card-body">

            @Html.Action("GetDataHandlingComp")

        </div>
    </div>

</section>
@section scripts{

  
<script language="javascript" type="text/javascript">

    function Search()
    {
        $("#AjaxLoader").show();

        var HandlingCompanyId = $("#HandlingCompanyId").val();
        var DateFrom = $("#DateFrom").val();
        var DateTo = $("#DateTo").val();

        $.ajax({
            url: '@Url.Action("GetDataHandlingComp", "GroundHandling")',
            data: {
                Get: 1, Search: 1,
                HandlingCompanyId: HandlingCompanyId,
                DateFrom: DateFrom,
                DateTo: DateTo
            },
            type: 'GET',
            cache: false,
            success: function (result) {
                $('#content').html(result);
                $("#AjaxLoader").hide();
            }
        });
    }

    function SearchUpdate()
    {
            $("#AjaxLoader").show()

            var RegId = $("#RegId").val();

            var DDlFlightNo = $("#DDlFlightNo").val();
            var AirPortIdFrom = $("#AirPortIdFrom").val();
            var AirPortIdTo = $("#AirPortIdTo").val();

            var DateFrom = $("#DateFrom").val();

            var DateTo = $("#DateTo").val();
            var FlightTypeId = $("#FlightTypeId").val();

            //var DDlAirLineId = $("#DDlAirLineId").val();


            $.ajax({
                url: '@Url.Action("GetData", "TowerDatas")',
                data: {
                    Get: 1, Search: 1,
                    AirLineId: DDlAirLineId
                    , FlightNo: DDlFlightNo, AirPortIdFrom: AirPortIdFrom
                    , AirPortIdTo: AirPortIdTo
                    , DateFrom: DateFrom,
                    DateTo: DateTo,
                    RegId: RegId,
                    FlightTypeId: FlightTypeId,
                    page:null
                },
                type: 'GET',
                cache: false,
                success: function (result) {
                    $('#content').html(result);
                    $("#AjaxLoader").hide();
                }
            });
    }

        function PrintData() {

            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val(); 
            var HandlingCompanyId = $("#HandlingCompanyId").val();

            console.clear();
            console.log(HandlingCompanyId);

            if (HandlingCompanyId > 0 & DateFrom != '' & DateTo != '') {
                var url = "/AdvencePrintBasic/PrintDataHandlingComp?HandlingCompanyId=" + HandlingCompanyId
                                        + "&&DateFrom=" + DateFrom + "&&DateTo=" + DateTo;

                window.open(url, '_blank').focus();
            } else {
                toastr.error('يجب اختيار التواريخ واسم الشركة', 'خطأ');
            }
        }




        function PrintGraf() {

            var HandlingCompanyId = $("#HandlingCompanyId").val();


            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();


            // var FlightTypeId = $("#FlightTypeId").val();

            var dHandlingCompanyId = $("#HandlingCompanyId");
            if (dHandlingCompanyId.val() == "0") {
                Swal.fire('Select!! Enter Ground Hndling Company')
                $("#AjaxLoader").hide();
                return false;
            } else {
                var url = "/AdvencePrintBasic/PrintDataGHGraf?HandlingCompanyId=" + HandlingCompanyId
                   + "&&DateFrom=" + DateFrom + "&&DateTo=" + DateTo;
                window.open(url, '_blank').focus();


                //window.location.href
                //+ "&&FlightTypeId=" + FlightTypeId;


            }
        }



</script>
}