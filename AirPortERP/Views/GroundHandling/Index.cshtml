@using AirPortERP.Models;

@{ 
    Entities db = new Entities();
}
<style>
    td.details-control {
        /*background: url('../resources/details_open.png') no-repeat center center;*/
        background: url('../../Temp/Image/Close.png') no-repeat center center;
        cursor: pointer;
    }

    tr.details td.details-control {
        /*background: url('../resources/details_close.png') no-repeat center center;*/
        background: url('../../Temp/Image/Open.png')no-repeat center center;
    }

    .Details {
        font-size: 16px;
    }

    .card span {
        font-weight: bold;
        padding: 5px;
    }

    .ml-Custom {
        margin-right: 120px;
    }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h5 class="m-0 text-dark">Ground Handling</h5>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","GroundHandling")">Ground Handling</a></li>
                    <li class="breadcrumb-item active">Ground Handling</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>



<div class="loader" id="AjaxLoader" style="display:none;">
    <div class="strip-holder">
        <div class="strip-1"></div>
            <div class="strip-2"></div>
            <div class="strip-3"></div>

        <div class="sk-chase">
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
        </div>

    </div>

</div>


<section class="content">

    <div class="row">
        <div class="col-md-3">
            @*@Html.ActionLink("Go To Completed", "Completed", null, null, new { href = Request.UrlReferrer, @class = "btn btn-success btn-sm" })*@
            <a href="/GroundHandling/Completed" class="btn btn-success btn-sm">Back To Completed</a>

        </div>
    </div>

    <br />

    <div class="card">
        <div class="card-body">
            <div style="width:100%" class="table-responsive">

                <table id="dataTable" class="table table-bordered table-hover table-sm" style="width:100%;font-size:14px">
                    <thead>
                        <tr>
                            <th>D</th>
                            <th>Id</th>
                            <th>Airline</th>
                            <th>Flight No</th>
                            <th>Reg</th>
                            <th>Type</th>
                            <th>Wt</th>
                            <th>From</th>


                            <th>To</th>
                            <th>Date</th>

                            <th>TripType</th>
                            <th>Created By</th>

                            @*<th>G.H Company</th>
                            <th>G.H Fees</th>*@





                            <th>OP</th>

                        </tr>
                    </thead>

                </table>

            </div>

            <span class="hidden" id="Id"></span>
            <span class="hidden" id="AircraftRegName"></span>
            <span class="hidden" id="MaxTaKeOffWeight"></span>

        </div>
    </div>

    <!-- Model Start -->
    <div id="myModal1" class="modal fade" tabindex="-1" role="dialog" data-backdrop="false">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Handling Agent Comp.</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body ml-5 mr-5">
                    
                    <p>Select the Ground candling company for this trip</p>
                    @{
                        <select class="form-control mb-5" id="HandlingCompanyId">
                            <option value="-1">-Select Ground candling company-</option>
                            @foreach (var item in db.HandlingAgentsCompanies.Where(x => x.IsActive == true).ToList())
                            {
                                <option value="@item.Id">@item.NameEn</option>
                            }
                        </select>
                    }

                </div>
               
                <div class="modal-footer">
                    <button id="btnUpdateHnadilngAgent" onclick="UpdateHandlingComp()" type="button" class="btn btn-success" style="float:left">Save</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!--Model End -->

</section>
@section scripts{

    <script>
        var dataTable;

        function format(d) {
            return '<div class="card Details"><div class="card-body"> <span> <i class="fas fa-plane-departure"></i> Airline: ' + d.AirLineName + '</span><br>   <Span>Landing Date:</Span>  <div class="float-right ml-Custom"><p> Location  <i class="fas fa-map-marker-alt"></i></p><Span>From:</Span><span>' +
                 d.AirportIdFrom + '-' + d.FromArabicCountry + '-' + d.FromArabicName + '</span><br><Span>To:</Span><span>' +
                d.AirportIdTo + '-' + d.ToArabicCountry + '-' + d.ToArabicName +
               '</span> <br></div>   '


                + d.LandingDate + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '<Span>Size:</Span> ' + d.Size + '<br>' +
                '<Span>TakeOff Date:</Span> ' + d.TakeOffDate + ' &nbsp; &nbsp;&nbsp; ' + '  <Span>LandingFees:</Span> ' + d.LandingFees + '<br>' +
                 '<Span>ATA: </Span>' + d.ATA + ' &nbsp; &nbsp; &nbsp;&nbsp' + '  <Span>ParkingFees: </Span>' + d.ParkingFees + '<br>' +
                 '<Span>ATD: </Span>' + d.ATD + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '  <Span> NightOperationFees:</Span> ' + d.NightOperationFees + '<br>' +
                 '<Span>Wt: </Span>' + d.MaxTaKeOffWeight + ' &nbsp;&nbsp; &nbsp;&nbsp ' + ' <Span>NavigationFees:</Span> ' + d.NavigationFees + '<br>' +
                 '<Span>Type:</Span> ' + d.Type + ' &nbsp;&nbsp; &nbsp;&nbsp ' + ' <Span>NoiseFees:<Span> ' + d.NoiseFees + '<br>' +
                 '<Span>REG:</Span> ' + d.AircraftRegName + ' &nbsp;&nbsp; &nbsp;&nbsp ' + ' <Span>SecurityFees: </Span>' + d.SecurityFees + '<br>' +
                 //'<Span>Handling Company:</Span> ' + d.HandlingCompName + ' &nbsp;&nbsp; &nbsp;&nbsp ' + ' <Span>Ground Handling Fees: </Span>' + d.GroundHandlingFees +

                // '<br>  <button class="btn btn-success btn-sm m-2" onclick="getTowerData(' + d.Id + ')">Update</button>' +
                 '<br>  <button class="btn btn-success btn-sm m-2" onclick="Update(' + d.Id + ',\'' + d.AircraftRegName + '\',' + d.MaxTaKeOffWeight + ')">Update</button>' +
                 '<button class="btn btn-info btn-sm m-2" onclick="Detail(' + d.Id
                 + ')">Details</button> <button class="btn btn-danger btn-sm m-2 float-right" onclick="Delete(' + d.Id + ')">Delete</button>' +
                '<br></div></div> ';

        }

        $(document).ready(function () {

            dataTable = $("#dataTable").DataTable({

                "processing": true,
                // "serverSide": true,
                "ajax": {
                    "url": "/GroundHandling/GetAllTowerDatas",
                    "type": "GET",
                    "datatype": "json",

                },
                "columns": [
                      {
                          "class": "details-control",
                          "orderable": false,
                          "data": null,
                          "defaultContent": ""
                      },


                    { "data": "Id", "autowidth": true },
                    { "data": "AirLineCode", "autowidth": true },
                    { "data": "FlightNo", "autowidth": true },
                    { "data": "AircraftRegName", "autowidth": true },

                    { "data": "Type", "autowidth": true },
                    { "data": "MaxTaKeOffWeight", "autowidth": true },

                    { "data": "AirportIdFrom", "autowidth": true },

                    { "data": "AirportIdTo", "autowidth": true },
                    { "data": "Date", "autowidth": true },

                    {
                        "data": "TripType", "width": "50px", "render": function (data) {
                            var cssClass;
                            if (data === "Domestic") {
                                cssClass = "badge-danger";
                            }
                            if (data === "International") {
                                cssClass = "badge-success";
                            }
                            return '<span class="badge ' + cssClass + '">' + data + '</span>'
                        }
                    },

                    { "data": "CreatedBy", "autowidth": true },

                    {
                        "data": "Id", "width": "50px", "render": function (data) {
                            return '<div class="btn-group"> <button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#" onclick="getTowerData(' + data +
                                   ')">Update</a><button class="dropdown-item"  onclick="Detail(' + data + ')">Details</button><button class="dropdown-item" onclick="Delete(' + data + ')">Delete</button>  </div></div>';
                        }
                    },

                ],
                "language": {
                        "sProcessing": "جارٍ التحميل...",
                        "sLengthMenu": "أظهر _MENU_ مدخلات",
                        "sZeroRecords": "لم يعثر على أية سجلات",
                        "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                        "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                        "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                        "sInfoPostFix": "",
                        "sSearch": "ابحث:",
                        "sUrl": "",
                        "oPaginate": {
                            "sFirst": "الأول",
                            "sPrevious": "السابق",
                            "sNext": "التالي",
                            "sLast": "الأخير",
                        }
                    },

                "dom": '<"top"l>rt<"bottom"ip><"clear">',
                "fnInitComplete": function (oSettings, json) {
                    addSearchControl(json);
                }

            });

            var detailRows = [];

            $('#dataTable tbody').on('click', 'tr td.details-control', function () {
                var tr = $(this).closest('tr');
                var row = dataTable.row(tr);
                var idx = $.inArray(tr.attr('Id'), detailRows);

                if (row.child.isShown()) {
                    tr.removeClass('details');
                    row.child.hide();

                    // Remove from the 'open' array
                    detailRows.splice(idx, 1);
                }
                else {
                    tr.addClass('details');
                    row.child(format(row.data())).show();

                    // Add to the 'open' array
                    if (idx === -1) {
                        detailRows.push(tr.attr('Id'));
                    }
                }
            });

            // On each draw, loop over the `detailRows` array and show any child rows
            dt.on('draw', function () {
                $.each(detailRows, function (i, id) {
                    $('#' + id + ' td.details-control').trigger('click');
                });
            });



            function addSearchControl(json) {
                $("#dataTable thead").append($("#dataTable thead tr:first").clone());
                $("#dataTable thead tr:eq(1) th").each(function (index) {
                    /*No Search*/
                    if (index == 0 ||  index == 5 || index == 6 || index == 7 || index == 8 || index == 12) {
                        $(this).replaceWith('<th><input type="hidden" placeholder="None"></input></th>');
                    }
                    /*Search as text field*/
                    if (index == 1 || index == 2 || index == 3 || index == 4 || index == 9 || index == 13) {
                        $(this).replaceWith('<th><input type="text" class="jsonText" placeholder="بحث"></input></th>');
                        var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") input");
                        searchControl.on('keyup', function () {
                            dataTable.column(index).search(searchControl.val()).draw();
                        });
                    }
                    /*Search as combobox*/
                    if (index == 10) {
                        var ClassCaseDropDown = $('<select/>');
                        ClassCaseDropDown.append($('<option/>').attr('value', '').text(' نوع الرحلة'));
                        var ClassCase = [];
                        $(json.data).each(function (index, element) {
                            if ($.inArray(element.TripType, ClassCase) == -1) {
                                ClassCase.push(element.TripType);
                                ClassCaseDropDown.append($('<option/>').attr('value', element.TripType).text(element.TripType));
                            }
                        });
                        $(this).replaceWith('<th>' + $(ClassCaseDropDown).prop('outerHTML') + '</th>');
                        var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") select");
                        searchControl.on('change', function () {
                            dataTable.column(index).search(searchControl.val() == "" ? "" : '^' + searchControl.val() + '$', true, false).draw();
                        });
                    }

                    if (index == 11) {
                        var ClassCaseDropDown = $('<select/>');
                        ClassCaseDropDown.append($('<option/>').attr('value', '').text('By '));
                        var ClassCase = [];
                        $(json.data).each(function (index, element) {
                            if ($.inArray(element.CreatedBy, ClassCase) == -1) {
                                ClassCase.push(element.CreatedBy);
                                ClassCaseDropDown.append($('<option/>').attr('value', element.CreatedBy).text(element.CreatedBy));
                            }
                        });
                        $(this).replaceWith('<th>' + $(ClassCaseDropDown).prop('outerHTML') + '</th>');
                        var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") select");
                        searchControl.on('change', function () {
                            dataTable.column(index).search(searchControl.val() == "" ? "" : '^' + searchControl.val() + '$', true, false).draw();
                        });
                    }

                });
            }

        });

            function Delete(id) {


                swal({
                    title: "هل انت متاكد ",
                    text: " OK تقوم بحذف العنصر! عند الضعط علي",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                 .then((willDelete) => {
                     if (willDelete) {
                         $.get("/GroundHandling/Delete", { id: id }, function (res) {
                             if (res) {
                                 if (res.message != null && res.message === "Delete") {
                                     toastr.success("تم الحذف نوع Movement ", "الحذف");
                                 }
                                 dataTable.ajax.reload();
                             }
                         });
                     }
                 });

            }

            function Detail(id) {

                //$('#myModal1').modal('show');
               window.location.href = "/TowerDatas/Details/" + id;
            }

            function UpdateHandlingComp() {
                //get TowerData Id, HandlingCompId, Aircraft Reg, Aircraft Weight
                var HandlingCompanyId = $('#HandlingCompanyId').val();
                var Id = $('#Id').text();
                var AircraftRegName = $('#AircraftRegName').text();
                var MaxTaKeOffWeight = $('#MaxTaKeOffWeight').text();

                console.clear();
                console.log(Id);
                
                if (HandlingCompanyId > 0) {
                    $.ajax({
                        url: '/GroundHandling/CreateOrUpdate?TowerDataId=' + Id + '&GroundHandlingCompId=' + HandlingCompanyId,
                        type: 'POST',
                        //data: data,
                        dataType: 'json',
                        success: function (data) {
                            toastr.success('Ground Handling Company Added Successfly', 'success');
                            $('#myModal1').modal('hide');
                            $('#HandlingCompanyId').val(-1);

                            dataTable.ajax.reload();
                        },
                        error: function (request, error) {
                            toastr.error('Error, Please Try Agin..!', 'Error');
                        }
                    });
                } else {
                    toastr.error('Error, Please Select a company and Try Agin..!', 'Error');
                }

            }

            function Update(Id, AircraftRegName, MaxTaKeOffWeight) {
                $('#myModal1').modal('show');
                $('#Id').text(Id);
                $('#AircraftRegName').text(AircraftRegName);
                $('#MaxTaKeOffWeight').text(MaxTaKeOffWeight);
            }
    </script>
}
