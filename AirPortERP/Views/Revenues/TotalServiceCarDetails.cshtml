@section scripts{

    <script language="javascript" type="text/javascript">

            $(document).ready(function () {

                $(document).on("click", "#contentPager a[href]", function () {

                    $.ajax({

                        url: $(this).attr("href"),

                        type: 'GET',

                        cache: false,

                        success: function (result) {

                            $('#content').html(result);

                        }

                    });

                    return false;

                });






                $('.datetime').datepicker({
                    dateFormat: "dd/mm/yy",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-60:+0"
                });





            });
          
            function Search() {
            $("#AjaxLoader").show()
                
            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();

            if (DateFrom == null || DateFrom == "" || DateTo == null || DateTo == "")
            {
                Swal.fire("Select!! Enter Date's")
                $("#AjaxLoader").hide();
                return false;
            } else {
                $.ajax({
                    url: '@Url.Action("SearchDataTotalServiceCarDetails", "Revenues")',
                    data: {
                        Get: 1, Search: 1
                        , DateFrom: DateFrom,
                        DateTo: DateTo,
                    },
                    type: 'GET',
                    cache: false,
                    success: function (result) {
                        $('#content').html(result);
                        $("#AjaxLoader").hide();
                    }
                });
            }
        }
       
        function PrintData() {

            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();

            if (DateFrom == null || DateFrom == "" || DateTo == null || DateTo == "") {
                Swal.fire("Select!! Enter Date's")
                $("#AjaxLoader").hide();
                return false;
            } else {
                var url = "/AdvencePrintExtenstion/PrintDataTotalServiceCarDetails?DateFrom=" + DateFrom + "&&DateTo=" + DateTo;
                window.open(url, '_blank').focus();
            }
        }

    </script>

}
