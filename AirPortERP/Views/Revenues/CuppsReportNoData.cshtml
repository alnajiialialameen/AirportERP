    <div class="card">
        <div class="card-body">

            @Html.Action("GetDataCupps")

        </div>
    </div>























</section>
@section scripts{

    <script language="javascript" type="text/javascript">

            $(document).ready(function () {

                $(document).on("click", "#contentPager a[href]", function () {

                    $.ajax({

                        url: $(this).attr("href"),

                        type: 'GET',

                        cache: false,

                        success: function (result) {

                            $('#content').html(result);

                        }

                    });

                    return false;

                });






                $('.datetime').datepicker({
                    dateFormat: "dd/mm/yy",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-60:+0"
                });





            });
          





            function Search() {
                $("#AjaxLoader").show()
                var AirLineId = $("#AirLineId").val();



                var AirPortIdFrom = $("#AirPortIdFrom").val();
                var AirPortIdTo = $("#AirPortIdTo").val();
                var DateFrom = $("#DateFrom").val();
                var DateTo = $("#DateTo").val();
                var FlightTypeId = $("#FlightTypeId").val();

                var ddlFlightType = $("#FlightTypeId");
                var ddlAirLine = $("#AirLineId");
                if (ddlFlightType.val() == "0") {
                    Swal.fire('Select!! Enter FlightType ')
                    $("#AjaxLoader").hide();
                    return false;
                } if (ddlAirLine.val() == "0") {
                    Swal.fire('Select!! Enter AirLine ')
                    $("#AjaxLoader").hide();
                    return false;
                } else {


                    $.ajax({
                        url: '@Url.Action("GetDataCupps", "Revenues")',
                        data: {

                            Get: 1, Search: 1
                            , AirLineId: AirLineId

                            , DateFrom: DateFrom,
                            DateTo: DateTo,
                            FlightTypeId: FlightTypeId


                        },
                        type: 'GET',
                        cache: false,
                        success: function (result) {
                            $('#content').html(result);
                            $("#AjaxLoader").hide();
                        }
                    });
                }
            }

       


      





     /////////////////////////////////////////////////////////////////
        function getTowerData(id) {

            $("#AjaxLoader").show()

            $.get("/TowerDatas/GetAircraftAllParial", { id: id }, function (nn) {

                $("#myModel-content").html(nn);
                $("#myModal").modal('show');
                $("#AjaxLoader").hide()

                //$('.select2bs4').select2({
                //    theme: 'bootstrap4'
                //})

                $('.select2').select2({
                    theme: 'bootstrap4'
                })


                $('#timepicker').datetimepicker({
                    use24hours: true,
                    format: 'HH:mm'
                })






                $('#timepicker1').datetimepicker({
                    use24hours: true,
                    format: 'HH:mm'
                })




                $(function () {
                    $.validator.setDefaults({
                        submitHandler: function () {
                            alert("Form successful submitted!");
                        }
                    });
                    $('#quickForm').validate({
                        rules: {
                            Name: {
                                required: true,

                            },

                        },
                        messages: {
                            Name: {
                                required: "الرجاء إدخال نوع الدوره",

                            },

                        },
                        errorElement: 'span',
                        errorPlacement: function (error, element) {
                            error.addClass('invalid-feedback');
                            element.closest('.form-group').append(error);
                        },
                        highlight: function (element, errorClass, validClass) {
                            $(element).addClass('is-invalid');
                        },
                        unhighlight: function (element, errorClass, validClass) {
                            $(element).removeClass('is-invalid');
                        }
                    });
                });
            })


        }



        function CreateOrUpdate() {

            var model = $('#myModal');
            var form = $('form[name="DepartmentFormAdd"]');


            form.validate();
            if (!form.valid()) {
                return;
            } else {
                var data = form.serialize();
                $.post("/TowerDatas/CreateOrUpdateAirPort", data, function (res) {
                    if (res) {
                        if (res.message != null && res.message === "Update") {
                            toastr.success("تم تعديل العام Movement ", "تعديل");
                        }
                        else if (res.message != null && res.message === "Add") {
                            toastr.success("تم اضافه عام Movement ", "اضافه");
                        }
                        else if (res.message == null || res.message === "error") {
                            toastr.error("حدث خطا ", "لم يتم الحفظ");
                        }
                        model.modal('hide');


                        Search();
                    }

                })
            }
        }

        function Delete(id) {

            if (confirm("هل تريد فعلا حذف Movement ??") == true) {
                $.get("/TowerDatas/Delete", { id: id }, function (res) {
                    if (res) {

                        if (res.message != null && res.message === "Used") {
                            toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                        }

                        if (res.message != null && res.message === "Delete") {
                            toastr.success("تم الحذف نوع Movement ", "الحذف");
                        }
                        Search();
                    }
                });
            }
        }


        $('.select2bs4').select2({
            theme: 'bootstrap4'
        })

       






       


        function PrintData() {

            var AirLineId = $("#AirLineId").val();
          
          
            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();

           
            var FlightTypeId = $("#FlightTypeId").val();
            
            
            var ddlFlightType = $("#FlightTypeId");
            var ddlAirLine = $("#AirLineId");

            if (ddlFlightType.val() == "0" || ddlAirLine.val() == "0") {
                if (ddlFlightType.val() == "0") {
                    Swal.fire('Select!! Enter FlightType ')

                    return false;
                } if (ddlAirLine.val() == "0") {
                    Swal.fire('Select!! Enter AirLine ')

                    return false;
                }
            } else {


             




                var url = "/AdvencePrintExtenstion/PrintDataCuppsNoData?AirLineId=" + AirLineId
                   + "&&DateFrom=" + DateFrom + "&&DateTo=" + DateTo
                + "&&FlightTypeId=" + FlightTypeId;
                window.open(url, '_blank').focus();




            }

        }





        function PrintDataD() {

            var AirLineId = $("#AirLineId").val();


            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();


            var FlightTypeId = $("#FlightTypeId").val();


            var ddlFlightType = $("#FlightTypeId");
            var ddlAirLine = $("#AirLineId");

            if (ddlFlightType.val() == "0" || ddlAirLine.val() == "0") {
                if (ddlFlightType.val() == "0") {
                    Swal.fire('Select!! Enter FlightType ')

                    return false;
                } if (ddlAirLine.val() == "0") {
                    Swal.fire('Select!! Enter AirLine ')

                    return false;
                }
            } else {


                window.location.href = "/Revenues/PrintDataCuppsDistribtion?AirLineId=" + AirLineId
                   + "&&DateFrom=" + DateFrom + "&&DateTo=" + DateTo
                + "&&FlightTypeId=" + FlightTypeId;
            }

        }











    </script>

}
