</section>
@section scripts{

    <script language="javascript" type="text/javascript">

            $(document).ready(function () {

                $(document).on("click", "#contentPager a[href]", function () {

                    $.ajax({

                        url: $(this).attr("href"),

                        type: 'GET',

                        cache: false,

                        success: function (result) {

                            $('#content').html(result);

                        }

                    });

                    return false;

                });






                $('.datetime').datepicker({
                    dateFormat: "dd/mm/yy",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-60:+0"
                });





            });






            function Search() {
                $("#AjaxLoader").show()
              //  var AirLineId = $("#AirLineId").val();



                //var AirPortIdFrom = $("#AirPortIdFrom").val();
                //var AirPortIdTo = $("#AirPortIdTo").val();
                var DateFrom = $("#DateFrom").val();
                var DateTo = $("#DateTo").val();
                var FlightTypeId = $("#FlightTypeId").val();

                var ddlFlightType = $("#FlightTypeId");
                //var ddlAirLine = $("#AirLineId");
                if (ddlFlightType.val() == "0") {
                    Swal.fire('Select!! Enter FlightType ')
                    $("#AjaxLoader").hide();
                    return false;
                } 
                //if (ddlAirLine.val() == "0") {
                //    Swal.fire('Select!! Enter AirLine ')
                //    $("#AjaxLoader").hide();
                //    return false;
           // } 
             else {


                    $.ajax({
                        url: '@Url.Action("GetDataCuppsDistribtion", "Revenues")',
                        data: {

                            Get: 1, Search: 1
                            //, AirLineId: AirLineId

                            , DateFrom: DateFrom,
                            DateTo: DateTo,
                            FlightTypeId: FlightTypeId


                        },
                        type: 'GET',
                        cache: false,
                        success: function (result) {
                            $('#content').html(result);
                            $("#AjaxLoader").hide();
                        }
                    });
                }
            }










     /////////////////////////////////////////////////////////////////
     


     

      













     




        function PrintDataD() {

            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();


            var FlightTypeId = $("#FlightTypeId").val();


            var ddlFlightType = $("#FlightTypeId");
       

            if (ddlFlightType.val() == "0") {
              
                    Swal.fire('Select!! Enter FlightType ')

                    return false;
                 
                } else {


                    window.location.href = "/Revenues/PrintDataCuppsDistribtion?DateFrom=" + DateFrom + "&&DateTo=" + DateTo
                    + "&&FlightTypeId=" + FlightTypeId;
                }

            }
        



        function PrintDataDetail() {

 
            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();


            var FlightTypeId = $("#FlightTypeId").val();


            var ddlFlightType = $("#FlightTypeId");
   
            if (ddlFlightType.val() == "0") {
              
                    Swal.fire('Select!! Enter FlightType ')

                    return false;
               
                } else {


                    window.location.href = "/Revenues/PrintDataCuppsDetails?DateFrom=" + DateFrom + "&&DateTo=" + DateTo
                    + "&&FlightTypeId=" + FlightTypeId;
                }

            }
        






    </script>

}
