@model IEnumerable<AirPortERP.ViewModels.PrintOperationViewModel>

@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint2.cshtml";
}


<style>
    /*////////////////////////////////////////////////////Cupps/////////////////////////////////////////////*/
    .invoiceNy {
        padding: 10px;
        font-family: Arial;
    }

        .invoiceNy .invoice-Ny-header {
            border: 2px solid #808080;
            border-radius: 5px;
            padding: 16px;
            margin-bottom: 10px;
        }

            .invoiceNy .invoice-Ny-header .text-word {
                float: none;
            }

                .invoiceNy .invoice-Ny-header .text-word h6 {
                    font-size: 21px;
                    font-weight: bolder;
                }

            .invoiceNy .invoice-Ny-header .image-R {
                float: right;
                margin-right: 30px;
                margin-top: -90px;
            }

            .invoiceNy .invoice-Ny-header .image-L {
                float: left;
                margin-top: -10px;
            }

        .invoiceNy .invoice-Ny-Body {
            clear: both;
        }

            .invoiceNy .invoice-Ny-Body .h-mr {
                margin-right: 20px;
                font-size: 21px;
            }


        .invoiceNy .invoice-Ny-details th {
            background-color: #ebefef;
        }

        .invoiceNy .invoice-Ny-details table {
            min-width: 1000px;
            text-align: center;
        }


        .invoiceNy .invoice-Ny-details .Diff {
             text-align: right;
             font-size:18px;
             padding:20px;
        }



        .invoiceNy .invoice-Ny-details table, th, td {
            border: 1px solid #282a2c;
            padding: .5rem;
            font-size: 18px;
        }

        .invoiceNy .invoice-Ny-details .NoColor {
            background-color:#ffffff;
            color:#282a2c;
           
        }

        .invoiceNy .invoice-Ny-details .footer {
            background-color: #ebefef;
            font-weight: 600;
        }
</style>








<section class="invoiceNy">


    <div class="invoice-Ny-header">



        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>


        <div class="text-center text-word">
            <h6>Sudan Airports Company .Ltd</h6>
            <h6>General Administration Of Finance Affairs</h6>
            <h6>Revenue Directorate</h6>
        </div>



        <div>
            <img src="~/Temp/Image/WhiteLogo.png" class="image-R" height="100" />
        </div>

    </div>


    <div class="invoice-Ny-Body">
        <h4 class="text-center"><u> كشف حساب</u></h4>


        <div class="arline-header text-right">
            <div class="row">
                <div class="col-md-12">

                    <label class="h-mr">اسم الحساب: @ViewBag.AccName</label>
                    
                    @if (ViewBag.DateFromR != null && ViewBag.DateToR != null) 
                    {
                    <label class="h-mr">من: @ViewBag.DateFromR</label>
                    <label class="h-mr">الي: @ViewBag.DateToR</label>
                    }

                </div>

            </div>
        </div>










    </div>



    <div class="invoice-Ny-details" style="width:100%;margin-bottom:40px;">




        <table class="Ny-table-header table-striped" width="100%">
            <thead>
                <tr class="Gray">
                    <th>الرقم</th>
                    <th>اسم الحساب </th>
                   
                    <th>مدين </th>
                    <th>دائن </th>
                    <th>العملة </th>
                    <th>بيان </th>
                    <th>التاريخ </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
            {
                    <tr>

                        <td>
                            @Html.DisplayFor(modelItem => item.N)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AccountName)
                        </td>
                       
                        <td>
                            <span class="numberFormat">@Html.DisplayFor(modelItem => item.Debit)</span>
                        </td>

                        <td>
                            <span class="numberFormat">@Html.DisplayFor(modelItem => item.Credit)</span>
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.CurrencyName)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Statement)
                        </td>

                        <td>
                           @Html.DisplayFor(modelItem => item.Date)
                        </td>
                    </tr>
                }
                 


            </tbody>
          
                <tr class="text-center">
                    <th colspan="2">اجمالي المبالغ (جنية)</th>
                    <th><span class="numberFormat">@ViewBag.TotalDebitSDG</span> </th>
                    <th><span class="numberFormat">@ViewBag.TotalCreditSDG </span></th>
                    <th colspan="3"> جنية</th>
                </tr>


                <tr class="text-center">
                    <th colspan="2">اجمالي المبالغ (دولار)</th>
                    <th><span class="numberFormat"> @ViewBag.TotalDebitDollar </span></th>
                    <th><span class="numberFormat"> @ViewBag.TotalCreditDollar  </span></th>
                    <th colspan="3"> دولار</th>
                </tr>



              










          


              




        </table>
        <div class="Diff">
         <div>
             الفرق جنية   <span class="numberFormat">@ViewBag.DiffSDG</span>   
         </div> 


            <div>
                الفرق دولار   <span class="numberFormat"> @ViewBag.DiffDollar </span>  
            </div>
         
        </div>



    </div>















</section>

<script src="~/Temp/plugins/jquery/jquery.min.js"></script>

@section scripts{

    <script>



           window.addEventListener("load", window.print());
        // window.location.href = "/AdvancePrint/PrintInvoice"


           $('.numberFormat').each(function () {
               var item = $(this).text();

               var N = round(item, 2);
               /// var N = item.toFixed(2);


               var num = Number(N).toLocaleString();
               $(this).text(num);
           });



           function round(value, exp) {
               if (typeof exp === 'undefined' || +exp === 0)
                   return Math.round(value);

               value = +value;
               exp = +exp;

               if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                   return NaN;

               // Shift
               value = value.toString().split('e');
               value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

               // Shift back
               value = value.toString().split('e');
               return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
           }


    </script>

}