@model PagedList.IPagedList<AirPortERP.Models.AccountOperation>

@using PagedList.Mvc

@{

    Layout = null;

}

<style>
    .re-sort:hover {
      
        color:#2d2cdd;
        text-decoration:double;
      
    }
</style>


<div id="content">
    <div class="table-responsive">
        <table id="testTable" class="table table-bordered table-hover table-sm" style="width:100%;font-size:13px;">



            <tr>

                <th>
                    Id
                </th>
                <th>

                    <div onclick="sortTable()" class="re-sort"><i class="fa fa-sort"></i> <a> Account Name </a></div>
                </th>


                <th>
                    Debit (مدين)
                </th>


                <th>
                    Credit (الدائن)
                </th>
                <th>
                    Currency
                </th>
                <th>
                    Statement (البيان)
                </th>
                <th>
                    Date
                </th>
                
                @*<th>Operation</th>*@

            </tr>

            @foreach (var item in Model)

            {

                <tr>

                    <td>

                        @Html.DisplayFor(modelItem => item.Id)

                    </td>
              
                    <td>
                        @Html.DisplayFor(modelItem => item.AccountTree.AccName)
                    </td>

                    <td>
                     <span class="numberFormat">@Html.DisplayFor(modelItem => item.OperationDebit)</span>  
                    </td>


                    <td>
                    <span class="numberFormat">@Html.DisplayFor(modelItem => item.OperationCredit)</span> 
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Currency.CurrencyName)
                    </td>
                   

                    <td>
                        @Html.DisplayFor(modelItem => item.OperationStatement)
                    </td>
                    <td>
                        @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.OperationDate))
                    </td>

                  
                
                    @*<td>
                        <div class="btn-group"> <button type="button" class="btn btn-primary" data-toggle="dropdown"><i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#"> التدريب داخل الخطة</a></div></div>
                    </td>*@

                </tr>

            }
         


        </table>
      
        <br />

        صفحة  @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) من  @Model.PageCount  (عدد عناصر @ViewBag.ItemCount) 

        <div id="contentPager">

            @Html.PagedListPager(Model, page => Url.Action("GetDataStatement", new { page,
         
           AccId = ViewBag.AccId

          

         
           , Get = 1
           ,Search=2,
         

           DateFrom= ViewBag.DateFrom,
           DateTo=   ViewBag.DateTo,
           

       }))
        </div>
    </div>

   @if (ViewBag.ItemCount > 0)
   {

        @*<div class="col-6">
          

            <div class="table-responsive">
                <table class="table">
                    <tr>
                        <td>Total Debit</td>
                        <td colspan="2">@ViewBag.TotalDebit</td>

                        <td>Total Credit</td>
                        <td colspan="2">@ViewBag.TotalCredit</td>


                    </tr>
                  
                   
                </table>
            </div>
        </div>*@


   }


    <script>



        $('.numberFormat').each(function () {
            var item = $(this).text();

            var N = round(item, 2);
            /// var N = item.toFixed(2);


            var num = Number(N).toLocaleString();
            $(this).text(num);
        });



        function round(value, exp) {
            if (typeof exp === 'undefined' || +exp === 0)
                return Math.round(value);

            value = +value;
            exp = +exp;

            if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                return NaN;

            // Shift
            value = value.toString().split('e');
            value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

            // Shift back
            value = value.toString().split('e');
            return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
        }









    </script>


</div>


