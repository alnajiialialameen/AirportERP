@using AirPortERP.Models;


@{
    Entities db = new Entities();
    ViewBag.Title = "Home Page";

}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h5> Account Statement</h5>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    @*<li class="breadcrumb-item"><a href="#">Home</a></li>*@
                    <li class="breadcrumb-item active"> Account Statement</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<div class="loader" id="AjaxLoader" style="display:none;">
    <div class="strip-holder">
        @*<div class="strip-1"></div>
            <div class="strip-2"></div>
            <div class="strip-3"></div>*@

        <div class="sk-chase">
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
        </div>

    </div>

</div>

<section class="content">













    <link href="~/Temp/dist/css/PagedList.css" rel="stylesheet" />
    <script src="~/Temp/dist/js/sorting.js"></script>
    <style>
        .badge-warning {
            color: #1f2d3d;
            background-color: #ffc107;
        }
    </style>


    <div class="card card-default">
        @*<div class="card-header">
                <h3 class="card-title">Select2 (Bootstrap4 Theme)</h3>

                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                    <button type="button" class="btn btn-tool" data-card-widget="remove"><i class="fas fa-times"></i></button>
                </div>
            </div>*@
        <!-- /.card-header -->
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">


                    <div class="form-group">
                        <label>Account</label>
                        <select class="form-control select2bs4" id="AccId">
                            <option value="0"></option>
                            @foreach (AccountTree d in db.AccountTrees.Where(x => x.AccType == 2).ToList())
                            {
                                <option value="@d.Id">@d.AccName</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="col-md-6">


                    <div class="form-group">
                        <label>بين الفترة</label>

                        <div class="row">
                            <div class=" col-md-6">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"> من  </i></span>
                                    </div>
                                    @*<input type="text" class="form-control datetime" data-inputmask-alias="datetime" id="DateFrom" data-inputmask-inputformat="dd/mm/yyyy" data-mask>*@
                                    <input type="date" id="DateFrom" />
                                </div>

                            </div>

                            <div class=" col-md-6">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"> الي  </i></span>
                                    </div>
                                    <input type="date" id="DateTo" />

                                    @*<input type="text" class="form-control datetime" data-inputmask-alias="datetime" id="DateTo" data-inputmask-inputformat="dd/mm/yyyy" data-mask>*@
                                </div>

                            </div>
                        </div>

                    </div>


                    <div class="form-group">
                        <label> بحث</label>

                        <div class="row">
                            <div class=" col-md-6">
                                <button id="btnsearch" class="btn btn-primary btn-sm form-control">بحث</button>


                            </div>

                            <div class=" col-md-6">
                                <button id="btnall" onclick="PrintData()" class="btn form-control btn-info btn-sm">عرض الكل </button>

                            </div>
                        </div>

                    </div>







                </div>

            </div>

        </div>


    </div>


    <div class="card">
        <div class="card-body">

            @Html.Action("GetDataStatement")

        </div>
    </div>























</section>
@section scripts{

    <script language="javascript" type="text/javascript">

            $(document).ready(function () {

                $(document).on("click", "#contentPager a[href]", function () {

                    $.ajax({

                        url: $(this).attr("href"),

                        type: 'GET',

                        cache: false,

                        success: function (result) {

                            $('#content').html(result);

                        }

                    });

                    return false;

                });






                $('.datetime').datepicker({
                    dateFormat: "dd/mm/yy",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-60:+0"
                });





            });



            $("#btnsearch").click(function () {
                $("#AjaxLoader").show()

                var AccId = $("#AccId").val();

                var DateFrom = $("#DateFrom").val();
                var DateTo = $("#DateTo").val();


                $.ajax({
                    url: '@Url.Action("GetDataStatement", "AccountReport")',
                    data: {

                        AccId: AccId,
                        Get: 1,

                        Search: 1,

                        DateFrom: DateFrom,
                        DateTo: DateTo,
                    },
                    type: 'GET',
                    cache: false,
                    success: function (result) {
                        $('#content').html(result);
                        $("#AjaxLoader").hide();
                    }
                });
            });




        $('.select2bs4').select2({
            theme: 'bootstrap4'
        })


















        function PrintData() {

            //var EmployeeId = $("#EmployeeId").val();
            var AccId = $("#AccId").val();


            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();







            var url = "/AccountReport/PrintStatement?AccId=" + AccId + "&&DateFrom=" + DateFrom + "&&DateTo=" + DateTo;

            window.open(url, '_blank').focus();










        }




      
















    </script>

}
