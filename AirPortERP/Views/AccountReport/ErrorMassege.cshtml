    <!-- Font Awesome Icon -->
    <!-- Custom stlylesheet -->
    <link href="~/Temp/dist/css/style.css" rel="stylesheet" />



</head>

<body>

    <div id="notfound">
        <div class="notfound">
            <div class="notfound-bg">
                <div></div>
                <div></div>
                <div></div>
            </div>
            <h1> @Model.MassegeHeader</h1>
            <h2>@Model.MassegeContent </h2>

            @Html.ActionLink("رجوع للصفحة السابقة", null, null, null, new { href = Request.UrlReferrer })

        </div>
    </div>

