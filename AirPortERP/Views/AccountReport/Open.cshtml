@section scripts{

    <script language="javascript" type="text/javascript">

            $(document).ready(function () {

                $(document).on("click", "#contentPager a[href]", function () {

                    $.ajax({

                        url: $(this).attr("href"),

                        type: 'GET',

                        cache: false,

                        success: function (result) {

                            $('#content').html(result);

                        }

                    });

                    return false;

                });






                $('.datetime').datepicker({
                    dateFormat: "dd/mm/yy",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-60:+0"
                });





            });



            $("#btnsearch").click(function () {
                $("#AjaxLoader").show()

                var AccId = $("#AccId").val();

                var DateFrom = $("#DateFrom").val();
                var DateTo = $("#DateTo").val();


                //var MouthId = $("#MouthId").val();
                //var YearId = $("#YearId").val();
                $.ajax({
                    url: '@Url.Action("GetDataOpen", "AccountReport")',
                    data: {

                        AccId: AccId,
                        Get: 1,

                        Search: 1,

                        DateFrom: DateFrom,
                        DateTo: DateTo,

                        //MouthId: MouthId,
                        //YearId: YearId,
                    },
                    type: 'GET',
                    cache: false,
                    success: function (result) {
                        $('#content').html(result);
                        $("#AjaxLoader").hide();
                    }
                });
            });




        $('.select2bs4').select2({
            theme: 'bootstrap4'
        })


















        function PrintData() {

            //var EmployeeId = $("#EmployeeId").val();
            var AccId = $("#AccId").val();


            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();

          

            var url = "/AccountReport/PrintOpen?AccId=" + AccId + "&&DateFrom=" + DateFrom + "&&DateTo=" + DateTo;

            window.open(url, '_blank').focus();


        }


        function ReSearch() {
            $("#AjaxLoader").show()

            var AccId = $("#AccId").val();

            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();
            //var MouthId = $("#MouthId").val();
            //var YearId = $("#YearId").val();

            $.ajax({
                url: '@Url.Action("GetDataClaim", "AccountReport")',
                data: {

                    AccId: AccId,
                    Get: 1,

                    Search: 1,

                    DateFrom: DateFrom,
                    DateTo: DateTo,

                    //MouthId: MouthId,
                    //YearId: YearId,
                },
                type: 'GET',
                cache: false,
                success: function (result) {
                    $('#content').html(result);
                    $("#AjaxLoader").hide();
                }
            });
        };



















        function ReTranfer(id) {


            swal({
                title: "هل تريد نقل ",
                text: " OK تقوم بنقل العنصر! عند الضعط علي",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
             .then((willDelete) => {
                 if (willDelete) {
                     $.get("/AccountClaim/ReTransfer", { id: id }, function (res) {
                         if (res) {

                             if (res.message != null && res.message === "Add") {
                                 toastr.success("تم نقل المعاملة ", "عملية النقل");
                                 ReSearch();
                             }

                             //if (res.message != null && res.message === "Delete") {
                             //    toastr.error("تم الحذف نوع المطار ", "الحذف");
                             //}
                            // dataTable.ajax.reload();
                         }
                     });
                 }
             });

        }




        $('.numberFormat').each(function () {
            var item = $(this).text();

            var N = round(item, 2);
            /// var N = item.toFixed(2);


            var num = Number(N).toLocaleString();
            $(this).text(num);
        });



        function round(value, exp) {
            if (typeof exp === 'undefined' || +exp === 0)
                return Math.round(value);

            value = +value;
            exp = +exp;

            if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                return NaN;

            // Shift
            value = value.toString().split('e');
            value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

            // Shift back
            value = value.toString().split('e');
            return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
        }
















    </script>

}
