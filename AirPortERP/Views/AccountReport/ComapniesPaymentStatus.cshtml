@model IEnumerable<AirPortERP.ViewModels.GettVM>

@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}

<style>

     /*////////////////////////////////////////////////////Cupps/////////////////////////////////////////////*/
              .invoiceCupps {
            padding:10px;
            font-family:Arial;
        }
       .invoiceCupps .invoice-Cupps-header {
            border:2px solid #808080;
            border-radius:5px;
            padding:16px;
            margin-bottom:10px;
        }
        
        .invoiceCupps .invoice-Cupps-header .text-word {
                  
               float:none;

        }
        .invoiceCupps .invoice-Cupps-header .text-word h6 {
            font-size:21px;
              font-weight:bolder;
        }
               .invoiceCupps .invoice-Cupps-header .image-R {
                    float:right;
                    margin-right:30px;
                     margin-top:-90px;
                   
            }
                .invoiceCupps .invoice-Cupps-header .image-L {
               float:left;
               margin-top:-10px;
                   
            }

            .invoiceCupps .invoice-Cupps-Body {
                clear:both;
            }

             .invoiceCupps .invoice-Cupps-Body .h-mr {
              margin-right:20px;
                font-size:21px;
        }


        .invoiceCupps .invoice-Cupps-details th {
             background-color:#ebefef
        }

        .invoiceCupps .invoice-Cupps-details table {
             min-width:1000px;
             text-align:left;
        }

       .invoiceCupps .invoice-Cupps-details table,th,td {
            border:1px solid #282a2c; 
            padding:.5rem;
            font-size:18px;
        }
        
        .invoiceCupps .invoice-Cupps-details .footer {
            background-color:#ebefef;
            font-weight:600;        
        }

        .invoice-footer {
            margin-top:40px
        }
        .invoice-footer .chief
        {
            display: flex;
            justify-content: space-around;
            margin: 30px 0px;
        }

        .text-center{
            padding: 10px;
        }

</style>

<section class="invoiceCupps">


    <div class="invoice-Cupps-header">



        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>

        <div class="text-center text-word">
            <h6>Sudan Airports Company .Ltd</h6>
            <h6>General Administration Of Finance Affairs</h6>
            <h6>Revenue Directorate</h6>
        </div>

        <div>
            <img src="~/Temp/Image/WhiteLogo.png" class="image-R" height="100" />
        </div>

    </div>

    <div class="invoice-Cupps-Body">
        <h4 class="text-center"><u> AirLines Payment Status</u></h4>
        @*<div class="arline-header">
            <div class="row">
                <div class="col-md-12">
                    <label class="h-mr">Company: @ViewBag.Name</label>
                    <label class="h-mr">From: @ViewBag.DateFrom</label>
                    <label class="h-mr">To: @ViewBag.DateTo</label>
                    <label class="h-mr">ExchangeRate: @ViewBag.ExchangeRate</label>
                </div>
            </div>
        </div>*@
    </div>
    <label>Issue Date: @DateTime.Today.Date</label>
    <div class="text-center invoice-Cupps-details" style="width:100%;margin-bottom:40px;">

        <table class="cupps-table-header">

            <tr>
                <th>
                    N
                </th>

                <th>
                    AirLine Name
                </th>


                <th>
                    Debit
                </th>

                <th>
                    Credit
                </th>
                <th>
                    Balance
                </th>
            </tr>


            <tbody>
                @foreach (var item in Model)
            {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.AirLineName)
                        </td>

                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.Debit)
                        </td>

                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.Credit)
                        </td>

                        <td class="numberFormat">
                            @Html.DisplayFor(modelItem => item.Balance)
                        </td>
                    </tr>
                }

                <tr class="footer">
                    <th colspan="2">  Total : @ViewBag.Count</th>

                    <th class="numberFormat">@ViewBag.SumOfDebit</th>
                    <th class="numberFormat">@ViewBag.SumOfCredit</th>
                    <th class="numberFormat">@ViewBag.SumOfBalance</th>
                </tr>

            </tbody>
        </table>


        <div class="invoice-footer">
            <strong style="float:left;">Total entitlements of Companies : @ViewBag.SumOfBalance    SDG</strong>
           
        </div>


        <div class="invoice-footer" style="clear:both; margin-top:80px;">
           @* @ViewBag.GrandTotalDollarTxt*@


            <div class="chief">
                <div class="Dept">
                    <span>Chief Of Dept</span><br /><br />
                    <span>-------------------------------</span>
                </div>

                <div class="Manager">
                    <span>Directorate Manager</span><br /><br />
                    <span>-------------------------------</span>

                </div>
            </div>
        </div>

    </div>















</section>

<script src="~/Temp/plugins/jquery/jquery.min.js"></script>

@section scripts{

    <script>



           window.addEventListener("load", window.print());
        // window.location.href = "/AdvancePrint/PrintInvoice"


           $('.numberFormat').each(function () {
               var item = $(this).text();

               var N = round(item, 2);
               /// var N = item.toFixed(2);


               var num = Number(N).toLocaleString();
               $(this).text(num);
           });



           function round(value, exp) {
               if (typeof exp === 'undefined' || +exp === 0)
                   return Math.round(value);

               value = +value;
               exp = +exp;

               if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                   return NaN;

               // Shift
               value = value.toString().split('e');
               value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

               // Shift back
               value = value.toString().split('e');
               return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
           }


    </script>

}