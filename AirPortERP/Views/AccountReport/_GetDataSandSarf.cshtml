@model PagedList.IPagedList<AirPortERP.Models.SandDetail>

@using PagedList.Mvc

@{

    Layout = null;

}

<style>
    .re-sort:hover {
      
        color:#2d2cdd;
        text-decoration:double;
      
    }
</style>


<div id="content">
    <div class="table-responsive">
        <table id="testTable" class="table table-bordered table-hover table-sm" style="width:100%;font-size:13px;">



            <tr>

                <th>
                    Id
                </th>
                <th>

                    <div onclick="sortTable()" class="re-sort"><i class="fa fa-sort"></i> <a> Account Name </a></div>
                </th>

                <th>
                    Credit (الدائن)
                </th>
                <th>
                    Currency
                </th>
                @*<th>
                    طريقة الدفع
                </th>*@
                <th>
                    Statement (البيان)
                </th>

                <th>
                    Month
                </th>
                <th>
                    Year
                </th>


                <th>
                    Date
                </th>
                
                @*<th>Operation</th>*@

            </tr>

            @foreach (var item in Model)

            {

                <tr>

                    <td>

                        @Html.DisplayFor(modelItem => item.Id)

                    </td>
              
                    <td>
                        @Html.DisplayFor(modelItem => item.AccountTree.AccName)
                    </td>

                    <td>
                      <span class="numberFormat">@Html.DisplayFor(modelItem => item.Amount)</span>
                    </td>

                   
                    <td>
                        @{ int CurrencyId = Convert.ToInt32(item.CurrencyId);
                            string cssClass;

                            if (CurrencyId == 1)
                            {
                                cssClass = "badge-danger";
                            }
                            else { cssClass = "badge-success"; }

                        }

                        <span class="badge  + @cssClass + ">@item.Currency.CurrencyName</span>
                    </td>
                
                   
                    @*<td>
                        @if (Convert.ToBoolean(item.ISCash)) 
                        {
                            <span>نقدي</span>
                        }
                        else
                        {
                            <span>بشيك</span>
                        }
                    </td>*@

                    <td>
                        @Html.DisplayFor(modelItem => item.Statement)
                    </td>
                   

                  
                    <td>
                        @Html.DisplayFor(modelItem => item.MouthWorkOn.Mouth)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.YearWorkOn.Year)
                    </td>
                
                    <td>
                        @*@Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.SandMain.SandDate))*@

                        @string.Format(
    new System.Globalization.CultureInfo("en-US"),
    "{0:dd/MM/yyyy}",
    item.SandMain.SandDate
)
                    </td>


                    @*<td>
                        <div class="btn-group"> <button type="button" class="btn btn-primary" data-toggle="dropdown"><i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#"> التدريب داخل الخطة</a></div></div>
                    </td>*@

                </tr>

            }
         


        </table>
      
        <br />

        صفحة  @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) من  @Model.PageCount  (عدد عناصر @ViewBag.ItemCount) 

        <div id="contentPager">

            @Html.PagedListPager(Model, page => Url.Action("GetDataSandSarf", new { page,

           AccId = ViewBag.AccId




           , Get = 1
           ,Search=2,


           DateFrom= ViewBag.DateFrom,
           DateTo=   ViewBag.DateTo,

           YearId = ViewBag.YearId,
           MonthId = ViewBag.MonthId,


       }))
        </div>
    </div>

   @if (ViewBag.ItemCount > 0)
   {

        <div class="col-6">
          

            <div class="table-responsive">
                <table class="table">
                    <tr>
                        <td>Total Debit</td>
                        <td colspan="2">@ViewBag.TotalDebit</td>

                        <td>Total Credit</td>
                        <td colspan="2">@ViewBag.TotalCredit</td>


                    </tr>
                  
                   
                </table>
            </div>
        </div>


   }





</div>

<script>

        $('.numberFormat').each(function () {
            var item = $(this).text();

            var N = round(item, 2);
            /// var N = item.toFixed(2);


            var num = Number(N).toLocaleString();
            $(this).text(num);
        });



        function round(value, exp) {
            if (typeof exp === 'undefined' || +exp === 0)
                return Math.round(value);

            value = +value;
            exp = +exp;

            if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                return NaN;

            // Shift
            value = value.toString().split('e');
            value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

            // Shift back
            value = value.toString().split('e');
            return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
        }

</script>

