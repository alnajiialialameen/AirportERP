        function Tranfer(id) {


            swal({
                title: "هل تريد نقل ",
                text: " OK تقوم بنقل العنصر! عند الضعط علي",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        $.get("/AccountClaimSingle/Transfer", { id: id }, function (res) {
                            if (res) {

                                if (res.message != null && res.message === "Add") {
                                    toastr.success("تم نقل المعاملة ", "عملية النقل");
                                    dataTable.ajax.reload();
                                }

                                //if (res.message != null && res.message === "Delete") {
                                //    toastr.error("تم الحذف نوع المطار ", "الحذف");
                                //}

                            }
                        });
                    }
                });

        }




        function Delete(id) {
            swal({
                title: "هل انت متاكد ",
                text: " OK تقوم بحذف العنصر! عند الضعط علي",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        $.get("/AccountClaimSingle/Delete", { id: id }, function (res) {
                            if (res) {

                                if (res.message != null && res.message === "Used") {
                                    toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                                }
                                if (res.message != null && res.message === "SandFound") {
                                    toastr.error(" تم دفع المطالبة المالية ", " الحذف");
                                }
                                if (res.message != null && res.message === "Delete") {
                                    toastr.success("تم الحذف المعاملة ", "الحذف");
                                }
                                dataTable.ajax.reload();
                            }
                        });
                    }
                });

        }






