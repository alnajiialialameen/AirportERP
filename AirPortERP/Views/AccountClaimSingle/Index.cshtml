        function AddClaim() {

            var model = $('#myModalClaim');
            var form = $('form[name="ClaimFormAdd"]');


            form.validate();
            if (!form.valid()) {
                return;
            } else {
                var data = form.serialize();

                $.post("/AccountClaimSingle/CreateOrUpdateClaim", data, function (res) {
                    if (res) {
                        if (res.message != null && res.message === "Update") {
                            toastr.success("تم تعديل مطالبة مالية", "تعديل");
                            var model = $('#myModalClaim');
                            model.modal('hide');

                        }

                        else if (res.message != null && res.message === "Add") {
                            toastr.success("تم اضافه مطالبة مالية ", "اضافه");
                            var model = $('#myModalClaim');
                            model.modal('hide');
                        }

                        else if (res.message != null && res.message === "InvaildStartDate") {
                            toastr.error("التاريخ يجب ان يبدا من يوم 1 ", "اضافه");

                        }

                        else if (res.message != null && res.message === "InvaildEndDate") {
                            toastr.error("التاريخ النهاية غير صحيح  ", "اضافه");

                        }
                        else if (res.message != null && res.message === "ExchangeRateNotFound") {
                            toastr.error(" يجب ادخال سعر الصرف يومي  ", "لايوجد سعر صرف لهذا اليوم  ");

                        }
                        


                        else if (res.message != null && res.message === "Used") {
                            toastr.error("يوجد مطالبة مالية لنفس الشهر  ", "اضافه");

                        }


                        else if (res.message != null && res.message === "InvaildDate") {
                            toastr.error("لايمكن المطالبة لشهرين  ", "اضافه");

                        }

                        else if (res.message != null && res.message === "InvaildDateYear") {
                            toastr.error("لايمكن المطالبة لسنتين مختلفتين  ", "اضافه");

                        }


                        else if (res.message == null || res.message === "error") {
                            toastr.error("حدث خطا ", "لم يتم الحفظ");
                        }
                        //   model.modal('hide');
                        //  $("#myModalS").modal('show');

                        //GetSearch();
                        dataTable.ajax.reload();
                        //dataTableS.ajax.reload();


                    }

                })
            }
        }

