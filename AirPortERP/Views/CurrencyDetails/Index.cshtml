@section scripts{

    <script>


        // تعريف validation مخصص للتاريخ
        $.validator.addMethod("dateDMY", function (value, element) {

            if (this.optional(element)) return true;

            return /^(0[1-9]|[12][0-9]|3[01])\/(0[1-9]|1[0-2])\/\d{4}$/.test(value);

        }, "Invalid date format");













            var dataTable;
            $(document).ready(function () {

                dataTable = $("#dataTable").DataTable({

                    "processing": true,
                    // "serverSide": true,
                    "ajax": {
                        "url": "/CurrencyDetails/GetAllCurrencyDetails",
                        "type": "GET",
                        "datatype": "json",

                    },
                    "columns": [
                        { "data": "Id", "autowidth": true },
                        /*{ "data": "Day", "autowidth": true },*/
                        {
                            "data": "Day", "width": "50px", "render": function (data) {
                                var cssClass;
                                if (data === "غير محدد") {
                                    cssClass = "badge-danger";
                                } else { cssClass = "badge-success"; }
                               
                                return '<span class="badge ' + cssClass + '">' + data + '</span>'

                            }
                        },


                          { "data": "CurrencyName", "autowidth": true },
                           { "data": "Month", "autowidth": true },
                             { "data": "Year", "autowidth": true },
                             { "data": "ExchangeRate", "autowidth": true },


                                   {
                                       "data": "Id", "width": "50px", "render": function (data) {
                                           return '<div class="btn-group"> <button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#" onclick="getCurrencyDetail(' + data + ')">Update</a><button class="dropdown-item"  onclick="Delete(' + data + ')">Delete</button></div></div>'

                                       }
                                   },


                    ], "language":
                                  {
                                      "sProcessing": "جارٍ التحميل...",
                                      "sLengthMenu": "أظهر _MENU_ مدخلات",
                                      "sZeroRecords": "لم يعثر على أية سجلات",
                                      "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                                      "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                                      "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                                      "sInfoPostFix": "",
                                      "sSearch": "ابحث:",
                                      "sUrl": "",
                                      "oPaginate": {
                                          "sFirst": "الأول",
                                          "sPrevious": "السابق",
                                          "sNext": "التالي",
                                          "sLast": "الأخير",
                                      }
                                  }
                });

            });


            function getCurrencyDetail(id) {

                $("#AjaxLoader").show()


              
                $.get("/CurrencyDetails/GetCurrencyDetailParial", { id: id }, function (nn) {

                    $("#myModel-content").html(nn);
                    $("#myModal").modal('show');
                    $("#AjaxLoader").hide()

                    $('.select2bs4').select2({
                        theme: 'bootstrap4'
                    })


                    $('#date').datetimepicker({
                        format: 'DD/MM/YYYY'
                    });


                    $(function () {
                        $.validator.setDefaults({
                            submitHandler: function () {
                                alert("Form successful submitted!");
                            }
                        });
                        $('#currencyDetailDailyFormAdd').validate({
                            rules: {
                                Date: {
                                    required: true,
                                    dateDMY: true   // 👈 أضفناها هنا
                                },
                                ExchangeRateAgainstPrimaryCurrency: {
                                    required: true,
                                },
                                //Code: {
                                //    required: true,
                                //},
                                //CountryId: {
                                //    required: true,
                                //},

                            },
                            messages: {

                                Date: {
                                    required: "Please in inter Date",
                                    dateDMY: "Format must be like 09/02/2026"

                                },
                                ExchangeRateAgainstPrimaryCurrency: {
                                    required: "Please in inter ExchangeRate Against Primary Currency",

                                },
                                //Code: {
                                //    required: "Please in inter Code",

                                //},
                                //CountryId: {
                                //    required: "Please in inter CountryId",

                                //},

                            },
                            errorElement: 'span',
                            errorPlacement: function (error, element) {
                                error.addClass('invalid-feedback');
                                element.closest('.form-group').append(error);
                            },
                            highlight: function (element, errorClass, validClass) {
                                $(element).addClass('is-invalid');
                            },
                            unhighlight: function (element, errorClass, validClass) {
                                $(element).removeClass('is-invalid');
                            }
                        });
                    });
                })













            }



            function CreateOrUpdate() {

                var model = $('#myModal');
                var form = $('form[name="currencyDetailDailyFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;

                } else {


                    // ✅ تحويل التاريخ باستخدام moment
                    var currencyDate = $('#date').val();

                    var formattedDate = moment(currencyDate, "DD/MM/YYYY").format("YYYY-MM-DD");
                    console.log(formattedDate);
                    $('#date').val(formattedDate);
                        

                    var data = form.serialize();
                    $.post("/CurrencyDetails/CreateOrUpdateCurrencyDetailDaily", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل العمله  ", "تعديل");
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه  العمله ", "اضافه");
                            }
                            else if (res.message != null && res.message === "Used") {
                                toastr.error("العنصر موجود", "اضافه");
                            }

                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }



            function Delete(id) {


                swal({
                    title: "هل انت متاكد ",
                    text: " OK تقوم بحذف العنصر! عند الضعط علي",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                 .then((willDelete) => {
                     if (willDelete) {
                         $.get("/CurrencyDetails/Delete", { id: id }, function (res) {
                             if (res) {

                                 if (res.message != null && res.message === "Used") {
                                     toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                                 }

                                 if (res.message != null && res.message === "Delete") {
                                     toastr.success("تم الحذف نوع المطار ", "الحذف");
                                 }
                                 dataTable.ajax.reload();
                             }
                         });
                     }
                 });

            }










            function PrintData() {

                window.location.href = "/AirPorts/PrintData?";
            }



    </script>
}
