@section scripts{

    <script>

        //$(document).ready(function () {
        //    $('.select2bs4').select2({
        //        theme: 'bootstrap4'
        //    })

        //})










        var dataTable;


        function format(d) {

            if (d.Role == "Account-Admin" || d.Role == "Super-Admin") {

                return '<div class="card Details "><div class="card-body"> <span> <i class="fas fa-user"></i> Account Name: ' + d.AccName + '</span><br>   <Span> Account Number    :</Span>  <div class="float-right ml-Custom"><p>   الارصدة الافتتاحية   <i class="fas fa-map-marker-alt"></i></p><Span> ' + d.Date + ' </Span><span>'
                     + '</div>'



                     + d.AccountNumber + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '<br>' +

                      '<Span>  Debit :</Span> ' + d.Debit + '<br>' +
                    '<Span>  Credit :</Span> ' + d.Credit + '<br>' +
                      '<Span>  Date :</Span> ' + d.Date + '<br>' +



                     '<br><button class="btn btn-success btn-sm m-2" onclick="ReTranfer(' + d.Id + ')"> استرجاع</button><button class="btn btn-success btn-sm m-2" onclick="getOpen(' + d.Id + ')"> تعديل المعاملة </button> <button class="btn btn-info btn-sm m-2" onclick="PrintConstraint(' + d.Id
                     + ')">عرض القيد </button>   <button class="btn btn-danger btn-sm m-2 float-right" onclick="Delete(' + d.Id + ')">حذف</button>' +
                    '<br></div></div>';
            } else
            {
                return '<div class="card Details confirm"><div class="card-body"> <span> <i class="fas fa-user"></i> Account Name: ' + d.AccName + '</span><br>   <Span> Account Number    :</Span>  <div class="float-right ml-Custom"><p>   الارصدة الافتتاحية   <i class="fas fa-map-marker-alt"></i></p><Span> ' + d.Date + ' </Span><span>'
                       + '</div>'


                 + d.AccountNumber + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '<br>' +

                      '<Span>  Debit :</Span> ' + d.Debit + '<br>' +
                    '<Span>  Credit :</Span> ' + d.Credit + '<br>' +
                      '<Span>  Date :</Span> ' + d.Date + '<br>' +


                   '<br> <button class="btn btn-info btn-sm m-2" onclick="PrintConstraint(' + d.Id
                     + ')">عرض القيد </button>' +
                    '<br></div></div>';
            }
        }



            $(document).ready(function () {

                dataTable = $("#dataTable").DataTable({

                    "processing": true,
                    // "serverSide": true,
                    "ajax": {
                        "url": "/AccountOpen/GetAllOpenAccTransfer",
                        "type": "GET",
                        "datatype": "json",

                    },
                    "columns": [
                         {
                             "class": "details-control",
                             "orderable": false,
                             "data": null,
                             "defaultContent": ""
                         },
                       { "data": "Id", "autowidth": true },
                          { "data": "AccId", "autowidth": true },
                           { "data": "AccName", "autowidth": true },

                             { "data": "Debit", "autowidth": true },
                              { "data": "Credit", "autowidth": true },
                              
                                { "data": "CurrencyName", "autowidth": true },
                               { "data": "Statement", "autowidth": true },
                                 { "data": "Date", "autowidth": true },
                                   //{
                                   //    "data": "Id", "width": "50px", "render": function (data) {
                                   //        return '<div class="btn-group"> <button type="button" class="btn" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#" onclick="getSand(' + data + ')">Update</a><button class="dropdown-item"  onclick="Delete(' + data + ')">Delete</button></div></div>'

                                   //    }
                                   //},


                    ], "language":
                                  {
                                      "sProcessing": "جارٍ التحميل...",
                                      "sLengthMenu": "أظهر _MENU_ مدخلات",
                                      "sZeroRecords": "لم يعثر على أية سجلات",
                                      "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                                      "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                                      "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                                      "sInfoPostFix": "",
                                      "sSearch": "ابحث:",
                                      "sUrl": "",
                                      "oPaginate": {
                                          "sFirst": "الأول",
                                          "sPrevious": "السابق",
                                          "sNext": "التالي",
                                          "sLast": "الأخير",
                                      }
                                  },

                    "dom": '<"top"l>rt<"bottom"ip><"clear">',
                    "fnInitComplete": function (oSettings, json) {
                        addSearchControl(json);
                    }
                });




                var detailRows = [];

                $('#dataTable tbody').on('click', 'tr td.details-control', function () {
                    var tr = $(this).closest('tr');
                    var row = dataTable.row(tr);
                    var idx = $.inArray(tr.attr('Id'), detailRows);

                    if (row.child.isShown()) {
                        tr.removeClass('details');
                        row.child.hide();

                        // Remove from the 'open' array
                        detailRows.splice(idx, 1);
                    }
                    else {
                        tr.addClass('details');
                        row.child(format(row.data())).show();

                        // Add to the 'open' array
                        if (idx === -1) {
                            detailRows.push(tr.attr('Id'));
                        }
                    }
                });

                // On each draw, loop over the `detailRows` array and show any child rows
                dt.on('draw', function () {
                    $.each(detailRows, function (i, id) {
                        $('#' + id + ' td.details-control').trigger('click');
                    });
                });


                function addSearchControl(json) {
                    $("#dataTable thead").append($("#dataTable thead tr:first").clone());
                    $("#dataTable thead tr:eq(1) th").each(function (index) {
                        /*No Search*/
                        if (index == 0 || index == 1 || index == 2 || index == 4 || index == 5 || index == 7) {
                            $(this).replaceWith('<th><input type="hidden" placeholder="None"></input></th>');
                        }
                        /*Search as text field*/
                        if (index == 8) {
                            $(this).replaceWith('<th><input type="text" class="jsonText" placeholder="بحث"></input></th>');
                            var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") input");
                            searchControl.on('keyup', function () {
                                dataTable.column(index).search(searchControl.val()).draw();
                            });
                        }
                        /*Search as combobox*/


                        if (index == 3) {
                            var ClassCaseDropDown = $('<select/>');
                            ClassCaseDropDown.append($('<option/>').attr('value', '').text('الحساب'));
                            var ClassCase = [];
                            $(json.data).each(function (index, element) {
                                if ($.inArray(element.AccName, ClassCase) == -1) {
                                    ClassCase.push(element.AccName);
                                    ClassCaseDropDown.append($('<option/>').attr('value', element.AccName).text(element.AccName));
                                }
                            });
                            $(this).replaceWith('<th>' + $(ClassCaseDropDown).prop('outerHTML') + '</th>');
                            var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") select");
                            searchControl.on('change', function () {
                                dataTable.column(index).search(searchControl.val() == "" ? "" : '^' + searchControl.val() + '$', true, false).draw();
                            });
                        }







                        if (index == 6) {
                            var ClassCaseDropDown = $('<select/>');
                            ClassCaseDropDown.append($('<option/>').attr('value', '').text('العملة'));
                            var ClassCase = [];
                            $(json.data).each(function (index, element) {
                                if ($.inArray(element.CurrencyName, ClassCase) == -1) {
                                    ClassCase.push(element.CurrencyName);
                                    ClassCaseDropDown.append($('<option/>').attr('value', element.CurrencyName).text(element.CurrencyName));
                                }
                            });
                            $(this).replaceWith('<th>' + $(ClassCaseDropDown).prop('outerHTML') + '</th>');
                            var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") select");
                            searchControl.on('change', function () {
                                dataTable.column(index).search(searchControl.val() == "" ? "" : '^' + searchControl.val() + '$', true, false).draw();
                            });
                        }




                    });
                }













            });



            function getOpen(id) {

                $("#AjaxLoader").show()

                $.get("/AccountOpen/OpenParial", { id: id }, function (nn) {

                    $("#myModel-content").html(nn);
                    $("#myModal").modal('show');
                    $("#AjaxLoader").hide()

                    $('.select2bs4').select2({
                        theme: 'bootstrap4'
                    })




                    $(function () {
                        $.validator.setDefaults({
                            submitHandler: function () {
                                alert("Form successful submitted!");
                            }
                        });
                        $('#quickForm').validate({
                            rules: {
                                NameAr: {
                                    required: true,
                                },
                                NameEn: {
                                    required: true,
                                },
                                Code: {
                                    required: true,
                                },
                                CountryId: {
                                    required: true,
                                },

                            },
                            messages: {

                                NameAr: {
                                    required: "Please in inter arabic Name",

                                },
                                NameEn: {
                                    required: "Please in inter English Name",

                                },
                                Code: {
                                    required: "Please in inter Code",

                                },
                                CountryId: {
                                    required: "Please in inter CountryId",

                                },

                            },
                            errorElement: 'span',
                            errorPlacement: function (error, element) {
                                error.addClass('invalid-feedback');
                                element.closest('.form-group').append(error);
                            },
                            highlight: function (element, errorClass, validClass) {
                                $(element).addClass('is-invalid');
                            },
                            unhighlight: function (element, errorClass, validClass) {
                                $(element).removeClass('is-invalid');
                            }
                        });
                    });
                })













            }



            function CreateOrUpdate() {

                var model = $('#myModal');
                var form = $('form[name="OpenBalanceFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/AccountOpen/CreateOrUpdateBalance", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل العام المطار ", "تعديل");
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه عام مطار ", "اضافه");
                            }
                            else if (res.message != null && res.message === "Used") {
                                toastr.error("العنصر موجود", "اضافه");
                            }

                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }







            function ConformOpen(id) {



                $.get("/AccountOpen/GetOpenToConfirm", { id: id }, function (result) {
                        swal({
                            title: result.message,
                            text: result.moneytext,
                            icon: "warning",
                            buttons: true,
                            dangerMode: true,
                        })
                         .then((willDelete) => {
                             if (willDelete) {
                                 AddToConfrim(id);
                             }
                    });
                });
            }
            function AddToConfrim(id) {
                $.post("/AccountOpen/AddToConfrim", { id: id }, function (res) {
                    if (res) {

                         if (res.message != null && res.message === "Add") {
                            toastr.success("تم تاكيد المعاملة ", "اضافه");
                        }

                        else if (res.message == null || res.message === "error") {
                            toastr.error("حدث خطا ", "لم يتم الحفظ");
                        }

                         //var model = $('#myModalClaim');
                         //model.modal('hide');
                        dataTable.ajax.reload();

                    }

                })

            }




            function Delete(id) {


                swal({
                    title: "هل انت متاكد ",
                    text: " OK تقوم بحذف العنصر! عند الضعط علي",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                 .then((willDelete) => {
                     if (willDelete) {
                         $.get("/AccountOpen/Delete", { id: id }, function (res) {
                             if (res) {

                                 if (res.message != null && res.message === "Used") {
                                     toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                                 }

                                 if (res.message != null && res.message === "Delete") {
                                     toastr.success("تم الحذف المعاملة ", "الحذف");
                                 }
                                 dataTable.ajax.reload();
                             }
                         });
                     }
                 });

            }



            function ReTranfer(id) {
                swal({
                    title: "هل تريد نقل ",
                    text: " OK تقوم استرجاع العنصر! عند الضعط علي",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                 .then((willDelete) => {
                     if (willDelete) {
                         $.get("/AccountOpen/ReTransfer", { id: id }, function (res) {
                             if (res) {

                                 if (res.message != null && res.message === "Add") {
                                     toastr.success("تم نقل المعاملة ", "عملية النقل");
                                 }

                                 //if (res.message != null && res.message === "Delete") {
                                 //    toastr.error("تم الحذف نوع المطار ", "الحذف");
                                 //}
                                 dataTable.ajax.reload();
                             }
                         });
                     }
                 });

            }





            function PrintConstraint(id) {
                var url = '/AccountReport/PrintOpenConstraint/' + id;
                window.open(url, '_blank').focus();
            }

            function PrintDataGraf(id) {
                var url = '/AccountReport/PrintDataGraf/' + id;
                window.open(url, '_blank').focus();
            }


            function getShow() {

                window.location.href = "/AccountOpen/Index";
            }


    </script>
}
