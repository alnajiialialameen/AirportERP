@using AirPortERP.Models;


@{
    Entities db = new Entities();
    ViewBag.Title = "Home Page";

}


<!-- //////////////////////////////////////////////////////////////////////////////////////////////////////// -->
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="myModel-content">

            <!-- Model content -->

            <div class="modal-footer justify-content-between">
                <button class="btn btn-primary btn-xs">Save Change</button>
                <button class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-/////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->












<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h5> Ny And Cupps Report</h5>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    @*<li class="breadcrumb-item"><a href="#">Home</a></li>*@
                    <li class="breadcrumb-item active"> And Cupps Report</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<div class="loader" id="AjaxLoader" style="display:none;">
    <div class="strip-holder">
        @*<div class="strip-1"></div>
            <div class="strip-2"></div>
            <div class="strip-3"></div>*@

        <div class="sk-chase">
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
        </div>

    </div>

</div>

<section class="content">













    <link href="~/Temp/dist/css/PagedList.css" rel="stylesheet" />
    <script src="~/Temp/dist/js/sorting.js"></script>
    <style>
        .badge-warning {
            color: #1f2d3d;
            background-color: #ffc107;
        }
    </style>

    <div class="card card-default">
        @*<div class="card-header">
                <h3 class="card-title">Select2 (Bootstrap4 Theme)</h3>

                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                    <button type="button" class="btn btn-tool" data-card-widget="remove"><i class="fas fa-times"></i></button>
                </div>
            </div>*@
        <!-- /.card-header -->
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">






                    <div class="form-group">
                        <label>Flight Type</label>
                        <select class="form-control" id="FlightTypeId">
                            <option value="0"></option>
                            <option value="1">InterNational</option>
                            <option value="2">Domestic</option>
                        </select>
                    </div>





                    <div class="form-group">
                        <label>  AirLine</label>
                        <select class="form-control select2bs4" id="AirLineId">
                            <option value="0"></option>
                            @foreach (AirLine AirLine in db.AirLines.OrderBy(x => x.Id).ToList())
                            {
                                <option value="@AirLine.Id">@AirLine.Name</option>
                            }
                        </select>
                    </div>












                </div>

                <div class="col-md-6">











                    @*<div class="form-group">
                            <label>داخل/خارج الخطة</label>
                            <select class="form-control" id="IsInPlan">
                                <option value="0"></option>
                                <option value="1">داخل الخطة</option>
                                <option value="2">خارج الخطة</option>
                            </select>
                        </div>*@


                    <div class="form-group">
                        <label>بين الفترة</label>

                        <div class="row">
                            <div class=" col-md-6">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"> From  </i></span>
                                    </div>
                                    @*<input type="text" class="form-control datetime" data-inputmask-alias="datetime" id="DateFrom" data-inputmask-inputformat="dd/mm/yyyy" data-mask>*@
                                    <input type="date" id="DateFrom" />
                                </div>

                            </div>

                            <div class=" col-md-6">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"> To  </i></span>
                                    </div>
                                    <input type="date" id="DateTo" />

                                    @*<input type="text" class="form-control datetime" data-inputmask-alias="datetime" id="DateTo" data-inputmask-inputformat="dd/mm/yyyy" data-mask>*@
                                </div>

                            </div>
                        </div>

                    </div>


                    <div class="form-group">
                        <label> بحث</label>

                        <div class="row">
                            <div class=" col-md-6">
                                <button id="btnsearch" onclick="Search()" class="btn btn-primary btn-sm form-control">بحث</button>


                            </div>

                            @*<div class=" col-md-6">
                                <button id="btnall" onclick="PrintData()" class="btn form-control btn-info btn-sm">Print Search </button>

                            </div>*@
                        </div>

                    </div>







                </div>

            </div>

        </div>


    </div>

    <div class="card">
        <div class="card-body">

            @Html.Action("GetDataNyAndCupps")

        </div>
    </div>























</section>
@section scripts{

    <script language="javascript" type="text/javascript">

            $(document).ready(function () {

                $(document).on("click", "#contentPager a[href]", function () {

                    $.ajax({

                        url: $(this).attr("href"),

                        type: 'GET',

                        cache: false,

                        success: function (result) {

                            $('#content').html(result);

                        }

                    });

                    return false;

                });






                $('.datetime').datepicker({
                    dateFormat: "dd/mm/yy",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-60:+0"
                });





            });






            function Search() {
                $("#AjaxLoader").show()
                var AirLineId = $("#AirLineId").val();
                var AirPortIdFrom = $("#AirPortIdFrom").val();
                var AirPortIdTo = $("#AirPortIdTo").val();
                var DateFrom = $("#DateFrom").val();
                var DateTo = $("#DateTo").val();
                var FlightTypeId = $("#FlightTypeId").val();

              

                    $.ajax({
                        url: '@Url.Action("GetDataNyAndCupps", "RevenueExtenstion")',
                        data: {

                            Get: 1, Search: 1
                            , AirLineId: AirLineId

                            , DateFrom: DateFrom,
                            DateTo: DateTo,
                            FlightTypeId: FlightTypeId


                        },
                        type: 'GET',
                        cache: false,
                        success: function (result) {
                            $('#content').html(result);
                            $("#AjaxLoader").hide();
                        }
                    });
                }
            










     /////////////////////////////////////////////////////////////////





        $('.select2bs4').select2({
            theme: 'bootstrap4'
        })




        function GetNyAndCuppsfees(id) {

            $("#AjaxLoader").show()

            $.get("/RevenueExtenstion/GetNyAndCuppsfeesParial", { id: id }, function (nn) {

                $("#myModel-content").html(nn);
                $("#myModal").modal('show');
                $("#AjaxLoader").hide()

                $('.select2bs4').select2({
                    theme: 'bootstrap4'
                })


                $(function () {
                    $.validator.setDefaults({
                        submitHandler: function () {
                            alert("Form successful submitted!");
                        }
                    });
                    $('#quickForm').validate({
                        rules: {
                            DISEMB: {
                                required: true,
                                digits: true,
                                maxlength: 14,
                            },
                            DisEmbInft: {
                                required: true,
                                digits: true,
                                maxlength: 14,
                            },
                            TRNY: {
                                required: true,
                                digits: true,
                                maxlength: 14,
                            },
                            TRNYCUPPS: {
                                required: true,
                                digits: true,
                                maxlength: 14,
                            },

                        },
                        messages: {
                            DISEMB: {
                                required: "Please Enter Number Of DISEMB",
                                digits: "Please inter Number Only ",
                                maxlength: "DISEMB must be at max 14 ",

                            },
                            DisEmbInft: {
                                required: "Please Enter Number Of DisEmbInft",
                                digits: "Please inter Number Only ",
                                maxlength: "DisEmbInft must be at max 14 ",

                            },

                            TRNY: {
                                required: "Please Enter Number Of TRNY",
                                digits: "Please inter Number Only ",
                                maxlength: "TRNY must be at max 14 ",

                            },
                            TRNYCUPPS: {
                                required: "Please Enter Number Of TRNYCUPPS",
                                digits: "Please inter Number Only ",
                                maxlength: "TRNYCUPPS must be at max 14 ",

                            },


                        },

                        errorElement: 'span',
                        errorPlacement: function (error, element) {
                            error.addClass('invalid-feedback');
                            element.closest('.form-group').append(error);
                        },
                        highlight: function (element, errorClass, validClass) {
                            $(element).addClass('is-invalid');
                        },
                        unhighlight: function (element, errorClass, validClass) {
                            $(element).removeClass('is-invalid');
                        }
                    });
                });

              
            })













        }






        function Delete(id) {


            swal({
                title: "هل انت متاكد ",
                text: " OK تقوم بحذف العنصر! عند الضعط علي",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
             .then((willDelete) => {
                 if (willDelete) {
                     $.get("/RevenueAddition/DeleteNyAndCupps", { id: id }, function (res) {
                         if (res) {

                             if (res.message != null && res.message === "Used") {
                                 toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                             }

                             if (res.message != null && res.message === "Delete") {
                                 toastr.success("تم الحذف NyAndCupps ", "الحذف");
                             }
                             Search();
                         }
                     });
                 }
             });

        }



        function UpdateNyAndCuppsfees() {

            var model = $('#myModal');
            var form = $('form[name="DepartmentFormAdd"]');


            form.validate();
            if (!form.valid()) {
                return;
            } else {
                var data = form.serialize();
                $.post("/RevenueExtenstion/UpdateNyAndCuppsfees", data, function (res) {
                    if (res) {
                        if (res.message != null && res.message === "Update") {
                            toastr.success("تم تعديل NyAndCupps  ", "تعديل");
                        }
                        else if (res.message != null && res.message === "Add") {
                            toastr.success("تم اضافه عام NyAndCupps ", "اضافه");
                        }
                        else if (res.message == null || res.message === "error") {
                            toastr.error("حدث خطا ", "لم يتم الحفظ");
                        }
                        else if (res.message == null || res.message === "Used") {
                            toastr.error("لم يتم الحفظ", "موجود");
                        }
                        model.modal('hide');


                        Search();
                    }

                })
            }
        }




     








    </script>

}
