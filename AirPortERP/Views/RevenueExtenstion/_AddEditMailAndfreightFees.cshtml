@model AirPortERP.ViewModels.MailAndFreightFeesViewModelDTO

<form name="DepartmentFormAdd" id="quickForm">
    @Html.AntiForgeryToken()
    <div class="modal-header">
     

                <h5>Update Mail And Fright</h5>
            

        



        <button class="close" data-dismiss="modal">&times;</button>
    </div>
    <div class="modal-body">
        @Html.HiddenFor(C => C.Id)
        <div class="form-horizontal">
            <div class="card-body">

                <div class="form-group row">
                    @Html.LabelFor(model => model.NormalMailLoadingExpAmount, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.NormalMailLoadingExpAmount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.NormalMailLoadingExpAmount, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row">
                    @Html.LabelFor(model => model.RapidMailLoadingExpAmount, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.RapidMailLoadingExpAmount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.RapidMailLoadingExpAmount, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row">
                    @Html.LabelFor(model => model.NormalMailLoadingImpAmount, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.NormalMailLoadingImpAmount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.NormalMailLoadingImpAmount, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row">
                    @Html.LabelFor(model => model.RapidMailLoadingImpAmount, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.RapidMailLoadingImpAmount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.RapidMailLoadingImpAmount, "", new { @class = "text-danger" })
                    </div>
                </div>

             



                <div class="form-group row">
                    @Html.LabelFor(model => model.FrightLoadingExp, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.FrightLoadingExp, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.FrightLoadingExp, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row">
                    @Html.LabelFor(model => model.FrightLoadingImp, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.FrightLoadingImp, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.FrightLoadingImp, "", new { @class = "text-danger" })
                    </div>
                </div>


















             
                @Html.HiddenFor(C => C.OfficerDataId)





            </div>
        </div>
    </div>

    <div class="modal-footer justify-content-between">
        <button type="button" onclick="UpdateMailAndFreightfees()" class="btn btn-primary">
          
                    <span>Update Mail And Freight </span>
               
            


        </button>
        <button class="btn btn-danger" data-dismiss="modal">Cancel</button>

    </div>
</form>

