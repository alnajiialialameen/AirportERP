@section scripts{

    <script>
            var dataTable;
            $(document).ready(function () {

                dataTable = $("#dataTable").DataTable({

                    "processing": true,
                    // "serverSide": true,
                    "ajax": {
                        "url": "/OfficerDatas/GetOfficerDataAll",
                        "type": "GET",
                        "datatype": "json",

                    },
                    "columns": [






                        { "data": "Id", "autowidth": true },
                          { "data": "AirLineName", "autowidth": true },
                           { "data": "FlightNo", "autowidth": true },
                             { "data": "AircraftRegName", "autowidth": true },
                              { "data": "Type", "autowidth": true },
                             { "data": "AirportIdFrom", "autowidth": true },

                                { "data": "AirportIdTo", "autowidth": true },
                                  { "data": "Date", "autowidth": true },
                                    { "data": "ATA", "autowidth": true },
                                      { "data": "ATD", "autowidth": true },
                                       { "data": "LandingDate", "autowidth": true },
                                        { "data": "CrewNO", "autowidth": true },
                                      



                                          {
                                              "data": "HasNightStop", "width": "50px", "render": function (data) {
                                                  var cssClass;
                                                  if (data === "No") {
                                                      cssClass = "badge-danger";
                                                  }
                                                  if (data === "Yes") {
                                                      cssClass = "badge-success";
                                                  }
                                                  return '<span class="badge ' + cssClass + '">' + data + '</span>'

                                              }
                                          },


                                            { "data": "HandlingAgentName", "autowidth": true },

        

                                                 {
                                                     "data": "IsCurrentAccount", "width": "50px", "render": function (data) {
                                                         var cssClass;
                                                         if (data === "No") {
                                                             cssClass = "badge-danger";
                                                         }
                                                         if (data === "Yes") {
                                                             cssClass = "badge-success";
                                                         }
                                                         return '<span class="badge ' + cssClass + '">' + data + '</span>'

                                                     }
                                                 },
                                                    { "data": "AireLineAgentName", "autowidth": true },



                                                 















                                {


                                       "data": "Id", "width": "50px", "render": function (data) {
                                           return '<div class="btn-group"> <button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#" onclick="getOfficerData(' + data + ')">Update</a><button class="dropdown-item"  onclick="Delete(' + data + ')">Delete</button></div></div>'

                                       }
                                   },


                    ], "language":
                                  {
                                      "sProcessing": "جارٍ التحميل...",
                                      "sLengthMenu": "أظهر _MENU_ مدخلات",
                                      "sZeroRecords": "لم يعثر على أية سجلات",
                                      "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                                      "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                                      "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                                      "sInfoPostFix": "",
                                      "sSearch": "ابحث:",
                                      "sUrl": "",
                                      "oPaginate": {
                                          "sFirst": "الأول",
                                          "sPrevious": "السابق",
                                          "sNext": "التالي",
                                          "sLast": "الأخير",
                                      }
                                  }
                });

            });


            function getOfficerData(OfficerId) {

                $("#AjaxLoader").show()

                $.get("/OfficerDatas/GetOfficerDataParialOfficer", { OfficerId: OfficerId }, function (nn) {

                    $("#myModel-content").html(nn);
                    $("#myModal").modal('show');
                    $("#AjaxLoader").hide()

                    $('.select2bs4').select2({
                        theme: 'bootstrap4'
                    })



                        //$('#timepicker').datetimepicker({
                        //    use24hours: true,
                        //    format: 'HH:mm'
                        //})






                        //$('#timepicker1').datetimepicker({
                        //    use24hours: true,
                        //    format: 'HH:mm'
                        //})




                    $(function () {
                        $.validator.setDefaults({
                            submitHandler: function () {
                                alert("Form successful submitted!");
                            }
                        });
                        $('#quickForm').validate({
                            rules: {
                                Name: {
                                    required: true,

                                },

                            },
                            messages: {
                                Name: {
                                    required: "الرجاء إدخال نوع الدوره",

                                },

                            },
                            errorElement: 'span',
                            errorPlacement: function (error, element) {
                                error.addClass('invalid-feedback');
                                element.closest('.form-group').append(error);
                            },
                            highlight: function (element, errorClass, validClass) {
                                $(element).addClass('is-invalid');
                            },
                            unhighlight: function (element, errorClass, validClass) {
                                $(element).removeClass('is-invalid');
                            }
                        });
                    });
                })













            }



            function CreateOrUpdate() {

                var model = $('#myModal');
                var form = $('form[name="DepartmentFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/OfficerDatas/CreateOrUpdateOfficerData", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل العام Movement ", "تعديل");
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه عام Movement ", "اضافه");
                            }
                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }




            function Delete(id) {

                if (confirm("هل تريد فعلا حذف Movement ??") == true) {
                    $.get("/OfficerDatas/Delete", { id: id }, function (res) {
                        if (res) {

                            if (res.message != null && res.message === "Used") {
                                toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                            }
                            if (res.message != null && res.message === "AlreadyDeleted") {
                                toastr.error(" لا يوجد بيانات متعلقة بالضباط ليتم حذفها اتصل لبرج المراقبة ليتم حفها نهائيا", "تعذر الحذف");
                            }

                            if (res.message != null && res.message === "Delete") {
                                toastr.success("تم الحذف نوع Movement ", "الحذف");
                            }
                            dataTable.ajax.reload();
                        }
                    });
                }
            }

            function ShowAll() {

                window.location.href = "/OfficerDatas/OfficerDataAll?";
            }
            function AircraftNotTakeOff() {

                window.location.href = "/OfficerDatas/AircraftNotTakeOff";
            }


    </script>
}
