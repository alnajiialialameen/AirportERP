        </div>*@

                <div class="form-group row">
                    <label class="control-label col-md-2">Month</label>
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.MouthWorkOn,
     new SelectList(ViewBag.MonthList, "Id", "Name"),

     new { @class = "form-control select2bs4" })
                    </div>
                </div>


                <div class="form-group row">
                    <label class="control-label col-md-2">Year</label>
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.YearWorkOn,
                        new SelectList(ViewBag.YearList, "Id", "Year"),
                        new { @class = "form-control select2bs4" })
                    </div>
                </div>






                @Html.HiddenFor(C => C.CompanyInfoId)






                <div class="modal-footer justify-content-between">
                    <button type="button" onclick="CreateOrUpdate()" class="btn btn-primary">
                        @{
                            if (Model.Id > 0)
                            {
                                <span>Update</span>
                            }
                            else
                            {

                                <span>Add</span>
                            }

                        }


                    </button>
                    <button class="btn btn-danger" data-dismiss="modal">Cancel</button>

                </div>
            </div>
