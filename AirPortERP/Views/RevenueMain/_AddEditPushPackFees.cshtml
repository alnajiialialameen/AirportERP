@model AirPortERP.ViewModels.PushPackFeesViewModelDTO

<form name="DepartmentFormAdd" id="quickForm">
    @Html.AntiForgeryToken()
    <div class="modal-header">
     

                <h5>Update PushPack </h5>
            

        



        <button class="close" data-dismiss="modal">&times;</button>
    </div>
    <div class="modal-body">
        @Html.HiddenFor(C => C.Id)
        <div class="form-horizontal">
            <div class="card-body">

              
                <div class="form-group row">
                    @Html.LabelFor(model => model.hasPushPack, "hasPushPack", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.CheckBoxFor(m => m.hasPushPack)

                    </div>
                </div>

              

             
                @Html.HiddenFor(C => C.OfficerDataId)





            </div>
        </div>
    </div>

    <div class="modal-footer justify-content-between">
        <button type="button" onclick="UpdatePushPackfees()" class="btn btn-primary">
          
                    <span>Update PushPack </span>
               
            


        </button>
        <button class="btn btn-danger" data-dismiss="modal">Cancel</button>

    </div>
</form>

