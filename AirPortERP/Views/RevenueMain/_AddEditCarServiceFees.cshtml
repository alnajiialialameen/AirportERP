@model AirPortERP.ViewModels.CarServiceFeesViewModelDTO

<form name="DepartmentFormAdd" id="quickForm">
    @Html.AntiForgeryToken()
    <div class="modal-header">
     

                <h5>Update Service Car</h5>
            

        



        <button class="close" data-dismiss="modal">&times;</button>
    </div>
    <div class="modal-body">
        @Html.HiddenFor(C => C.Id)
        <div class="form-horizontal">
            <div class="card-body">

                <div class="form-group row">
                    @Html.LabelFor(model => model.AmbulanceCarCount, "Ambulance Car Count", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.EditorFor(model => model.AmbulanceCarCount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AmbulanceCarCount, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row">
                    @Html.LabelFor(model => model.FireFightingCarCount, "FireFighting Car Count", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.EditorFor(model => model.FireFightingCarCount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.FireFightingCarCount, "", new { @class = "text-danger" })
                    </div>
                </div>

                @*<div class="form-group row">
                    @Html.LabelFor(model => model.TRNY, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TRNY, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.TRNY, "", new { @class = "text-danger" })
                    </div>
                </div>*@

             

             
                @Html.HiddenFor(C => C.OfficerDataId)





            </div>
        </div>
    </div>

    <div class="modal-footer justify-content-between">
        <button type="button" onclick="UpdateCarServicefees()" class="btn btn-primary">
          
                    <span>Update Car Service</span>
               
            


        </button>
        <button class="btn btn-danger" data-dismiss="modal">Cancel</button>

    </div>
</form>

