</div>



<div class="loader" id="AjaxLoader" style="display:none;">
    <div class="strip-holder">
        @*<div class="strip-1"></div>
            <div class="strip-2"></div>
            <div class="strip-3"></div>*@

        <div class="sk-chase">
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
        </div>

    </div>

</div>


<section class="content">

    <p>

        <button class="btn btn-primary btn-sm" onclick="AllData()">All Car Service</button>

    </p>







    <div class="card">
        <div class="card-body">
            <div style="width:100%" class="table-responsive">

                <table id="dataTable" class="table table-bordered table-light table-hover table-sm" style="width:100%;font-size:13px;">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Id</th>
                            <th>Airline</th>
                            <th>Flight No</th>

                            <th>Reg</th>
                            <th>TripType</th>



                            <th>Date</th>
                            <th>TakeOffDate</th>
                            


                            <th>From</th>
                            <th>TO</th>

                            @*<th>Fire Count</th>
                    <th>Fire Fees</th>*@


                            <th>OP</th>

                        </tr>
                    </thead>

                </table>

            </div>
        </div>
    </div>














    <!-- Model Start -->
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="myModel-content">

                <!-- Model content -->

                <div class="modal-footer justify-content-between">
                    <button class="btn btn-primary btn-xs">Save Change</button>
                    <button class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!--Model End -->

</section>
@section scripts{

    <script>
            var dataTable;
            $(document).ready(function () {

                function format(d) {
                    return '<div class="card Details"><div class="card-body">   <Span>Landing Date:</Span> '
                        + d.LandingDate + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '<Span>Size:</Span> ' + d.Size + '<br>' +
                        '<Span>TakeOff Date:</Span> ' + d.TakeOffDate + '<Span>  &nbsp;&nbsp; &nbsp;&nbsp AirPortFrom:</Span> ' + d.AirPortFrom + '<br>' +
                         '<Span>ATA: </Span>' + d.ATA + ' &nbsp; &nbsp; &nbsp;&nbsp' + '<Span>AirPortTo:</Span> ' + d.AirPortTo + '<br>' +
                         '<Span>ATD: </Span>' + d.ATD + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '<br>' +
                         '<Span>Wt: </Span>' + d.MaxTakoffWieght + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '<br>' +
                         '<Span>Type:</Span> ' + d.Type + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '<br>' +
                         '<Span>REG:</Span> ' + d.AircraftRegName + ' &nbsp;&nbsp; &nbsp;&nbsp ' + '<br>' +

                         '<br><button class="btn btn-success btn-sm m-2" onclick="getCarService(' + d.Id + ')">Update</button> <button class="btn btn-info btn-sm m-2" onclick="MoreDetails(' + d.Id
                         + ')">Details</button> <button class="btn btn-danger btn-sm m-2 float-right" onclick="Delete(' + d.Id + ')">Delete</button>' +
                        '<br></div></div>';

                }


                dataTable = $("#dataTable").DataTable({

                    "processing": true,
                    // "serverSide": true,
                    "ajax": {
                        "url": "/RevenueMain/GetCarService",
                        "type": "GET",
                        "datatype": "json",

                    },

                    "columns": [
                          {
                              "class": "details-control",
                              "orderable": false,
                              "data": null,
                              "defaultContent": ""
                          },
                        { "data": "TowerId", "autowidth": true },
                          { "data": "AirlineName", "autowidth": true },
                             { "data": "FlightNo", "autowidth": true },
                             { "data": "RegNo", "autowidth": true },
                           
                              {
                                  "data": "TripType", "width": "50px", "render": function (data) {
                                      var cssClass;
                                      if (data === "Domestic") {
                                          cssClass = "badge-danger";
                                      }
                                      if (data === "International") {
                                          cssClass = "badge-success";
                                      }
                                      return '<span class="badge ' + cssClass + '">' + data + '</span>'

                                  }
                              },
                                { "data": "Date", "autowidth": true },
                                   { "data": "TakeOffDate", "autowidth": true },

                                         { "data": "AirPortFrom", "autowidth": true },
                                        { "data": "AirPortTo", "autowidth": true },


                                        // { "data": "FireFightingCarCount", "autowidth": true },
                                        //{ "data": "FireFightingCarFees", "autowidth": true },





                                      






                                   {
                                       "data": "Id", "width": "50px", "render": function (data) {
                                           return '<div class="btn-group"> <button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button><div class="dropdown-menu"><a class="dropdown-item" href="#" onclick="getCarService(' + data
                                               + ')">Update</a> <button class="dropdown-item"  onclick="MoreDetails(' + data
                                               + ')">More Details</button></div></div>'

                                       }
                                   },


                    ], "language":
                                  {
                                      "sProcessing": "جارٍ التحميل...",
                                      "sLengthMenu": "أظهر _MENU_ مدخلات",
                                      "sZeroRecords": "لم يعثر على أية سجلات",
                                      "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                                      "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                                      "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                                      "sInfoPostFix": "",
                                      "sSearch": "ابحث:",
                                      "sUrl": "",
                                      "oPaginate": {
                                          "sFirst": "الأول",
                                          "sPrevious": "السابق",
                                          "sNext": "التالي",
                                          "sLast": "الأخير",
                                      }
                                  },
                    "dom": '<"top"l>rt<"bottom"ip><"clear">',
                    "fnInitComplete": function (oSettings, json) {
                        addSearchControl(json);
                    }


                });







                var detailRows = [];

                $('#dataTable tbody').on('click', 'tr td.details-control', function () {
                    var tr = $(this).closest('tr');
                    var row = dataTable.row(tr);
                    var idx = $.inArray(tr.attr('Id'), detailRows);

                    if (row.child.isShown()) {
                        tr.removeClass('details');
                        row.child.hide();

                        // Remove from the 'open' array
                        detailRows.splice(idx, 1);
                    }
                    else {
                        tr.addClass('details');
                        row.child(format(row.data())).show();

                        // Add to the 'open' array
                        if (idx === -1) {
                            detailRows.push(tr.attr('Id'));
                        }
                    }
                });

                // On each draw, loop over the `detailRows` array and show any child rows
                dt.on('draw', function () {
                    $.each(detailRows, function (i, id) {
                        $('#' + id + ' td.details-control').trigger('click');
                    });
                });






                function addSearchControl(json) {
                    $("#dataTable thead").append($("#dataTable thead tr:first").clone());
                    $("#dataTable thead tr:eq(1) th").each(function (index) {
                        //Not Whant To Using
                        if (index == 0 || index == 12|| index == 4|| index == 8 ||  index == 10 || index == 11) {
                            $(this).replaceWith('<th><input type="hidden" placeholder="None"></input></th>');
                        }
                        // Whant To Using
                        if (index == 1 || index == 2 || index == 3 || index == 6 || index == 7|| index == 9) {
                            $(this).replaceWith('<th><input type="text" class="jsonText" placeholder="بحث"></input></th>');
                            var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") input");
                            searchControl.on('keyup', function () {
                                dataTable.column(index).search(searchControl.val()).draw();
                            });
                        }
                        // Whant To Using select list 
                        if (index == 5) {
                            var ClassCaseDropDown = $('<select/>');
                            ClassCaseDropDown.append($('<option/>').attr('value', '').text(' نوع الرحلة'));
                            var ClassCase = [];
                            $(json.data).each(function (index, element) {
                                if ($.inArray(element.TripType, ClassCase) == -1) {
                                    ClassCase.push(element.TripType);
                                    ClassCaseDropDown.append($('<option/>').attr('value', element.TripType).text(element.TripType));
                                }
                            });
                            $(this).replaceWith('<th>' + $(ClassCaseDropDown).prop('outerHTML') + '</th>');
                            var searchControl = $("#dataTable thead tr:eq(1) th:eq(" + index + ") select");
                            searchControl.on('change', function () {
                                dataTable.column(index).search(searchControl.val() == "" ? "" : '^' + searchControl.val() + '$', true, false).draw();
                            });
                        }







                    });
                }

            });


            function getCarService(id) {

                $("#AjaxLoader").show()

                $.get("/RevenueMain/GetCarServicefeesParial", { id: id }, function (nn) {

                    $("#myModel-content").html(nn);
                    $("#myModal").modal('show');
                    $("#AjaxLoader").hide()

                    $('.select2bs4').select2({
                        theme: 'bootstrap4'
                    })




                    $(function () {
                        $.validator.setDefaults({
                            submitHandler: function () {
                                alert("Form successful submitted!");
                            }
                        });
                        $('#quickForm').validate({
                            rules: {
                                AmbulanceCarCount: {
                                    required: true,
                                    digits: true,
                                    maxlength: 14,
                                },
                                FireFightingCarCount: {
                                    required: true,
                                    digits: true,
                                    maxlength: 14,
                                },



                            },
                            messages: {
                                AmbulanceCarCount: {
                                    required: "Please Enter Number Of AmbulanceCarCount",
                                    digits: "Please inter Number Only ",
                                    maxlength: "DISEMB must be at max 14 ",


                                },
                                FireFightingCarCount: {
                                    required: "Please Enter Number Of FireFightingCarCount",
                                    digits: "Please inter Number Only ",
                                    maxlength: "DISEMB must be at max 14 ",


                                },



                            },

                            errorElement: 'span',
                            errorPlacement: function (error, element) {
                                error.addClass('invalid-feedback');
                                element.closest('.form-group').append(error);
                            },
                            highlight: function (element, errorClass, validClass) {
                                $(element).addClass('is-invalid');
                            },
                            unhighlight: function (element, errorClass, validClass) {
                                $(element).removeClass('is-invalid');
                            }
                        });
                    });



                })













            }



            function UpdateCarServicefees() {

                var model = $('#myModal');
                var form = $('form[name="DepartmentFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/RevenueMain/UpdateCarServicefees", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل CarService ", "تعديل");
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه CarService ", "اضافه");
                            }
                            else if (res.message != null && res.message === "Used") {
                                toastr.error("العنصر موجود", "لم يتم الحفظ");
                            }
                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }




            function Delete(id) {


                swal({
                    title: "هل انت متاكد ",
                    text: " OK تقوم بحذف العنصر! عند الضعط علي",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                 .then((willDelete) => {
                     if (willDelete) {
                         $.get("/AirLineAgents/Delete", { id: id }, function (res) {
                             if (res) {

                                 if (res.message != null && res.message === "Used") {
                                     toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                                 }

                                 if (res.message != null && res.message === "Delete") {
                                     toastr.success("تم الحذف نوع عميل ", "الحذف");
                                 }
                                 dataTable.ajax.reload();
                             }
                         });
                     }
                 });

            }








            function AllData() {

                window.location.href = "/RevenueMain/AllCarSeriveMain";
            }

            function MoreDetails(id) {

                window.location.href = "/RevenueAddition/Details/" + id;
            }

    </script>
}
