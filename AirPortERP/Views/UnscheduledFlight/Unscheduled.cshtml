 function getaddOperator()
 {
     return new Promise(function (resolve, reject) {
         $('#addoperatoridf').empty(); // Clear any existing options

         $.ajax({
             url: "/UnscheduledFlight/GetAirline", // Ensure this is the correct path for your controller action
             type: "GET",
             contentType: "application/json;charset=utf-8",
             dataType: "json",
             success: function (result) {
                 if (result) {
                     // Add the default option
                     var defaultOption = "<option value='0'>--please select Flight No---</option>";
                     $('#addoperatoridf').append(defaultOption);

                     // Append options from the AJAX result
                     var html = "";
                     $.each(result, function (key, item) {
                         html += "<option value='" + item.Id + "'>" + item.Name + "</option>";
                     });
                     $('#addoperatoridf').append(html);

                     resolve(); // Resolve the promise when done
                 }
             },
             error: function (errormessage) {
                 alert(errormessage.responseText);
                 reject(); // Reject the promise in case of an error
             }
         });
     });
 }

