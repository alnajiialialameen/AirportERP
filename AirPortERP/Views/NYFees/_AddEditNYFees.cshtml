@model AirPortERP.Models.NYFee

<form name="DepartmentFormAdd" id="quickForm" >
    @Html.AntiForgeryToken()
    <div class="modal-header">
        @{
            if (Model.Id > 0)
            {
                <h5>Update NYFees </h5>
            }
            else
            {
                <h5>Add NYFees</h5>
            }
        }

        <button class="close" data-backdrop="static" data-dismiss="modal">&times;</button>
    </div>

    <div class="modal-body">
        @Html.HiddenFor(C => C.Id)
        <div class="form-horizontal">
            <div class="card-body">
                @if (Model.Id > 0)
                {
                <div class="form-group row">
                    @Html.LabelFor(model => model.FlightType, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @if (Model.FlightType == 1)
                        {
                            @Html.Label("International")
                            @Html.ValidationMessageFor(model => model.FlightType, "", new { @class = "text-danger" })
                        }
                        else
                        {
                            @Html.Label("Domestic")
                            @Html.ValidationMessageFor(model => model.FlightType, "", new { @class = "text-danger" })
                        }
                    </div>
                </div>
                @Html.HiddenFor(c => c.FlightType)
                }
                else
                {
                    <div class="form-group row">
                        @Html.LabelFor(model => model.FlightType, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.FlightType, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.FlightType, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }
                <div class="form-group row">
                    @Html.LabelFor(model => model.AmountInDollar, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.AmountInDollar, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AmountInDollar, "", new { @class = "text-danger" })
                    </div>
                </div>

                @Html.HiddenFor(c => c.CreatedBy)
                @Html.HiddenFor(c => c.CreationDate)
                @Html.HiddenFor(c => c.UpdatedBy)
                @Html.HiddenFor(c => c.UpdatingDate)
            </div>
        </div>
    </div>

    <div class="modal-footer justify-content-between">
        <button type="button" onclick="CreateOrUpdate()" class="btn btn-primary">
            @{
                if (Model.Id > 0)
                {
                    <span>Update NYFees</span>
                }
                else
                {
                    <span>Add NYFees</span>
                }
            }

        </button>
        <button class="btn btn-danger" data-dismiss="modal">Cancel</button>
    </div>
</form>