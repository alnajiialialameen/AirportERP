            function AddDeleteReason() {

                var model = $('#myModalDelete');
                var form = $('form[name="DeleteReasonFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/AccountSand/AddDeleteReason", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Delete") {
                                toastr.success("تم عملية الحذف بنجاح ", "تعديل");
                            }

                            else if (res.message != null && res.message === "Used") {
                                toastr.error("العنصر موجود", "اضافه");
                            }

                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحذف");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }


