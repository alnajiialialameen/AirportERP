            function AddClaim() {

                var model = $('#myModalClaim');
                var form = $('form[name="ClaimFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();

                    $.post("/AccountClaim/CreateOrUpdateClaim", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل مطالبة مالية", "تعديل");
                                var model = $('#myModalClaim');
                                model.modal('hide');

                            }

                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه مطالبة مالية ", "اضافه");
                                var model = $('#myModalClaim');
                               model.modal('hide');
                            }

                            else if (res.message != null && res.message === "InvaildStartDate") {
                                toastr.error("التاريخ يجب ان يبدا من يوم 1 ", "اضافه");
                              
                            }

                            else if (res.message != null && res.message === "InvaildEndDate") {
                                toastr.error("التاريخ النهاية غير صحيح  ", "اضافه");
                              
                            }



