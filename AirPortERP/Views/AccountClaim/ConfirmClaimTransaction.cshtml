                                toastr.error("يوجد مطالبة مالية لنفس الشهر  ", "اضافه");

                            }
                            
                          
                            else if (res.message != null && res.message === "InvaildDate") {
                                toastr.error("لايمكن المطالبة لشهرين  ", "اضافه");

                            }
                            else if (res.message == null || res.message === "error") {
