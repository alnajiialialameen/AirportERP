            function ConformClaim(id) {



                $.get("/AccountClaim/GetClaimToConfirm", { id: id }, function (result) {



                        swal({
                            title: result.message,
                            text: result.moneytext,
                            icon: "warning",
                            buttons: true,
                            dangerMode: true,
                        })
                         .then((willDelete) => {
                             if (willDelete) {
                                 AddToConfrim(id);
                             }
                         });




                });






            }

            function AddToConfrim(id) {
                $.post("/AccountClaim/AddToConfrim", { id: id }, function (res) {
                    if (res) {


                         if (res.message != null && res.message === "Add") {
                            toastr.success("تم تاكيد المعاملة ", "اضافه");
                        }

                        else if (res.message == null || res.message === "error") {
                            toastr.error("حدث خطا ", "لم يتم الحفظ");
                        }
                      
                         //var model = $('#myModalClaim');
                         //model.modal('hide');
                        dataTable.ajax.reload();

                    }

                })

            }

            function CreateOrUpdate() {

                var model = $('#myModal');
                var form = $('form[name="SandFormAdd"]');


                form.validate();
                if (!form.valid()) {
                    return;
                } else {
                    var data = form.serialize();
                    $.post("/AccountSand/CreateOrUpdateBalance", data, function (res) {
                        if (res) {
                            if (res.message != null && res.message === "Update") {
                                toastr.success("تم تعديل العام المطار ", "تعديل");
                            }
                            else if (res.message != null && res.message === "Add") {
                                toastr.success("تم اضافه عام مطار ", "اضافه");
                            }
                            else if (res.message != null && res.message === "Used") {
                                toastr.error("العنصر موجود", "اضافه");
                            }

                            else if (res.message == null || res.message === "error") {
                                toastr.error("حدث خطا ", "لم يتم الحفظ");
                            }
                            model.modal('hide');


                            dataTable.ajax.reload();
                        }

                    })
                }
            }

