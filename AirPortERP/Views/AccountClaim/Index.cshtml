<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h6 class="m-0 text-dark">Financial Claim (مطالبة مالية)</h6>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    @*<li class="breadcrumb-item"><a href="#">Home</a></li>*@
                    <li class="breadcrumb-item active"> Financial Claim (مطالبة مالية)</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>



<div class="loader" id="AjaxLoader" style="display:none;">
    <div class="strip-holder">
        @*<div class="strip-1"></div>
            <div class="strip-2"></div>
            <div class="strip-3"></div>*@

        <div class="sk-chase">
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
            <div class="sk-chase-dot"></div>
        </div>

    </div>

</div>


<section class="content">
    <label class="CompanyId d-none">@ViewBag.CompanyId</label>
    <p>
        <button class="btn btn-primary" onclick="getClaim(0)">Add Claim</button>
        <button class="btn btn-primary float-right" onclick="getShowAll()">Show All Confirm Transaction</button>
    </p>

    <div class="card">
        <div class="card-body">
            <div style="width:100%" class="table-responsive">

                <table id="dataTable" class="table-sm table-bordered" style="width:100%;font-size:12px">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Id</th>
                            <th>AccId</th>
                            <th>Account</th>
                            <th>Debit   (مدين) </th>
                            <th>Currency(العملة)</th>
                            <th>Explain (البيان)</th>
                            <th>Date</th>
                            <th>Month</th>
                            <th>Year</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    <!-- Model Start -->
    <div id="myModalClaim" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="myModel-Claim">

                <!-- Model content -->

                <div class="modal-footer justify-content-between">
                    <button class="btn btn-primary btn-xs">Save Change</button>
                    <button class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!--Model End -->
    <!-- Model Start -->
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" id="myModel-content">

                <!-- Model content -->

                <div class="modal-footer justify-content-between">
                    <button class="btn btn-primary btn-xs">Save Change</button>
                    <button class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!--Model End -->

    <div id="myModalDelete" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="myModel-Delete">

                <!-- Model content -->

                <div class="modal-footer justify-content-between">
                    <button class="btn btn-primary btn-xs">Save Change</button>
                    <button class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</section>
@section scripts{

    <script>

        //$(document).ready(function () {
