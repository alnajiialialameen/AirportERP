@using AirPortERP.Models;
@using Newtonsoft.Json;
@{
    Entities db = new Entities();
    ViewBag.Title = "Home Page";
}

@*@{
    List<int> AirlinesSeperateNYInvoiceList = ViewBag.AirlinesSeperateNYInvoiceList as List<int>;
}*@

<style>
    td.details-control {
        /*background: url('../resources/details_open.png') no-repeat center center;*/
        background: url('../../Temp/Image/Close.png') no-repeat center center;
        cursor: pointer;
    }

    tr.details td.details-control {
        /*background: url('../resources/details_close.png') no-repeat center center;*/
        background: url('../../Temp/Image/Open.png')no-repeat center center;
    }

    .Details {
        font-size: 16px;
    }

    .card span {
        /*font-weight: bold;*/
        /*padding: 5px;*/
    }

    .Card-details-bold span {
        font-weight: bold;
    }

    .ml-Custom {
        margin-left: 300px;
    }

    .confirm {
        /*background-color:antiquewhite;*/
        background-color: #ffbb00;
