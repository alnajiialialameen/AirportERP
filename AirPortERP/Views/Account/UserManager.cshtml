@model IEnumerable<AirPortERP.ViewModels.UsersViewModel>

@{
    ViewBag.Title = "UserManager";
}






























<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">User Manager</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    @*<li class="breadcrumb-item"><a href="#">Home</a></li>*@
                    <li class="breadcrumb-item active">User Manager</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div>
</div>









<section class="content">

    <p>

        <button class="btn btn-primary" onclick="Register()">Add New User</button>
        @*<button class="btn btn-info float-right" onclick="PrintData()">Print All NoiseFees </button>*@
    </p>

    <div class="card">
        <div class="card-body">
            <div style="width:100%" class="table-responsive">
                <table id="dataTable" class="table table-bordered table-hover table-sm" style="width:100%;font-size:14px">
                    <tr>
                        @*<th>
                            Id
                        </th>*@
                        <th>
                            User Name
                        </th>
                        <th>
                            Role
                        </th>
                        <th>
                            Email
                        </th>
                        <th>
                            Airport
                        </th>
                        <th>Operation</th>
                    </tr>

                    @foreach (var item in Model)
                    {
                        <tr>
                            @*<td>
            @Html.DisplayFor(modelItem => item.Id)
        </td>*@
                            <td>
                                @Html.DisplayFor(modelItem => item.UserName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.RoleCurrent)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Email)
                            </td>


                            <td>
                                @Html.DisplayFor(modelItem => item.AirPort)
                            </td>


                            @*<td>


            @Html.DisplayFor(modelItem => item.UserType)
        </td>*@
                        <td>
                            @Html.ActionLink("Edit Role", "Edit", new { id = item.Id }, new { @class = "btn btn-info btn-sm" }) |
                            @Html.ActionLink("Reset Password", "ResetPassword", new { id = item.Id }, new { @class = "btn btn-success btn-sm" }) |
                            @Html.ActionLink("Change Airport", "ChangeAirport", new { id = item.Id }, new { @class = "btn btn-primary btn-sm" }) |

                            @*<button class="btn btn-danger btn-sm" onclick="Delete('@item.Id')">Delete</button>*@
                        </td>
                        </tr>
                    }



                </table>

            </div>
        </div>
    </div>

    </section>





    @section Scripts {
        <script>
      

           



            function Delete(id) {


                swal({
                    title: "هل انت متاكد ",
                    text: " OK تقوم بحذف العنصر! عند الضعط علي",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                 .then((willDelete) => {
                     if (willDelete) {
                         window.location.href = "/Account/DeleteAsync?userId=" + id;
                     }
                 });

            }

            function Register(id) {

                window.location.href = "/Account/Register";
            }


        </script>
    }


