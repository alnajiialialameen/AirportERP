@using AirPortERP.Models
@model LoginViewModel

@{ 
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>AirPort ERP Login</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--===============================================================================================-->
    <link rel="icon" type="image/png" href="images/icons/favicon.ico" />
    <!--===============================================================================================-->
    <link href="~/Temp/Login_v2/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/vendor/bootstrap/css/bootstrap.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/fonts/iconic/css/material-design-iconic-font.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/vendor/animate/animate.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/vendor/css-hamburgers/hamburgers.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/vendor/animsition/css/animsition.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/vendor/select2/select2.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/vendor/daterangepicker/daterangepicker.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/css/util.css">
    <link rel="stylesheet" type="text/css" href="~/Temp/Login_v2/css/main.css">
    <!--===============================================================================================-->

    <style>
.ribbon-wrapper.ribbon-xl .ribbon {
  right: 160px;
  top: 60px;
  width: 290px;
  margin-left: 30px;

}

        .ribbon-wrapper .ribbon {
            box-shadow: 0 0 3px rgb(0 0 0 / 30%);
            font-size: .5rem;
            line-height: 100%;
            padding: 0.375rem 0;
            position: relative;
            right: -2px;
            text-align: center;
            color: #fff;
            text-shadow: 0 -1px 0 rgb(0 0 0 / 40%);
            text-transform: capitalize;
            top: 10px;
            -webkit-transform: rotate(45deg);
            transform: rotate(45deg);
            width: 90px;
        }

        .text-xl {
            font-size: 1.1rem !important;
        }
    </style>










</head>
<body>

    <div class="limiter">

     
        <div class="container-login100">

            <div class="wrap-login100">

                <div class="ribbon-wrapper ribbon-xl">
                    <div class="ribbon bg-danger text-xl">
                        For Multiple Single Movement Accounting
                    </div>
                </div>
                <section id="loginForm">
                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {


                      


                        @Html.AntiForgeryToken()
                        <form class="login100-form validate-form">
                          
                            
                              <span class="login100-form-title p-b-10">
                                AirPort ERP
                            </span>



                            <span class="login100-form-title p-b-48">
                                @*<i class="zmdi zmdi-font"></i>*@
                                <img src="~/Temp/Image/Flying.gif" width="300" style="border-radius:30px;" height="160" />
                            </span>

                            <div class="wrap-input100 validate-input" data-validate="Valid email is: a@b.c">
                                <input class="input100" type="text" name="UserName" id="UserName">
                                <span class="focus-input100" data-placeholder="UserName"></span>
                            </div>

                            <div class="wrap-input100 validate-input" data-validate="Enter password">
                                <span class="btn-show-pass">
                                    <i class="zmdi zmdi-eye"></i>
                                </span>
                                <input class="input100" type="password" name="Password" id="Password">
                                <span class="focus-input100" data-placeholder="Password"></span>
                            </div>

                            <div class="container-login100-form-btn">
                                <div class="wrap-login100-form-btn">
                                    <div class="login100-form-bgbtn"></div>
                                    <button class="login100-form-btn">
                                        Login
                                    </button>
                                </div>
                            </div>


                            @if (Model.Message != null)
                            {
                                <div class="row">
                                    <div class="col-md-12 p-t-5">
                                        <div class="alert alert-danger">
                                            @Model.Message
                                        </div>
                                    </div>

                                </div>
                            }







                            <div class="text-center">
                                <span class="txt1">
                                    Don’t have an account?
                                </span>

                                <a class="txt2" href="#">
                                    Sign Up
                                </a>
                            </div>
                        </form>



                    }
                </section>
            </div>
        </div>
    </div>

    


    <div class="row">
        <div class="col-md-8">
            
        </div>
        @*<div class="col-md-4">
                <section id="socialLoginForm">
                    @Html.Partial("_ExternalLoginsListPartial", new ExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl })
                </section>
            </div>*@
    </div>





























    <div id="dropDownSelect1"></div>

    <!--===============================================================================================-->
    <script src="~/Temp/Login_v2/vendor/jquery/jquery-3.2.1.min.js"></script>
    <!--===============================================================================================-->
    <script src="~/Temp/Login_v2/vendor/animsition/js/animsition.min.js"></script>
    <!--===============================================================================================-->
    <script src="~/Temp/Login_v2/vendor/bootstrap/js/popper.js"></script>
    <script src="~/Temp/Login_v2/vendor/bootstrap/js/bootstrap.min.js"></script>
    <!--===============================================================================================-->
    <script src="~/Temp/Login_v2/vendor/select2/select2.min.js"></script>
    <!--===============================================================================================-->
    <script src="~/Temp/Login_v2/vendor/daterangepicker/moment.min.js"></script>
    <script src="~/Temp/Login_v2/vendor/daterangepicker/daterangepicker.js"></script>
    <!--===============================================================================================-->
    <script src="~/Temp/Login_v2/vendor/countdowntime/countdowntime.js"></script>
    <!--===============================================================================================-->
    <script src="~/Temp/Login_v2/js/main.js"></script>

</body>
</html>